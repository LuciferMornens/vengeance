{
  "name": "vengeance",
  "productName": "Vengeance",
  "version": "0.3.0",
  "description": "Vengeance — a premium desktop coding agent.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Vengeance",
    "email": "126121081+LuciferMornens@users.noreply.github.com"
  },
  "homepage": "https://github.com/LuciferMornens/vengeance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuciferMornens/vengeance.git"
  },
  "bugs": {
    "url": "https://github.com/LuciferMornens/vengeance/issues"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "desktopName": "vengeance.desktop",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "npm run build:engines && npm run build:auth",
    "dev": "electron-vite dev",
    "prebuild": "npm run build:engines && npm run build:auth",
    "build:engines": "node scripts/engines/build.mjs",
    "engines:prepare": "node scripts/engines/build.mjs --prepare",
    "build:auth": "node scripts/build-prime-auth.mjs",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "shots": "node scripts/shots.mjs",
    "e2e:real": "node scripts/e2e-real.mjs",
    "e2e:packaged": "node scripts/e2e-real.mjs --packaged",
    "e2e:bridge": "node scripts/checks/bridge-real.mjs",
    "e2e:mcp": "node scripts/checks/mcp-reconnect-real.mjs",
    "e2e:tree": "node scripts/checks/session-tree-real.mjs",
    "checks": "node scripts/checks/run.mjs",
    "qa": "node scripts/qa/run.mjs",
    "qa:smoke": "node scripts/qa/run.mjs --only smoke.qa.mjs",
    "icons": "node scripts/icons.mjs",
    "dist": "npm run build && node scripts/dist.mjs",
    "dist:qa": "npm run build && node scripts/dist-qa.mjs",
    "perf": "node scripts/perf/footprint.mjs"
  },
  "dependencies": {
    "diff": "9.0.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.55.0",
    "mermaid": "12.2.0",
    "motion": "14.1.0",
    "playwright": "1.64.0",
    "png-to-ico": "3.0.2",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "zustand": "5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
