diff --git a/packages/coding-agent/test/vengeance-self-update.test.ts b/packages/coding-agent/test/vengeance-self-update.test.ts
new file mode 100644
index 00000000..3708dbfd
--- /dev/null
+++ b/packages/coding-agent/test/vengeance-self-update.test.ts
@@ -0,0 +1,50 @@
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { ENV_AGENT_DIR, IS_VENGEANCE_DISTRIBUTION, VERSION } from "../src/config.ts";
+import { handlePackageCommand } from "../src/package-manager-cli.ts";
+import { checkForNewPiVersion } from "../src/utils/version-check.ts";
+
+describe("Vengeance distribution updates", () => {
+	afterEach(() => {
+		vi.unstubAllEnvs();
+		vi.unstubAllGlobals();
+		vi.restoreAllMocks();
+	});
+
+	it.each([{ options: [] }, { options: ["--force"] }])(
+		"blocks self-update before network or package writes ($options)",
+		async ({ options }) => {
+			const directory = mkdtempSync(join(tmpdir(), "vengeance-update-policy-"));
+			const settings = join(directory, "settings.json");
+			const original = '{"verificationPreference":"preserve"}\n';
+			writeFileSync(settings, original);
+			vi.stubEnv(ENV_AGENT_DIR, directory);
+			const fetch = vi.fn();
+			vi.stubGlobal("fetch", fetch);
+			const error = vi.spyOn(console, "error").mockImplementation(() => {});
+			const exitCode = process.exitCode;
+			try {
+				expect(IS_VENGEANCE_DISTRIBUTION).toBe(true);
+				expect(await handlePackageCommand(["update", "--self", ...options])).toBe(true);
+				expect(fetch).not.toHaveBeenCalled();
+				expect(readFileSync(settings, "utf8")).toBe(original);
+				expect(error).toHaveBeenCalledWith(
+					"This Engine is supplied by Vengeance. Update Vengeance to update the Engine.",
+				);
+				expect(process.exitCode).toBe(1);
+			} finally {
+				process.exitCode = exitCode;
+				rmSync(directory, { recursive: true, force: true });
+			}
+		},
+	);
+
+	it("does not advertise an upstream self-update", async () => {
+		const fetch = vi.fn();
+		vi.stubGlobal("fetch", fetch);
+		expect(await checkForNewPiVersion(VERSION)).toBeUndefined();
+		expect(fetch).not.toHaveBeenCalled();
+	});
+});
