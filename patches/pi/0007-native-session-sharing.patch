diff --git a/packages/coding-agent/src/core/saved-session-share.ts b/packages/coding-agent/src/core/saved-session-share.ts
new file mode 100644
index 0000000..cf38eb5
--- /dev/null
+++ b/packages/coding-agent/src/core/saved-session-share.ts
@@ -0,0 +1,86 @@
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { ReadOnlyAuthStorage } from "./auth-storage.ts";
+import { ModelRuntime } from "./model-runtime.ts";
+import { InMemoryCodingAgentModelsStore } from "./models-store.ts";
+import { DefaultResourceLoader } from "./resource-loader.ts";
+import { createAgentSession } from "./sdk.ts";
+import { parseSessionEntries, SessionManager } from "./session-manager.ts";
+import {
+	getSessionShareReadiness,
+	type SessionShareReadiness,
+	type SessionShareResult,
+	type ShareDestination,
+	shareSessionHeadless,
+} from "./session-sharing.ts";
+import { SettingsManager } from "./settings-manager.ts";
+
+interface SavedShareScope {
+	cwd: string;
+	agentDir: string;
+	projectTrusted: boolean;
+}
+
+async function configuration(scope: SavedShareScope, readOnly: boolean) {
+	const settingsManager = SettingsManager.create(scope.cwd, scope.agentDir, {
+		projectTrusted: scope.projectTrusted,
+	});
+	const modelRuntime = await ModelRuntime.create({
+		authPath: join(scope.agentDir, "auth.json"),
+		credentials: readOnly ? new ReadOnlyAuthStorage(join(scope.agentDir, "auth.json")) : undefined,
+		modelsPath: join(scope.agentDir, "models.json"),
+		modelsStore: new InMemoryCodingAgentModelsStore(),
+		allowModelNetwork: false,
+	});
+	return { settingsManager, modelRuntime };
+}
+
+export async function getSavedSessionShareReadiness(scope: SavedShareScope): Promise<SessionShareReadiness> {
+	return getSessionShareReadiness(await configuration(scope, true));
+}
+
+/** Saved exports use in-memory native state and never execute extensions or modify the source. */
+export async function shareSavedSession(
+	options: SavedShareScope & { sessionPath: string; expectedDestination?: ShareDestination },
+): Promise<SessionShareResult> {
+	const entries = parseSessionEntries(readFileSync(options.sessionPath, "utf8"));
+	if (entries[0]?.type !== "session") throw new Error("Invalid session file");
+	let configured = await configuration(options, true);
+	if (
+		configured.settingsManager.getSessionShareDestination() !== "gist" &&
+		configured.modelRuntime.getProviderAuthStatus("radius").configured
+	) {
+		configured = await configuration(options, false);
+	}
+	const snapshot = configured.settingsManager.getSettings();
+	// Resource package resolution must not install or update packages just to share a saved file.
+	snapshot.packages = [];
+	const settingsManager = SettingsManager.inMemory(snapshot, {
+		projectTrusted: options.projectTrusted,
+	});
+	const resourceLoader = new DefaultResourceLoader({
+		cwd: options.cwd,
+		agentDir: options.agentDir,
+		settingsManager,
+		noExtensions: true,
+		noSkills: true,
+		noPromptTemplates: true,
+		noThemes: true,
+	});
+	await resourceLoader.reload();
+	const { session } = await createAgentSession({
+		cwd: options.cwd,
+		agentDir: options.agentDir,
+		modelRuntime: configured.modelRuntime,
+		settingsManager,
+		resourceLoader,
+		sessionManager: SessionManager.inMemory(options.cwd, undefined, entries),
+	});
+	try {
+		return await shareSessionHeadless(session, {
+			expectedDestination: options.expectedDestination,
+		});
+	} finally {
+		session.dispose();
+	}
+}
diff --git a/packages/coding-agent/src/core/session-sharing.ts b/packages/coding-agent/src/core/session-sharing.ts
new file mode 100644
index 0000000..876f3c6
--- /dev/null
+++ b/packages/coding-agent/src/core/session-sharing.ts
@@ -0,0 +1,195 @@
+import { spawn, spawnSync } from "node:child_process";
+import * as crypto from "node:crypto";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { DEFAULT_RADIUS_GATEWAY } from "@earendil-works/pi-ai/providers/radius-config";
+import { getAuthCredential } from "../cli/auth-command.ts";
+import { getShareViewerUrl } from "../config.ts";
+import type { AgentSession } from "./agent-session.ts";
+import { exportSessionToJsonl } from "./session-export.ts";
+
+export type ShareDestination = "gist" | "radius";
+export type SessionShareResult =
+	| { destination: "gist"; url: string; gistUrl: string }
+	| { destination: "radius"; url: string };
+export type SessionShareReadiness =
+	| { ready: true; destination: ShareDestination }
+	| {
+			ready: false;
+			destination: ShareDestination;
+			reason: "missing-gh" | "signed-out" | "radius-signed-out";
+	  };
+
+type ShareConfiguration = Pick<AgentSession, "modelRuntime" | "settingsManager">;
+const MINIMUM_OAUTH_VALIDITY_MS = 5 * 60_000;
+const AUTH_STATUS_TIMEOUT_MS = 15_000;
+const UPLOAD_TIMEOUT_MS = 90_000;
+
+/** Trailing `pi.share` entry carrying presentation metadata for the session viewer. */
+export function createShareTrailingEntries(
+	session: AgentSession,
+	parentId: string | null,
+	timestamp: string,
+): object[] {
+	return [
+		{
+			type: "custom",
+			customType: "pi.share",
+			id: crypto.randomUUID().slice(0, 8),
+			parentId,
+			timestamp,
+			data: {
+				systemPrompt: session.state.systemPrompt,
+				tools: session.state.tools.map((tool) => ({
+					name: tool.name,
+					description: tool.description,
+					parameters: tool.parameters,
+				})),
+			},
+		},
+	];
+}
+
+export function exportSessionForShare(filePath: string, session: AgentSession): void {
+	exportSessionToJsonl(session.sessionManager, filePath, (parentId, timestamp) =>
+		createShareTrailingEntries(session, parentId, timestamp),
+	);
+}
+
+function gistReadiness(): SessionShareReadiness {
+	const result = spawnSync("gh", ["auth", "status"], {
+		encoding: "utf-8",
+		windowsHide: true,
+		timeout: AUTH_STATUS_TIMEOUT_MS,
+	});
+	if (result.error && "code" in result.error && result.error.code === "ENOENT") {
+		return { ready: false, destination: "gist", reason: "missing-gh" };
+	}
+	return result.status === 0
+		? { ready: true, destination: "gist" }
+		: { ready: false, destination: "gist", reason: "signed-out" };
+}
+
+/** Readiness never resolves or refreshes OAuth credentials. */
+export function getSessionShareReadiness(session: ShareConfiguration): SessionShareReadiness {
+	const preference = session.settingsManager.getSessionShareDestination();
+	const radiusConfigured =
+		preference !== "gist" &&
+		!!session.modelRuntime.getProvider("radius") &&
+		session.modelRuntime.getProviderAuthStatus("radius").configured;
+	if (radiusConfigured) return { ready: true, destination: "radius" };
+	if (preference === "radius") {
+		return { ready: false, destination: "radius", reason: "radius-signed-out" };
+	}
+	return gistReadiness();
+}
+
+async function radiusCredential(session: ShareConfiguration): Promise<string | undefined> {
+	if (!session.modelRuntime.getProvider("radius")) return undefined;
+	return getAuthCredential(
+		await session.modelRuntime.getAuth("radius", {
+			minOAuthValidityMs: MINIMUM_OAUTH_VALIDITY_MS,
+		}),
+	);
+}
+
+async function uploadRadius(filePath: string, token: string, signal?: AbortSignal): Promise<SessionShareResult> {
+	const body = fs.readFileSync(filePath);
+	const url = new URL("/v1/artifacts", DEFAULT_RADIUS_GATEWAY);
+	url.searchParams.set("visibility", "organization");
+	url.searchParams.set("title", "Pi session");
+	const response = await fetch(url, {
+		method: "POST",
+		headers: {
+			Authorization: `Bearer ${token}`,
+			"Content-Type": "application/x-ndjson",
+			"Content-Length": String(body.byteLength),
+		},
+		body,
+		signal,
+	});
+	const result = (await response.json().catch(() => null)) as {
+		artifact?: { canonical_url?: string };
+		error?: string;
+	} | null;
+	if (!response.ok || !result?.artifact?.canonical_url) {
+		throw new Error(`Failed to upload Radius artifact: ${result?.error || response.statusText || response.status}`);
+	}
+	return { destination: "radius", url: result.artifact.canonical_url };
+}
+
+async function uploadGist(filePath: string, signal?: AbortSignal): Promise<SessionShareResult> {
+	const result = await new Promise<{ stdout: string; stderr: string; code: number | null }>((resolve, reject) => {
+		const child = spawn("gh", ["gist", "create", "--public=false", filePath], {
+			windowsHide: true,
+			signal,
+		});
+		let stdout = "";
+		let stderr = "";
+		child.stdout?.on("data", (data) => {
+			stdout += data.toString();
+		});
+		child.stderr?.on("data", (data) => {
+			stderr += data.toString();
+		});
+		child.once("error", reject);
+		child.once("close", (code) => resolve({ stdout, stderr, code }));
+	});
+	if (result.code !== 0) {
+		throw new Error(`Failed to create gist: ${result.stderr.trim() || "Unknown error"}`);
+	}
+	const gistUrl = result.stdout.trim();
+	const gistId = gistUrl.split("/").pop();
+	if (!gistId) throw new Error("Failed to parse gist ID from gh output");
+	return { destination: "gist", url: getShareViewerUrl(gistId), gistUrl };
+}
+
+/** Resolve credentials before choosing a destination; upload failures never fall back to a gist. */
+export async function shareSessionHeadless(
+	session: AgentSession,
+	options: {
+		signal?: AbortSignal;
+		themeName?: string;
+		expectedDestination?: ShareDestination;
+	} = {},
+): Promise<SessionShareResult> {
+	options.signal?.throwIfAborted();
+	const directory = fs.mkdtempSync(path.join(os.tmpdir(), "pi-share-"));
+	try {
+		const timeout = AbortSignal.timeout(UPLOAD_TIMEOUT_MS);
+		const signal = options.signal ? AbortSignal.any([options.signal, timeout]) : timeout;
+		const preference = session.settingsManager.getSessionShareDestination();
+		const token = preference === "gist" ? undefined : await radiusCredential(session);
+		if (!token && preference === "radius") {
+			throw new Error("Radius authentication is not configured. Run '/login radius' first.");
+		}
+		const destination = token ? "radius" : "gist";
+		if (options.expectedDestination && destination !== options.expectedDestination) {
+			throw new Error("The share destination changed. Review the destination and try again.");
+		}
+		signal.throwIfAborted();
+		if (token) {
+			const jsonlFile = path.join(directory, "session.jsonl");
+			exportSessionForShare(jsonlFile, session);
+			return await uploadRadius(jsonlFile, token, signal);
+		}
+		const readiness = gistReadiness();
+		if (!readiness.ready) {
+			throw new Error(
+				readiness.reason === "missing-gh"
+					? "GitHub CLI (gh) is not installed. Install it from https://cli.github.com/"
+					: "GitHub CLI is not logged in. Run 'gh auth login' first.",
+			);
+		}
+		const htmlFile = path.join(directory, "session.html");
+		await session.exportToHtml(htmlFile, { themeName: options.themeName });
+		return await uploadGist(htmlFile, signal);
+	} finally {
+		try {
+			fs.rmSync(directory, { recursive: true, force: true });
+		} catch {
+			// A temporary file can remain locked after upload; cleanup must not hide its result.
+		}
+	}
+}
