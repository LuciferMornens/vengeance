index 0000000..27f63d8
--- /dev/null
+++ b/packages/coding-agent/test/saved-session-share.test.ts
@@ -0,0 +1,191 @@
+import type * as childProcess from "node:child_process";
+import { EventEmitter } from "node:events";
+import { existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { PassThrough } from "node:stream";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { getSavedSessionShareReadiness, shareSavedSession } from "../src/core/saved-session-share.ts";
+
+const processes = vi.hoisted(() => ({ spawn: vi.fn() }));
+
+vi.mock("node:child_process", async (importOriginal) => ({
+	...(await importOriginal<typeof childProcess>()),
+	spawnSync: vi.fn(() => ({ status: 0 })),
+	spawn: processes.spawn,
+}));
+
+describe("saved session sharing", () => {
+	let root: string;
+	let scope: { cwd: string; agentDir: string; projectTrusted: boolean };
+	let sessionPath: string;
+	let settingsPath: string;
+	let authPath: string;
+	let extensionMarker: string;
+
+	beforeEach(() => {
+		vi.clearAllMocks();
+		root = mkdtempSync(join(tmpdir(), "pi-saved-share-test-"));
+		scope = { cwd: join(root, "workspace"), agentDir: join(root, "account"), projectTrusted: true };
+		mkdirSync(scope.cwd, { recursive: true });
+		mkdirSync(scope.agentDir, { recursive: true });
+		mkdirSync(join(scope.cwd, ".pi"), { recursive: true });
+		settingsPath = join(scope.agentDir, "settings.json");
+		authPath = join(scope.agentDir, "auth.json");
+		extensionMarker = join(root, "extension-was-executed");
+		const extensionPath = join(root, "extension.ts");
+		writeFileSync(
+			extensionPath,
+			`import { writeFileSync } from 'node:fs';\n` +
+				`export default function () { writeFileSync(${JSON.stringify(extensionMarker)}, 'executed') }\n`,
+		);
+		writeFileSync(
+			settingsPath,
+			JSON.stringify({
+				sessionShareDestination: "radius",
+				extensions: [extensionPath],
+			}),
+		);
+		writeFileSync(authPath, JSON.stringify({ radius: { type: "api_key", key: "qa-radius-value" } }));
+		sessionPath = join(root, "source.jsonl");
+		const timestamp = new Date().toISOString();
+		writeFileSync(
+			sessionPath,
+			`${[
+				{ type: "session", version: 3, id: "saved-session", cwd: scope.cwd, timestamp },
+				{
+					type: "message",
+					id: "user",
+					parentId: null,
+					timestamp,
+					message: { role: "user", content: "saved branch", timestamp: Date.now() },
+				},
+			]
+				.map((entry) => JSON.stringify(entry))
+				.join("\n")}\n`,
+		);
+	});
+
+	afterEach(() => {
+		vi.unstubAllGlobals();
+		rmSync(root, { recursive: true, force: true });
+	});
+
+	it("reads workspace-specific preferences afresh without network, extensions or configuration writes", async () => {
+		const before = [settingsPath, authPath, sessionPath].map((filePath) => readFileSync(filePath, "utf8"));
+		const filesBefore = readdirSync(root, { recursive: true });
+		const fetchMock = vi.fn(() => {
+			throw new Error("readiness must not use the network");
+		});
+		vi.stubGlobal("fetch", fetchMock);
+		expect(await getSavedSessionShareReadiness(scope)).toEqual({ ready: true, destination: "radius" });
+		expect(fetchMock).not.toHaveBeenCalled();
+		expect(existsSync(extensionMarker)).toBe(false);
+		expect([settingsPath, authPath, sessionPath].map((filePath) => readFileSync(filePath, "utf8"))).toEqual(before);
+		expect(readdirSync(root, { recursive: true })).toEqual(filesBefore);
+		writeFileSync(join(scope.cwd, ".pi", "settings.json"), JSON.stringify({ sessionShareDestination: "gist" }));
+		expect(await getSavedSessionShareReadiness(scope)).toEqual({ ready: true, destination: "gist" });
+		expect(await getSavedSessionShareReadiness({ ...scope, projectTrusted: false })).toEqual({
+			ready: true,
+			destination: "radius",
+		});
+		writeFileSync(authPath, "{}");
+		expect(await getSavedSessionShareReadiness({ ...scope, projectTrusted: false })).toEqual({
+			ready: false,
+			destination: "radius",
+			reason: "radius-signed-out",
+		});
+	});
+
+	it("does not create an account store when no Radius credential exists", async () => {
+		rmSync(authPath);
+		expect(await getSavedSessionShareReadiness(scope)).toEqual({
+			ready: false,
+			destination: "radius",
+			reason: "radius-signed-out",
+		});
+		expect(existsSync(authPath)).toBe(false);
+	});
+
+	it.each([true, false])(
+		"shares a source with trailing newline %s without changing it or settings",
+		async (terminated) => {
+			if (!terminated) writeFileSync(sessionPath, readFileSync(sessionPath, "utf8").trimEnd());
+			const before = [settingsPath, authPath, sessionPath].map((filePath) => readFileSync(filePath, "utf8"));
+			const fetchMock = vi.fn(async () =>
+				Response.json({
+					artifact: { canonical_url: "https://radius.test/artifacts/saved" },
+				}),
+			);
+			vi.stubGlobal("fetch", fetchMock);
+			expect(await shareSavedSession({ ...scope, sessionPath, expectedDestination: "radius" })).toEqual({
+				destination: "radius",
+				url: "https://radius.test/artifacts/saved",
+			});
+			expect(fetchMock).toHaveBeenCalledOnce();
+			const [url, options] = fetchMock.mock.calls[0] as unknown as [URL, RequestInit];
+			expect(url.pathname).toBe("/v1/artifacts");
+			expect(String(options.body)).toContain("saved branch");
+			expect(String(options.body)).toContain('"customType":"pi.share"');
+			expect(existsSync(extensionMarker)).toBe(false);
+			expect([settingsPath, authPath, sessionPath].map((filePath) => readFileSync(filePath, "utf8"))).toEqual(
+				before,
+			);
+		},
+	);
+
+	it.each([
+		{ preference: "gist", accountExists: false },
+		{ preference: "gist", accountExists: true },
+		{ preference: "auto", accountExists: false },
+		{ preference: "auto", accountExists: true },
+	])("shares retired-model history with $preference and account store $accountExists", async (fixture) => {
+		if (fixture.accountExists) writeFileSync(authPath, "{}");
+		else rmSync(authPath);
+		const settings = JSON.parse(readFileSync(settingsPath, "utf8"));
+		settings.sessionShareDestination = fixture.preference;
+		writeFileSync(settingsPath, JSON.stringify(settings));
+		const history =
+			readFileSync(sessionPath, "utf8") +
+			JSON.stringify({
+				type: "model_change",
+				id: "retired-model",
+				parentId: "user",
+				timestamp: new Date().toISOString(),
+				provider: "retired-provider",
+				modelId: "retired-model",
+			});
+		writeFileSync(sessionPath, history);
+		const accountFiles = readdirSync(scope.agentDir);
+		const settingsBefore = readFileSync(settingsPath, "utf8");
+		const fetchMock = vi.fn(() => {
+			throw new Error("gist must not use provider APIs");
+		});
+		vi.stubGlobal("fetch", fetchMock);
+		let uploadedHtml = "";
+		processes.spawn.mockImplementation((_command: string, args: string[]) => {
+			uploadedHtml = readFileSync(args.at(-1)!, "utf8");
+			const child = Object.assign(new EventEmitter(), {
+				stdout: new PassThrough(),
+				stderr: new PassThrough(),
+			});
+			queueMicrotask(() => {
+				child.stdout.end("https://gist.github.com/test/saved-no-model\n");
+				child.emit("close", 0);
+			});
+			return child;
+		});
+		expect(await shareSavedSession({ ...scope, sessionPath, expectedDestination: "gist" })).toMatchObject({
+			destination: "gist",
+			gistUrl: "https://gist.github.com/test/saved-no-model",
+		});
+		expect(processes.spawn).toHaveBeenCalledOnce();
+		expect(uploadedHtml).toContain("<html");
+		expect(fetchMock).not.toHaveBeenCalled();
+		expect(existsSync(extensionMarker)).toBe(false);
+		expect(readFileSync(sessionPath, "utf8")).toBe(history);
+		expect(readFileSync(settingsPath, "utf8")).toBe(settingsBefore);
+		expect(readdirSync(scope.agentDir)).toEqual(accountFiles);
+		if (fixture.accountExists) expect(readFileSync(authPath, "utf8")).toBe("{}");
+	});
+});
