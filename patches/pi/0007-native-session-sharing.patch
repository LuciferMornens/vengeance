index 0000000..9e66d56
--- /dev/null
+++ b/packages/coding-agent/test/session-sharing-headless.test.ts
@@ -0,0 +1,152 @@
+import { EventEmitter } from "node:events";
+import { existsSync, writeFileSync } from "node:fs";
+import { PassThrough } from "node:stream";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { AgentSession } from "../src/core/agent-session.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { getSessionShareReadiness, shareSessionHeadless } from "../src/core/session-sharing.ts";
+
+const processes = vi.hoisted(() => ({
+	spawn: vi.fn(),
+	spawnSync: vi.fn(() => ({ status: 0 })),
+}));
+vi.mock("node:child_process", () => processes);
+
+function session(preference: "auto" | "gist" | "radius", token?: string) {
+	const manager = SessionManager.inMemory(process.cwd());
+	const root = manager.appendMessage({ role: "user", content: "root", timestamp: Date.now() });
+	manager.appendMessage({ role: "user", content: "abandoned", timestamp: Date.now() });
+	manager.branch(root);
+	manager.appendMessage({ role: "user", content: "selected", timestamp: Date.now() });
+	const getAuth = vi.fn(async () => (token ? { auth: { apiKey: token } } : undefined));
+	const native = {
+		sessionManager: manager,
+		state: {
+			systemPrompt: "system instructions",
+			tools: [{ name: "read", description: "Read a file", parameters: { type: "object" } }],
+		},
+		settingsManager: { getSessionShareDestination: () => preference },
+		modelRuntime: {
+			getProvider: () => ({ id: "radius" }),
+			getProviderAuthStatus: () => ({ configured: !!token }),
+			getAuth,
+		},
+		exportToHtml: vi.fn(async (filePath: string) => writeFileSync(filePath, "native html")),
+	};
+	// Narrow fixture at the native session boundary; tests call only the public sharing functions.
+	return { native: native as unknown as AgentSession, getAuth, manager };
+}
+
+describe("headless session sharing", () => {
+	beforeEach(() => {
+		vi.clearAllMocks();
+		processes.spawnSync.mockReturnValue({ status: 0 });
+		processes.spawn.mockImplementation(() => {
+			const child = Object.assign(new EventEmitter(), {
+				stdout: new PassThrough(),
+				stderr: new PassThrough(),
+			});
+			queueMicrotask(() => {
+				child.stdout.end("https://gist.github.com/test/native-gist\n");
+				child.emit("close", 0);
+			});
+			return child;
+		});
+	});
+	afterEach(() => vi.unstubAllGlobals());
+
+	it("reports the configured destination without resolving OAuth", () => {
+		const fixture = session("auto", "qa-token");
+		expect(getSessionShareReadiness(fixture.native)).toEqual({ ready: true, destination: "radius" });
+		expect(fixture.getAuth).not.toHaveBeenCalled();
+		expect(processes.spawnSync).not.toHaveBeenCalled();
+	});
+
+	it("uploads the active branch and native presentation metadata to the organization", async () => {
+		const fixture = session("auto", "qa-token");
+		const before = fixture.manager.getBranch();
+		const fetchMock = vi.fn(async () =>
+			Response.json({
+				artifact: { canonical_url: "https://radius.test/artifact/shared" },
+			}),
+		);
+		vi.stubGlobal("fetch", fetchMock);
+		expect(await shareSessionHeadless(fixture.native, { expectedDestination: "radius" })).toEqual({
+			destination: "radius",
+			url: "https://radius.test/artifact/shared",
+		});
+		const [url, options] = fetchMock.mock.calls[0] as unknown as [URL, RequestInit];
+		expect(url.pathname).toBe("/v1/artifacts");
+		expect(url.searchParams.get("visibility")).toBe("organization");
+		expect(url.searchParams.get("title")).toBe("Pi session");
+		expect(options.method).toBe("POST");
+		expect(options.headers).toMatchObject({ Authorization: "Bearer qa-token" });
+		const body = String(options.body);
+		expect(body).toContain("selected");
+		expect(body).not.toContain("abandoned");
+		expect(body).toContain('"customType":"pi.share"');
+		expect(body).toContain("system instructions");
+		expect(body).toContain("Read a file");
+		expect(fixture.getAuth).toHaveBeenCalledWith("radius", { minOAuthValidityMs: 300_000 });
+		expect(fixture.manager.getBranch()).toEqual(before);
+		expect(processes.spawn).not.toHaveBeenCalled();
+	});
+
+	it("forces gist without resolving Radius credentials and removes its temporary export", async () => {
+		const fixture = session("gist", "qa-token");
+		const result = await shareSessionHeadless(fixture.native, { expectedDestination: "gist" });
+		expect(result).toMatchObject({ destination: "gist", gistUrl: "https://gist.github.com/test/native-gist" });
+		expect(fixture.getAuth).not.toHaveBeenCalled();
+		const filePath = processes.spawn.mock.calls[0][1].at(-1) as string;
+		expect(existsSync(filePath)).toBe(false);
+	});
+
+	it("falls back to gist only when auto has no Radius credential", async () => {
+		const fixture = session("auto");
+		expect(await shareSessionHeadless(fixture.native)).toMatchObject({ destination: "gist" });
+		expect(fixture.getAuth).toHaveBeenCalledOnce();
+	});
+
+	it("refuses Radius without credentials", async () => {
+		const fixture = session("radius");
+		expect(getSessionShareReadiness(fixture.native)).toEqual({
+			ready: false,
+			destination: "radius",
+			reason: "radius-signed-out",
+		});
+		await expect(shareSessionHeadless(fixture.native)).rejects.toThrow("authentication is not configured");
+		expect(processes.spawn).not.toHaveBeenCalled();
+	});
+
+	it.each(["upload", "auth"])("does not fall back after a Radius %s failure", async (failure) => {
+		const fixture = session("auto", "qa-token");
+		if (failure === "auth") fixture.getAuth.mockRejectedValue(new Error("refresh failed"));
+		vi.stubGlobal(
+			"fetch",
+			vi.fn(async () => Response.json({ error: "upload refused" }, { status: 403 })),
+		);
+		await expect(shareSessionHeadless(fixture.native)).rejects.toThrow(
+			failure === "auth" ? "refresh failed" : "upload refused",
+		);
+		expect(processes.spawn).not.toHaveBeenCalled();
+		expect(processes.spawnSync).not.toHaveBeenCalled();
+	});
+
+	it("requires another review when credentials change the destination", async () => {
+		const fixture = session("auto");
+		await expect(shareSessionHeadless(fixture.native, { expectedDestination: "radius" })).rejects.toThrow(
+			"destination changed",
+		);
+		expect(processes.spawn).not.toHaveBeenCalled();
+		expect(fixture.native.exportToHtml).not.toHaveBeenCalled();
+	});
+
+	it("does not export or upload an aborted request", async () => {
+		const fixture = session("gist");
+		const controller = new AbortController();
+		controller.abort();
+		await expect(shareSessionHeadless(fixture.native, { signal: controller.signal })).rejects.toThrow();
+		expect(processes.spawn).not.toHaveBeenCalled();
+		expect(fixture.native.exportToHtml).not.toHaveBeenCalled();
+	});
+});
