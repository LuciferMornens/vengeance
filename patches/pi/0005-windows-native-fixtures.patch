diff --git a/scripts/test-filesystem.ts b/scripts/test-filesystem.ts
new file mode 100644
index 00000000..c6c44d0f
--- /dev/null
+++ b/scripts/test-filesystem.ts
@@ -0,0 +1,38 @@
+import { mkdtempSync, rmSync, symlinkSync as nativeSymlinkSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { basename, dirname, join, resolve } from "node:path";
+
+/** Directory junctions exercise real Windows aliases without administrator privileges. */
+export function symlinkSync(target: string, path: string, type?: "file" | "dir" | "junction"): void {
+	nativeSymlinkSync(target, path, process.platform === "win32" && type === "dir" ? "junction" : type);
+}
+
+/** A file reached through a junction has the same canonical identity as its original path. */
+export function createFileAlias(target: string, alias: string): string {
+	if (process.platform !== "win32") {
+		nativeSymlinkSync(target, alias, "file");
+		return alias;
+	}
+	const parentAlias = `${alias}.parent`;
+	nativeSymlinkSync(dirname(resolve(target)), parentAlias, "junction");
+	return join(parentAlias, basename(target));
+}
+
+function probeFileSymlinks(): boolean {
+	if (process.platform !== "win32") return true;
+	const directory = mkdtempSync(join(tmpdir(), "pi-symlink-capability-"));
+	try {
+		const target = join(directory, "target");
+		writeFileSync(target, "fixture");
+		nativeSymlinkSync(target, join(directory, "link"), "file");
+		return true;
+	} catch (error) {
+		if ((error as NodeJS.ErrnoException).code !== "EPERM") throw error;
+		return false;
+	} finally {
+		rmSync(directory, { recursive: true, force: true });
+	}
+}
+
+/** File-link metadata tests require Windows symlink privilege; directory/alias tests always run. */
+export const fileSymlinksAvailable = probeFileSymlinks();
