+/** Minimal MCP server over an in-memory transport that offers `SERVER_TOOLS`. */
+function createFakeServer() {
+	const pair = createInMemoryTransportPair();
+	pair.server.onMessage((message) => {
+		if (!("id" in message) || !("method" in message)) return;
+		const request = message as JsonRpcRequest;
+		const result =
+			request.method === "initialize"
+				? {
+						protocolVersion: LATEST_PROTOCOL_VERSION,
+						capabilities: { tools: {} },
+						serverInfo: { name: "fake", version: "1.0.0" },
+					}
+				: request.method === "tools/list"
+					? { tools: SERVER_TOOLS }
+					: {};
+		queueMicrotask(() => void pair.server.send({ jsonrpc: "2.0", id: request.id, result }));
+	});
+	void pair.server.start();
+	return pair.client;
+}
+
+/** MCP server that never answers, so connecting to it lasts until the connection closes. */
+function createHangingServer() {
+	const pair = createInMemoryTransportPair();
+	void pair.server.start();
+	return pair.client;
