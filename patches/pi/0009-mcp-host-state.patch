+					}),
+					credentials: new McpOAuthCredentialStore(new InMemoryAuthStorageBackend()),
+					updateConfig: (entry, patch) => {
+						if (saveError) throw new Error(saveError);
+						patches.push([entry.name, patch]);
+						saves.push(entry.override ?? entry.source);
+					},
+					createTransport: (entry) => {
+						transports.push(entry.name);
+						if (entry.name === "broken") throw new Error("spawn failed");
+						return entry.name === "hanging" ? createHangingServer() : createFakeServer();
