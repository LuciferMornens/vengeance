index 0000000..31f873a
--- /dev/null
+++ b/packages/coding-agent/test/model-runtime-oauth-rejection.test.ts
@@ -0,0 +1,180 @@
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+	type Context,
+	type Model,
+	type OAuthAuth,
+	type OAuthCredential,
+	OAuthEndpointError,
+	type Provider,
+} from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import { ModelRuntime } from "../src/core/model-runtime.ts";
+
+const context: Context = { messages: [{ role: "user", content: "title this", timestamp: 0 }] };
+const interaction = { prompt: async () => "unused", notify: () => {} };
+
+function model(provider: string): Model<"openai-completions"> {
+	return {
+		id: `${provider}-model`,
+		name: `${provider} model`,
+		api: "openai-completions",
+		provider,
+		baseUrl: "https://example.test/v1",
+		reasoning: false,
+		input: ["text"],
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+		contextWindow: 1000,
+		maxTokens: 100,
+	};
+}
+
+function provider(id: string, auth: Provider["auth"]): Provider<"openai-completions"> {
+	const providerModel = model(id);
+	return {
+		id,
+		name: id,
+		auth,
+		getModels: () => [providerModel],
+		stream: () => {
+			throw new Error("unused");
+		},
+		streamSimple: () => {
+			throw new Error("unused");
+		},
+	};
+}
+
+function signIn(refresh: OAuthAuth["refresh"]): OAuthAuth {
+	return {
+		name: "Subscription",
+		login: async () => ({
+			type: "oauth",
+			access: "fresh",
+			refresh: "fresh-refresh",
+			expires: Date.now() + 3_600_000,
+		}),
+		refresh,
+		toAuth: async (credential) => ({ apiKey: credential.access }),
+	};
+}
+
+const deadSignIn: OAuthCredential = {
+	type: "oauth",
+	access: "old",
+	refresh: "dead",
+	expires: 0,
+	accountId: "account",
+};
+
+const directories: string[] = [];
+
+afterEach(() => {
+	for (const directory of directories.splice(0)) rmSync(directory, { recursive: true, force: true });
+});
+
+async function runtimeWith(refresh: OAuthAuth["refresh"]) {
+	const directory = mkdtempSync(join(tmpdir(), "pi-oauth-rejection-"));
+	directories.push(directory);
+	const authPath = join(directory, "auth.json");
+	writeFileSync(authPath, JSON.stringify({ subscription: deadSignIn, keyed: { type: "api_key", key: "key" } }));
+	const refreshMock = vi.fn(refresh);
+	const create = async () => {
+		const runtime = await ModelRuntime.create({ authPath, modelsPath: null, allowModelNetwork: false });
+		runtime.registerNativeProvider(provider("subscription", { oauth: signIn(refreshMock) }));
+		runtime.registerNativeProvider(
+			provider("keyed", {
+				apiKey: {
+					name: "API key",
+					resolve: async ({ credential }) => (credential?.key ? { auth: { apiKey: credential.key } } : undefined),
+				},
+			}),
+		);
+		await runtime.refresh({ allowNetwork: false });
+		return runtime;
+	};
+	return { runtime: await create(), create, authPath, refresh: refreshMock };
+}
+
+function availableProviders(runtime: ModelRuntime): string[] {
+	return runtime.getAvailableSnapshot().map((entry) => entry.provider);
+}
+
+describe("ModelRuntime with a rejected OAuth refresh token", () => {
+	it("drops the provider from availability before the failure reaches the caller", async () => {
+		const { runtime, authPath, refresh } = await runtimeWith(async () => {
+			throw new OAuthEndpointError(
+				'OpenAI OAuth token request failed (400): {"error":"invalid_grant"}',
+				400,
+				"invalid_grant",
+			);
+		});
+		expect(availableProviders(runtime)).toEqual(["subscription", "keyed"]);
+
+		await expect(runtime.getAuth("subscription")).rejects.toThrow("Sign-in for subscription expired");
+
+		expect(runtime.hasConfiguredAuth("subscription")).toBe(false);
+		expect(availableProviders(runtime)).toEqual(["keyed"]);
+		expect(await runtime.hasRejectedOAuthCredential("subscription")).toBe(true);
+		expect(await runtime.hasRejectedOAuthCredential("keyed")).toBe(false);
+		const stored = JSON.parse(readFileSync(authPath, "utf8"));
+		expect(stored.subscription).toEqual({ ...deadSignIn, refreshRejectedAt: expect.any(Number) });
+		expect(stored.keyed).toEqual({ type: "api_key", key: "key" });
+
+		const message = await runtime.completeSimple(model("subscription"), context);
+		expect(message.stopReason).toBe("error");
+		expect(message.errorMessage).toBe(
+			"Sign-in for subscription expired: the provider rejected its refresh token. Sign in again.",
+		);
+		expect(refresh).toHaveBeenCalledOnce();
+	});
+
+	it("starts without the provider and returns it after a new sign-in", async () => {
+		const { create, authPath, refresh } = await runtimeWith(async () => {
+			throw new OAuthEndpointError("token request failed (400)", 400, "invalid_grant");
+		});
+		await expect((await create()).getAuth("subscription")).rejects.toThrow("Sign-in for subscription expired");
+
+		const restarted = await create();
+		expect(restarted.hasConfiguredAuth("subscription")).toBe(false);
+		expect(availableProviders(restarted)).toEqual(["keyed"]);
+		expect(await restarted.checkAuth("subscription")).toBeUndefined();
+
+		await restarted.login("subscription", "oauth", interaction);
+		expect(availableProviders(restarted)).toEqual(["subscription", "keyed"]);
+		expect(JSON.parse(readFileSync(authPath, "utf8")).subscription).not.toHaveProperty("refreshRejectedAt");
+		expect((await restarted.getAuth("subscription"))?.auth.apiKey).toBe("fresh");
+		expect(refresh).toHaveBeenCalledOnce();
+	});
+
+	it("keeps the provider available after a transient refresh failure", async () => {
+		const { runtime, authPath, refresh } = await runtimeWith(async () => {
+			throw new OAuthEndpointError("token request failed (502)", 502);
+		});
+
+		await expect(runtime.getAuth("subscription")).rejects.toThrow("OAuth refresh failed for subscription");
+
+		expect(runtime.hasConfiguredAuth("subscription")).toBe(true);
+		expect(availableProviders(runtime)).toEqual(["subscription", "keyed"]);
+		expect(JSON.parse(readFileSync(authPath, "utf8")).subscription).toEqual(deadSignIn);
+		await expect(runtime.getAuth("subscription")).rejects.toThrow("OAuth refresh failed for subscription");
+		expect(refresh).toHaveBeenCalledTimes(2);
+	});
+
+	it("reads the mark through an in-memory store", async () => {
+		const credentials = AuthStorage.inMemory({ subscription: { ...deadSignIn, refreshRejectedAt: 1 } });
+		const runtime = await ModelRuntime.create({ credentials, modelsPath: null, allowModelNetwork: false });
+		const refresh = vi.fn(async (): Promise<OAuthCredential> => {
+			throw new Error("unused");
+		});
+		runtime.registerNativeProvider(provider("subscription", { oauth: signIn(refresh) }));
+		await runtime.refresh({ allowNetwork: false });
+
+		expect(runtime.hasConfiguredAuth("subscription")).toBe(false);
+		expect(runtime.getAvailableSnapshot()).toEqual([]);
+		await expect(runtime.getAuth("subscription")).rejects.toThrow("Sign-in for subscription expired");
+		expect(refresh).not.toHaveBeenCalled();
+	});
+});
