+ * `store`, whose `list` waits while held. Only a full availability pass lists credentials, so a held
+ * pass stays in flight until `release`, or fails on `fail`; `listed(count)` resolves once `count` listings
+ * are waiting. A newer hold takes over the listings that start after it, and outlasts the end of an older one.
+ */
+function holdableList(store: CredentialStore) {
+	let gate: Promise<void> | undefined;
+	let listed = 0;
+	let waiting: Array<{ count: number; resolve: () => void }> = [];
+	const credentials: CredentialStore = {
+		read: (providerId, options) => store.read(providerId, options),
+		modify: (providerId, fn, options) => store.modify(providerId, fn, options),
+		delete: (providerId, options) => store.delete(providerId, options),
+		list: async (options) => {
+			const held = gate;
+			if (held) {
+				listed++;
+				for (const entry of waiting.filter((entry) => entry.count <= listed)) entry.resolve();
+				await held;
+			}
+			return store.list(options);
+		},
+	};
+	const hold = () => {
+		let release = () => {};
+		let reject: (error: Error) => void = () => {};
+		const own = new Promise<void>((resolve, fail) => {
+			release = resolve;
+			reject = fail;
+		});
+		gate = own;
+		listed = 0;
+		waiting = [];
+		return {
+			listed: (count: number) =>
