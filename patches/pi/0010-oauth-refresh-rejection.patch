+import type { Api, Model } from "../src/types.ts";
+
+const neverAbortedSignal = new AbortController().signal;
+
+function testModel(provider: string): Model<Api> {
+	return {
+		id: "model-a",
+		name: "model-a",
+		api: "test-api",
+		provider,
+		baseUrl: "https://example.test/v1",
+		reasoning: false,
+		input: ["text"],
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+		contextWindow: 10000,
+		maxTokens: 1000,
+	};
+}
+
+function testProvider(id: string, oauth: OAuthAuth, apiKey?: ApiKeyAuth): Provider {
+	const models = [testModel(id)];
+	return {
+		id,
+		name: id,
+		auth: { oauth, ...(apiKey ? { apiKey } : {}) },
+		getModels: () => models,
+		stream: () => {
+			throw new Error("unused");
+		},
+		streamSimple: () => {
+			throw new Error("unused");
+		},
+	};
+}
+
+function testOAuth(refresh: OAuthAuth["refresh"]): OAuthAuth {
+	return {
+		name: "Test OAuth",
+		login: async () => ({
+			type: "oauth",
+			access: "fresh",
+			refresh: "fresh-refresh",
+			expires: Date.now() + 3_600_000,
+		}),
+		refresh,
+		toAuth: async (credential) => ({ apiKey: credential.access }),
+	};
+}
+
+const expired: OAuthCredential = { type: "oauth", access: "old", refresh: "dead", expires: 0, clientId: "client" };
+
+function invalidGrant(status = 400): OAuthEndpointError {
+	return new OAuthEndpointError(
+		`token request failed (${status}): {"error":"invalid_grant"}`,
+		status,
+		"invalid_grant",
+	);
+}
+
+async function setup(refresh: OAuthAuth["refresh"], apiKey?: ApiKeyAuth) {
+	const credentials = new InMemoryCredentialStore();
+	await credentials.modify("p1", async () => expired);
+	const refreshMock = vi.fn(refresh);
+	const models = createModels({ credentials });
+	models.setProvider(testProvider("p1", testOAuth(refreshMock), apiKey));
+	return { credentials, models, refresh: refreshMock };
+}
+
+describe("OAuth refresh token rejection", () => {
+	it("keeps a rejected credential marked and fails fast without another token request", async () => {
+		const { credentials, models, refresh } = await setup(async () => {
+			throw invalidGrant();
+		});
+
+		const first = models.getAuth("p1");
+		await expect(first).rejects.toMatchObject({ code: "oauth" });
+		await expect(first).rejects.toThrow(
+			'Sign-in for p1 expired: the provider rejected its refresh token (token request failed (400): {"error":"invalid_grant"}). Sign in again.',
+		);
+		const stored = await credentials.read("p1");
+		expect(stored).toMatchObject({ ...expired, refreshRejectedAt: expect.any(Number) });
+		expect(isOAuthRefreshRejected(stored)).toBe(true);
+
+		await expect(models.getAuth("p1")).rejects.toThrow(
+			"Sign-in for p1 expired: the provider rejected its refresh token. Sign in again.",
+		);
+		await expect(models.getAuth(testModel("p1"), { minOAuthValidityMs: 60_000 })).rejects.toMatchObject({
+			code: "oauth",
+		});
+		expect(refresh).toHaveBeenCalledOnce();
+	});
+
+	it("excludes a rejected provider from auth checks, availability and catalog refresh", async () => {
+		const { credentials, models, refresh } = await setup(async () => {
+			throw invalidGrant(401);
+		});
+		expect(await models.checkAuth("p1")).toEqual({ source: "OAuth", type: "oauth" });
+		expect((await models.getAvailable()).map((model) => model.provider)).toEqual(["p1"]);
+
+		await expect(models.getAuth("p1")).rejects.toMatchObject({ code: "oauth" });
+		expect(isOAuthRefreshRejected(await credentials.read("p1"))).toBe(true);
+
+		expect(await models.checkAuth("p1")).toBeUndefined();
+		expect(await models.getAvailable()).toEqual([]);
+		expect(await models.getAllAvailable()).toEqual([]);
+		const result = await models.refresh({ providers: ["p1"] });
+		expect(result.errors.size).toBe(0);
+		expect(refresh).toHaveBeenCalledOnce();
+	});
+
+	it("keeps the stored credential owning its provider instead of falling back to the environment", async () => {
+		const environmentKey: ApiKeyAuth = {
+			name: "Environment key",
+			resolve: async ({ credential }) => ({ auth: { apiKey: credential?.key ?? "env-key" }, source: "P1_API_KEY" }),
+		};
+		const { models } = await setup(async () => {
+			throw invalidGrant();
+		}, environmentKey);
+		await expect(models.getAuth("p1")).rejects.toMatchObject({ code: "oauth" });
+
+		expect(await models.checkAuth("p1")).toBeUndefined();
+		await expect(models.getAuth("p1")).rejects.toMatchObject({ code: "oauth" });
+		// An explicit request key is another credential source and still authenticates.
+		expect((await models.getAuth("p1", { apiKey: "request-key" }))?.auth.apiKey).toBe("request-key");
+	});
+
+	it.each([
+		["a timeout", new DOMException("The operation was aborted due to timeout", "TimeoutError")],
+		["a network failure", new TypeError("fetch failed")],
+		["a server error", new OAuthEndpointError("token request failed (503)", 503, "temporarily_unavailable")],
+		[
+			"invalid_grant with a server error status",
+			new OAuthEndpointError("token request failed (500)", 500, "invalid_grant"),
+		],
+		["another OAuth error", new OAuthEndpointError("token request failed (400)", 400, "invalid_request")],
+		["an unstructured invalid_grant message", new Error("token refresh failed (400): invalid_grant")],
+	])("does not mark the credential after %s", async (_name, failure) => {
+		const { credentials, models, refresh } = await setup(async () => {
+			throw failure;
+		});
+
+		await expect(models.getAuth("p1")).rejects.toThrow("OAuth refresh failed for p1");
+		expect(await credentials.read("p1")).toEqual(expired);
+		expect(await models.checkAuth("p1")).toEqual({ source: "OAuth", type: "oauth" });
+		await expect(models.getAuth("p1")).rejects.toThrow("OAuth refresh failed for p1");
+		expect(refresh).toHaveBeenCalledTimes(2);
+	});
+
+	it("does not spend a token request on a credential another process rejected meanwhile", async () => {
+		const marked: OAuthCredential = { ...expired, refreshRejectedAt: 1 };
+		const store = new InMemoryCredentialStore();
+		await store.modify("p1", async () => marked);
+		// The first read predates the other process's write; the locked read sees it.
+		const credentials: CredentialStore = {
+			read: async () => expired,
+			list: (options) => store.list(options),
+			modify: (providerId, fn, options) => store.modify(providerId, fn, options),
+			delete: (providerId, options) => store.delete(providerId, options),
+		};
+		const refresh = vi.fn(async (): Promise<OAuthCredential> => {
+			throw new Error("unused");
+		});
+		const models = createModels({ credentials });
+		models.setProvider(testProvider("p1", testOAuth(refresh)));
+
+		await expect(models.getAuth("p1")).rejects.toThrow(
+			"Sign-in for p1 expired: the provider rejected its refresh token. Sign in again.",
+		);
+		expect(refresh).not.toHaveBeenCalled();
+	});
+
+	it("clears the mark when a new login replaces the credential", async () => {
+		const { credentials, models } = await setup(async () => {
+			throw invalidGrant();
+		});
+		await expect(models.getAuth("p1")).rejects.toMatchObject({ code: "oauth" });
+
+		await models.login("p1", "oauth", { prompt: async () => "unused", notify: () => {} });
+
+		const stored = await credentials.read("p1");
+		expect(stored).toMatchObject({ access: "fresh", refresh: "fresh-refresh" });
+		expect(stored).not.toHaveProperty("refreshRejectedAt");
+		expect(await models.checkAuth("p1")).toEqual({ source: "OAuth", type: "oauth" });
+		expect((await models.getAuth("p1"))?.auth.apiKey).toBe("fresh");
+	});
+
+	it("recognizes an endpoint rejection wrapped as a cause, and only structured endpoint errors", () => {
+		expect(isRefreshTokenRejection(new Error("refresh request failed", { cause: invalidGrant() }))).toBe(true);
+		const lookalike = Object.assign(new Error("token request failed (400)"), {
+			status: 400,
+			oauthError: "invalid_grant",
+		});
+		expect(isRefreshTokenRejection(lookalike)).toBe(false);
+		expect(isRefreshTokenRejection("invalid_grant")).toBe(false);
+	});
+});
+
+describe("built-in OAuth flows report rejected refresh tokens", () => {
+	afterEach(() => {
+		vi.unstubAllGlobals();
+	});
+
+	function respond(status: number, body: unknown): void {
+		vi.stubGlobal(
+			"fetch",
+			vi.fn(
+				async () => new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } }),
+			),
+		);
+	}
+
+	const flows: [string, () => Promise<unknown>][] = [
+		["OpenAI", () => openaiChatGPTOAuth.refresh(expired, neverAbortedSignal)],
+		["OpenAI Codex", () => openaiCodexOAuth.refresh(expired, neverAbortedSignal)],
+		["Anthropic", () => anthropicOAuth.refresh(expired, neverAbortedSignal)],
+		["xAI", () => xaiOAuth.refresh(expired, neverAbortedSignal)],
+		["Kimi Code", () => kimiCodingOAuth.refresh(expired, neverAbortedSignal)],
+		[
+			"Radius",
+			() =>
+				createRadiusOAuth({ name: "Radius", gateway: "https://radius.example.test" }).refresh(
+					expired,
+					neverAbortedSignal,
+				),
+		],
+	];
+
+	it.each(flows)("%s marks invalid_grant as a rejection", async (_name, refresh) => {
+		respond(400, { error: "invalid_grant", error_description: "Refresh token revoked" });
+		const failure = await refresh().catch((error: unknown) => error);
+		expect(isRefreshTokenRejection(failure)).toBe(true);
+	});
+
+	it("OpenAI keeps server errors and non-RFC bodies retryable", async () => {
+		respond(503, { error: "temporarily_unavailable" });
+		expect(
+			isRefreshTokenRejection(await openaiChatGPTOAuth.refresh(expired, neverAbortedSignal).catch((e) => e)),
+		).toBe(false);
+		respond(401, { error: { message: "Could not validate your token", type: "invalid_request_error" } });
+		expect(isRefreshTokenRejection(await openaiCodexOAuth.refresh(expired, neverAbortedSignal).catch((e) => e))).toBe(
+			false,
+		);
+	});
+});
