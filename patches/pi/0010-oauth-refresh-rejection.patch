+import type { Credential } from "./types.ts";
+
+// Bundles emit each lazily loaded OAuth flow with its own copy of this module, so errors are
+// recognized by a registered symbol rather than by `instanceof`.
+const OAUTH_ENDPOINT_ERROR = Symbol.for("@earendil-works/pi-ai:OAuthEndpointError");
+
+/**
+ * Error response from an OAuth 2.0 endpoint (RFC 6749 section 5.2). `oauthError` is the
+ * response's `error` code when its body is a JSON object with one.
+ */
+export class OAuthEndpointError extends Error {
+	readonly status: number;
+	readonly oauthError: string | undefined;
+
+	constructor(message: string, status: number, oauthError?: string) {
+		super(message);
+		this.status = status;
+		this.oauthError = oauthError;
+		Object.defineProperty(this, OAUTH_ENDPOINT_ERROR, { value: true });
+	}
+}
+
+/** The `error` code of an OAuth error response body, given as text or as parsed JSON. */
+export function oauthErrorCode(body: unknown): string | undefined {
+	let data = body;
+	if (typeof body === "string") {
+		try {
+			data = JSON.parse(body);
+		} catch {
+			return undefined;
+		}
+	}
+	if (typeof data !== "object" || data === null || Array.isArray(data)) return undefined;
+	const code = (data as { error?: unknown }).error;
+	return typeof code === "string" ? code : undefined;
+}
+
+function isOAuthEndpointError(value: Error): value is OAuthEndpointError {
+	return OAUTH_ENDPOINT_ERROR in value;
+}
+
+// Wrappers add context around an endpoint error; a few levels of `cause` cover every flow.
+const MAX_CAUSE_DEPTH = 4;
+
+/**
+ * Whether a refresh failed because the authorization server definitively rejected the refresh
+ * token: an RFC 6749 `invalid_grant` error response with HTTP 400, or 401 as some servers send it.
+ * Timeouts, network failures, server errors, cancellation and other error codes do not qualify, so
+ * the credential stays usable for a retry. A flow may wrap the endpoint error as `cause`.
+ */
+export function isRefreshTokenRejection(error: unknown): boolean {
+	let current = error;
+	for (let depth = 0; current instanceof Error && depth <= MAX_CAUSE_DEPTH; depth++) {
+		if (isOAuthEndpointError(current)) {
+			return current.oauthError === "invalid_grant" && (current.status === 400 || current.status === 401);
+		}
+		current = current.cause;
+	}
+	return false;
+}
+
+/**
+ * Whether the provider rejected this stored OAuth credential's refresh token. Such a credential
+ * authenticates nothing until a new login replaces it.
+ */
+export function isOAuthRefreshRejected(credential: Credential | undefined): boolean {
+	return credential?.type === "oauth" && typeof credential.refreshRejectedAt === "number";
+}
