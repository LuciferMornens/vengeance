diff --git a/packages/ai/src/providers/audn.ts b/packages/ai/src/providers/audn.ts
new file mode 100644
index 0000000..d254f1f
--- /dev/null
+++ b/packages/ai/src/providers/audn.ts
@@ -0,0 +1,46 @@
+import { openAICompletionsApi } from "../api/openai-completions.lazy.ts";
+import { envApiKeyAuth } from "../auth/helpers.ts";
+import { createProvider, type Provider } from "../models.ts";
+import type { Model } from "../types.ts";
+
+const PROVIDER_ID = "audn";
+const BASE_URL = "https://platform.audn.ai/api/v1";
+
+// Limits and USD per million tokens: GET /api/v1/models. No cache write price is listed, so writes cost the input
+// price. The API takes images but the model answers as if they were absent, so only text is declared.
+export const AUDN_MODELS = {
+	necromicon: {
+		id: "necromicon",
+		name: "Necromicon",
+		provider: PROVIDER_ID,
+		baseUrl: BASE_URL,
+		api: "openai-completions",
+		reasoning: true,
+		// Audn documents low, high and max. `none` and made-up values still answer 200 and the model still reasons,
+		// so reasoning cannot be turned off and the other levels would be controls that cannot be shown to do anything.
+		thinkingLevelMap: { off: null, minimal: null, low: "low", medium: null, high: "high", xhigh: null, max: "max" },
+		input: ["text"],
+		contextWindow: 1048576,
+		maxTokens: 32768,
+		cost: { input: 3, output: 5, cacheRead: 0.3, cacheWrite: 3 },
+		compat: {
+			supportsStore: false,
+			supportsDeveloperRole: false,
+			supportsReasoningEffort: true,
+			maxTokensField: "max_tokens",
+			supportsStrictMode: false,
+			supportsLongCacheRetention: false,
+		},
+	},
+} satisfies Record<string, Model<"openai-completions">>;
+
+export function audnProvider(): Provider<"openai-completions"> {
+	return createProvider({
+		id: PROVIDER_ID,
+		name: "Audn",
+		baseUrl: BASE_URL,
+		auth: { apiKey: envApiKeyAuth("Audn API key", ["AUDN_API_KEY"]) },
+		models: Object.values(AUDN_MODELS),
+		api: openAICompletionsApi(),
+	});
+}
