diff --git a/packages/ai/test/audn.test.ts b/packages/ai/test/audn.test.ts
new file mode 100644
index 0000000..38eaffc
--- /dev/null
+++ b/packages/ai/test/audn.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from "vitest";
+import { findEnvKeys, getEnvApiKey } from "../src/env-api-keys.ts";
+import { clampThinkingLevel, getSupportedThinkingLevels } from "../src/models.ts";
+import { builtinModels, getBuiltinModel, getBuiltinModels, getBuiltinProviders } from "../src/providers/all.ts";
+
+const MODEL_ID = "necromicon";
+
+describe("Audn provider", () => {
+	it("offers native API-key login and shares the static and runtime catalog", async () => {
+		const models = builtinModels({
+			authContext: { env: async () => undefined, fileExists: async () => false },
+		});
+		const provider = models.getProviders().find((entry) => entry.id === "audn");
+		expect(provider?.name).toBe("Audn");
+		expect(provider?.auth.oauth).toBeUndefined();
+		expect(await models.getAvailable("audn")).toEqual([]);
+		const credential = await models.login("audn", "api_key", {
+			prompt: async () => "test-audn-key",
+			notify: () => {},
+		});
+		expect(credential).toEqual({ type: "api_key", key: "test-audn-key" });
+		expect(getBuiltinProviders()).toContain("audn");
+		expect(models.getModels("audn")).toEqual(getBuiltinModels("audn"));
+		expect((await models.getAvailable("audn")).map((model) => model.id)).toEqual([MODEL_ID]);
+		await models.logout("audn");
+		expect(await models.getAvailable("audn")).toEqual([]);
+	});
+
+	it("resolves AUDN_API_KEY without another provider's credentials", async () => {
+		const environment = { AUDN_API_KEY: "test-audn-key", ABLIT_KEY: "other-key" };
+		expect(findEnvKeys("audn", environment)).toEqual(["AUDN_API_KEY"]);
+		expect(getEnvApiKey("audn", environment)).toBe(environment.AUDN_API_KEY);
+		const models = builtinModels({
+			authContext: {
+				env: async (name) => environment[name as keyof typeof environment],
+				fileExists: async () => false,
+			},
+		});
+		expect((await models.getAuth("audn"))?.auth.apiKey).toBe(environment.AUDN_API_KEY);
+	});
+
+	it("offers the documented efforts without Off and moves a saved level to the next one up", () => {
+		const model = getBuiltinModel("audn", MODEL_ID);
+		expect(getSupportedThinkingLevels(model)).toEqual(["low", "high", "max"]);
+		expect(clampThinkingLevel(model, "off")).toBe("low");
+		expect(clampThinkingLevel(model, "minimal")).toBe("low");
+		expect(clampThinkingLevel(model, "medium")).toBe("high");
+		expect(clampThinkingLevel(model, "xhigh")).toBe("max");
+	});
+
+	it("declares the live limits, text input, prices and the request shape the API accepts", () => {
+		const model = getBuiltinModel("audn", MODEL_ID);
+		expect(model).toMatchObject({
+			baseUrl: "https://platform.audn.ai/api/v1",
+			api: "openai-completions",
+			input: ["text"],
+			contextWindow: 1048576,
+			maxTokens: 32768,
+			cost: { input: 3, output: 5, cacheRead: 0.3, cacheWrite: 3 },
+			compat: { supportsDeveloperRole: false, supportsStore: false, maxTokensField: "max_tokens" },
+		});
+	});
+});
