diff --git a/packages/ai/test/abliteration.test.ts b/packages/ai/test/abliteration.test.ts
new file mode 100644
index 00000000..05e4ce22
--- /dev/null
+++ b/packages/ai/test/abliteration.test.ts
@@ -0,0 +1,57 @@
+import { describe, expect, it } from "vitest";
+import { findEnvKeys, getEnvApiKey } from "../src/env-api-keys.ts";
+import { getSupportedThinkingLevels } from "../src/models.ts";
+import { builtinModels, getBuiltinModel, getBuiltinModels, getBuiltinProviders } from "../src/providers/all.ts";
+
+describe("Abliteration provider", () => {
+	it("offers native API-key login and shares the static and runtime catalog", async () => {
+		const models = builtinModels({
+			authContext: { env: async () => undefined, fileExists: async () => false },
+		});
+		const provider = models.getProviders().find((entry) => entry.id === "abliteration");
+		expect(provider?.auth.oauth).toBeUndefined();
+		expect(await models.getAuth("abliteration")).toBeUndefined();
+		expect(await models.getAvailable("abliteration")).toEqual([]);
+		const credential = await models.login("abliteration", "api_key", {
+			prompt: async () => "test-abliteration-key",
+			notify: () => {},
+		});
+		expect(credential).toEqual({ type: "api_key", key: "test-abliteration-key" });
+		expect(getBuiltinProviders()).toContain("abliteration");
+		expect(models.getModels("abliteration")).toEqual(getBuiltinModels("abliteration"));
+		expect(await models.getAvailable("abliteration")).toHaveLength(4);
+		await models.logout("abliteration");
+		expect(await models.getAvailable("abliteration")).toEqual([]);
+	});
+
+	it("resolves ABLIT_KEY without another provider's credentials", async () => {
+		const environment = { ABLIT_KEY: "test-abliteration-key", OPENAI_API_KEY: "other-key" };
+		expect(findEnvKeys("abliteration", environment)).toEqual(["ABLIT_KEY"]);
+		expect(getEnvApiKey("abliteration", environment)).toBe(environment.ABLIT_KEY);
+		const models = builtinModels({
+			authContext: {
+				env: async (name) => environment[name as keyof typeof environment],
+				fileExists: async () => false,
+			},
+		});
+		expect((await models.getAuth("abliteration"))?.auth.apiKey).toBe(environment.ABLIT_KEY);
+		expect((await models.getAvailable("abliteration")).map((model) => model.id)).toHaveLength(4);
+	});
+
+	it("offers every effort, Off except on Large v2, and vision on the base model and Large Flash", () => {
+		const every = ["off", "minimal", "low", "medium", "high", "xhigh", "max"];
+		const base = getBuiltinModel("abliteration", "abliterated-model");
+		const large = getBuiltinModel("abliteration", "abliterated-model-large");
+		const largeV2 = getBuiltinModel("abliteration", "abliterated-model-large-v2");
+		const flash = getBuiltinModel("abliteration", "abliterated-model-large-flash");
+		expect(getSupportedThinkingLevels(base)).toEqual(every);
+		expect(getSupportedThinkingLevels(large)).toEqual(every);
+		expect(getSupportedThinkingLevels(flash)).toEqual(every);
+		expect(getSupportedThinkingLevels(largeV2)).toEqual(every.slice(1));
+		expect(base.input).toEqual(["text", "image"]);
+		expect(flash.input).toEqual(["text", "image"]);
+		expect(large.input).toEqual(["text"]);
+		expect(largeV2.input).toEqual(["text"]);
+		expect(flash).toMatchObject({ contextWindow: 1048576, maxTokens: 262144, cost: { input: 1, output: 2 } });
+	});
+});
