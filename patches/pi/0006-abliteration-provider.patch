+import { openAICompletionsApi } from "../api/openai-completions.lazy.ts";
+import { envApiKeyAuth } from "../auth/helpers.ts";
+import { createProvider, type Provider } from "../models.ts";
+import type { Model } from "../types.ts";
+
+const PROVIDER_ID = "abliteration";
+const BASE_URL = "https://api.abliteration.ai/v1";
+
+const modelDefaults = {
+	provider: PROVIDER_ID,
+	baseUrl: BASE_URL,
+	api: "openai-completions" as const,
+	reasoning: true,
+	compat: {
+		supportsStore: false,
+		supportsReasoningEffort: true,
+		maxTokensField: "max_tokens" as const,
+		sendSessionAffinityHeaders: true,
+		supportsLongCacheRetention: false,
+	},
+};
+
+// Chat Completions accepts every effort from `none` to `max` on every model; Large v2 cannot turn reasoning off.
+const fullThinkingLevels = {
+	minimal: "minimal",
+	low: "low",
+	medium: "medium",
+	high: "high",
+	xhigh: "xhigh",
+	max: "max",
+} as const;
+
+// Provider limits and USD per million tokens: docs.abliteration.ai/models and GET /v1/models.
+export const ABLITERATION_MODELS = {
+	"abliterated-model": {
+		...modelDefaults,
+		id: "abliterated-model",
+		name: "Abliterated Model",
+		input: ["text", "image"],
+		inputLimits: {
+			images: {
+				resize: {
+					maxWidth: 2000,
+					maxHeight: 2000,
+					maxBytes: 4.5 * 1024 * 1024,
+					jpegQuality: 80,
+				},
+			},
+		},
+		contextWindow: 262144,
+		maxTokens: 262134,
+		thinkingLevelMap: { off: "none", ...fullThinkingLevels },
+		cost: { input: 1, output: 3, cacheRead: 0.1, cacheWrite: 1 },
+	},
+	"abliterated-model-large-flash": {
+		...modelDefaults,
+		id: "abliterated-model-large-flash",
+		name: "Abliterated Large Flash",
+		input: ["text", "image"],
+		inputLimits: {
+			images: {
+				resize: {
+					maxWidth: 2000,
+					maxHeight: 2000,
+					maxBytes: 4.5 * 1024 * 1024,
+					jpegQuality: 80,
+				},
+			},
+		},
+		contextWindow: 1048576,
+		maxTokens: 262144,
+		thinkingLevelMap: { off: "none", ...fullThinkingLevels },
+		cost: { input: 1, output: 2, cacheRead: 0.1, cacheWrite: 1 },
+	},
+	"abliterated-model-large-v2": {
+		...modelDefaults,
+		id: "abliterated-model-large-v2",
+		name: "Abliterated Large v2",
+		input: ["text"],
+		contextWindow: 1000000,
+		maxTokens: 999990,
+		thinkingLevelMap: { off: null, ...fullThinkingLevels },
+		cost: { input: 3, output: 5, cacheRead: 0.3, cacheWrite: 3 },
+	},
+	"abliterated-model-large": {
+		...modelDefaults,
+		id: "abliterated-model-large",
+		name: "Abliterated Large",
+		input: ["text"],
+		contextWindow: 1000000,
+		maxTokens: 999990,
+		thinkingLevelMap: { off: "none", ...fullThinkingLevels },
+		cost: { input: 3, output: 5, cacheRead: 0.3, cacheWrite: 3 },
+	},
+} satisfies Record<string, Model<"openai-completions">>;
+
+export function abliterationProvider(): Provider<"openai-completions"> {
+	return createProvider({
+		id: PROVIDER_ID,
+		name: "Abliteration",
+		baseUrl: BASE_URL,
+		auth: { apiKey: envApiKeyAuth("Abliteration API key", ["ABLIT_KEY"]) },
+		models: Object.values(ABLITERATION_MODELS),
+		api: openAICompletionsApi(),
+	});
+}
