diff --git a/packages/ai/test/transform-messages-image-limit.test.ts b/packages/ai/test/transform-messages-image-limit.test.ts
new file mode 100644
index 0000000..86957c3
--- /dev/null
+++ b/packages/ai/test/transform-messages-image-limit.test.ts
@@ -0,0 +1,113 @@
+import { describe, expect, it } from "vitest";
+import { transformMessages } from "../src/api/transform-messages.ts";
+import type { AssistantMessage, ImageContent, Message, Model } from "../src/types.ts";
+
+const vision: Model<"openai-completions"> = {
+	id: "vision-model",
+	name: "Vision Model",
+	api: "openai-completions",
+	provider: "test",
+	baseUrl: "https://example.invalid/v1",
+	reasoning: false,
+	input: ["text", "image"],
+	inputLimits: { images: { maxPerRequest: 4 } },
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+	contextWindow: 128000,
+	maxTokens: 8192,
+};
+
+const note = "(older image omitted: the model accepts at most 4 images per request)";
+
+function image(data: string): ImageContent {
+	return { type: "image", data, mimeType: "image/png" };
+}
+
+function readCall(id: string): AssistantMessage {
+	return {
+		role: "assistant",
+		content: [{ type: "toolCall", id, name: "read", arguments: { path: `${id}.png` } }],
+		api: "openai-completions",
+		provider: "test",
+		model: "vision-model",
+		usage: {
+			input: 0,
+			output: 0,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 0,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		stopReason: "toolUse",
+		timestamp: 0,
+	};
+}
+
+function readResult(id: string): Message {
+	return {
+		role: "toolResult",
+		toolCallId: id,
+		toolName: "read",
+		content: [{ type: "text", text: "Read image file [image/png]" }, image(id)],
+		isError: false,
+		timestamp: 0,
+	};
+}
+
+function imageData(messages: Message[]): string[] {
+	return messages.flatMap((msg) =>
+		(msg.role === "user" || msg.role === "toolResult") && Array.isArray(msg.content)
+			? msg.content.flatMap((block) => (block.type === "image" ? [block.data] : []))
+			: [],
+	);
+}
+
+describe("per-request image limit", () => {
+	it("keeps the newest images and notes each run of older ones", () => {
+		const messages: Message[] = [
+			{
+				role: "user",
+				content: [{ type: "text", text: "Compare these" }, image("u1"), image("u2"), image("u3")],
+				timestamp: 0,
+			},
+			readCall("r1"),
+			readResult("r1"),
+			readCall("r2"),
+			readResult("r2"),
+			{ role: "user", content: [image("u4"), image("u5")], timestamp: 0 },
+		];
+
+		const result = transformMessages(messages, vision);
+
+		expect(imageData(result)).toEqual(["r1", "r2", "u4", "u5"]);
+		expect(result[0].content).toEqual([
+			{ type: "text", text: "Compare these" },
+			{ type: "text", text: note },
+		]);
+		expect(messages[0].content).toHaveLength(4);
+	});
+
+	it("drops the oldest images within one message and leaves requests under the limit unchanged", () => {
+		const crowded: Message[] = [
+			{
+				role: "user",
+				content: [image("a"), image("b"), { type: "text", text: "and" }, image("c"), image("d"), image("e")],
+				timestamp: 0,
+			},
+		];
+		expect(transformMessages(crowded, vision)[0].content).toEqual([
+			{ type: "text", text: note },
+			image("b"),
+			{ type: "text", text: "and" },
+			image("c"),
+			image("d"),
+			image("e"),
+		]);
+
+		const within: Message[] = [
+			{ role: "user", content: [image("a"), image("b"), image("c"), image("d")], timestamp: 0 },
+		];
+		expect(transformMessages(within, vision)).toEqual(within);
+		const { inputLimits: _limits, ...unlimited } = vision;
+		expect(imageData(transformMessages(crowded, unlimited))).toEqual(["a", "b", "c", "d", "e"]);
+	});
+});
