+/**
+ * Keep the newest `inputLimits.images.maxPerRequest` images and replace each run of older ones with a
+ * note, so a long conversation does not exceed the provider's per-request image count.
+ */
+function limitImagesPerRequest<TApi extends Api>(messages: Message[], model: Model<TApi>): Message[] {
+	const maxPerRequest = model.inputLimits?.images?.maxPerRequest;
+	if (maxPerRequest === undefined) return messages;
+	const placeholder = `(older image omitted: the model accepts at most ${maxPerRequest} images per request)`;
+	let remaining = maxPerRequest;
+	const limited = [...messages];
+
+	for (let i = limited.length - 1; i >= 0; i--) {
+		const msg = limited[i];
+		if ((msg.role !== "user" && msg.role !== "toolResult") || !Array.isArray(msg.content)) continue;
+		const imageCount = msg.content.filter((block) => block.type === "image").length;
+		if (imageCount <= remaining) {
+			remaining -= imageCount;
+			continue;
+		}
+
+		let omitted = imageCount - remaining;
+		remaining = 0;
+		const content: (TextContent | ImageContent)[] = [];
+		let previousWasPlaceholder = false;
+		for (const block of msg.content) {
+			if (block.type === "image" && omitted > 0) {
+				omitted--;
+				if (!previousWasPlaceholder) content.push({ type: "text", text: placeholder });
+				previousWasPlaceholder = true;
+				continue;
+			}
+			content.push(block);
+			previousWasPlaceholder = false;
+		}
+		limited[i] = { ...msg, content };
+	}
+
+	return limited;
+}
