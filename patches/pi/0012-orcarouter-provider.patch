diff --git a/packages/ai/src/providers/orcarouter.ts b/packages/ai/src/providers/orcarouter.ts
new file mode 100644
index 000000000..5294f2137
--- /dev/null
+++ b/packages/ai/src/providers/orcarouter.ts
@@ -0,0 +1,57 @@
+import { openAICompletionsApi } from "../api/openai-completions.lazy.ts";
+import { envApiKeyAuth } from "../auth/helpers.ts";
+import { createProvider, type Provider } from "../models.ts";
+import type { Model } from "../types.ts";
+
+const PROVIDER_ID = "orcarouter";
+const BASE_URL = "https://api.orcarouter.ai/v1";
+
+// Limits and USD per million tokens: GET /v1/models. No cache write price is listed and `prompt_tokens` counts
+// written tokens, so writes cost the input price. The API also takes video, which has no Engine input type.
+export const ORCAROUTER_MODELS = {
+	"orca/orcacyber-k3.1-pro": {
+		id: "orca/orcacyber-k3.1-pro",
+		name: "Kimi K3.1 Pro Abliterated / Uncensored",
+		provider: PROVIDER_ID,
+		baseUrl: BASE_URL,
+		api: "openai-completions",
+		reasoning: true,
+		// OrcaRouter documents none, low, high and max. It answers 200 to any other value, even a made-up one, so the
+		// other levels would be controls that cannot be shown to do anything.
+		thinkingLevelMap: { off: "none", minimal: null, low: "low", medium: null, high: "high", xhigh: null, max: "max" },
+		input: ["text", "image"],
+		inputLimits: {
+			images: {
+				resize: {
+					maxWidth: 2000,
+					maxHeight: 2000,
+					maxBytes: 4.5 * 1024 * 1024,
+					jpegQuality: 80,
+				},
+			},
+		},
+		contextWindow: 1048576,
+		maxTokens: 943718,
+		cost: { input: 4, output: 20, cacheRead: 0.35, cacheWrite: 4 },
+		compat: {
+			supportsStore: false,
+			// A `developer` message fails with 400.
+			supportsDeveloperRole: false,
+			supportsReasoningEffort: true,
+			maxTokensField: "max_tokens",
+			supportsStrictMode: false,
+			supportsLongCacheRetention: false,
+		},
+	},
+} satisfies Record<string, Model<"openai-completions">>;
+
+export function orcarouterProvider(): Provider<"openai-completions"> {
+	return createProvider({
+		id: PROVIDER_ID,
+		name: "OrcaRouter",
+		baseUrl: BASE_URL,
+		auth: { apiKey: envApiKeyAuth("OrcaRouter API key", ["ORCAROUTER_API_KEY"]) },
+		models: Object.values(ORCAROUTER_MODELS),
+		api: openAICompletionsApi(),
+	});
+}
