diff --git a/packages/ai/test/orcarouter.test.ts b/packages/ai/test/orcarouter.test.ts
new file mode 100644
index 000000000..d7c44932e
--- /dev/null
+++ b/packages/ai/test/orcarouter.test.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it } from "vitest";
+import { findEnvKeys, getEnvApiKey } from "../src/env-api-keys.ts";
+import { clampThinkingLevel, getSupportedThinkingLevels } from "../src/models.ts";
+import { builtinModels, getBuiltinModel, getBuiltinModels, getBuiltinProviders } from "../src/providers/all.ts";
+
+const MODEL_ID = "orca/orcacyber-k3.1-pro";
+
+describe("OrcaRouter provider", () => {
+	it("offers native API-key login and shares the static and runtime catalog", async () => {
+		const models = builtinModels({
+			authContext: { env: async () => undefined, fileExists: async () => false },
+		});
+		const provider = models.getProviders().find((entry) => entry.id === "orcarouter");
+		expect(provider?.name).toBe("OrcaRouter");
+		expect(provider?.auth.oauth).toBeUndefined();
+		expect(await models.getAvailable("orcarouter")).toEqual([]);
+		const credential = await models.login("orcarouter", "api_key", {
+			prompt: async () => "test-orcarouter-key",
+			notify: () => {},
+		});
+		expect(credential).toEqual({ type: "api_key", key: "test-orcarouter-key" });
+		expect(getBuiltinProviders()).toContain("orcarouter");
+		expect(models.getModels("orcarouter")).toEqual(getBuiltinModels("orcarouter"));
+		expect((await models.getAvailable("orcarouter")).map((model) => model.id)).toEqual([MODEL_ID]);
+		await models.logout("orcarouter");
+		expect(await models.getAvailable("orcarouter")).toEqual([]);
+	});
+
+	it("resolves ORCAROUTER_API_KEY without another provider's credentials", async () => {
+		const environment = { ORCAROUTER_API_KEY: "test-orcarouter-key", OPENROUTER_API_KEY: "other-key" };
+		expect(findEnvKeys("orcarouter", environment)).toEqual(["ORCAROUTER_API_KEY"]);
+		expect(getEnvApiKey("orcarouter", environment)).toBe(environment.ORCAROUTER_API_KEY);
+		const models = builtinModels({
+			authContext: {
+				env: async (name) => environment[name as keyof typeof environment],
+				fileExists: async () => false,
+			},
+		});
+		expect((await models.getAuth("orcarouter"))?.auth.apiKey).toBe(environment.ORCAROUTER_API_KEY);
+	});
+
+	it("offers the documented efforts and moves a saved level to the next one up", () => {
+		const model = getBuiltinModel("orcarouter", MODEL_ID);
+		expect(getSupportedThinkingLevels(model)).toEqual(["off", "low", "high", "max"]);
+		expect(clampThinkingLevel(model, "minimal")).toBe("low");
+		expect(clampThinkingLevel(model, "medium")).toBe("high");
+		expect(clampThinkingLevel(model, "xhigh")).toBe("max");
+	});
+
+	it("declares the live limits, vision, prices and the request shape the API accepts", () => {
+		const model = getBuiltinModel("orcarouter", MODEL_ID);
+		expect(model).toMatchObject({
+			baseUrl: "https://api.orcarouter.ai/v1",
+			api: "openai-completions",
+			input: ["text", "image"],
+			contextWindow: 1048576,
+			maxTokens: 943718,
+			cost: { input: 4, output: 20, cacheRead: 0.35, cacheWrite: 4 },
+			compat: { supportsDeveloperRole: false, maxTokensField: "max_tokens" },
+		});
+	});
+});
