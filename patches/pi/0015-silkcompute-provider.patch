diff --git a/packages/ai/src/providers/silkcompute.ts b/packages/ai/src/providers/silkcompute.ts
new file mode 100644
index 0000000..087f549
--- /dev/null
+++ b/packages/ai/src/providers/silkcompute.ts
@@ -0,0 +1,97 @@
+import { openAICompletionsApi } from "../api/openai-completions.lazy.ts";
+import { envApiKeyAuth } from "../auth/helpers.ts";
+import { createProvider, type Provider } from "../models.ts";
+import type { Model, ModelInputModality } from "../types.ts";
+
+const PROVIDER_ID = "silkcompute";
+const BASE_URL = "https://api.silkcompute.com/v1";
+// The conservative profile every vision model shares; SilkCompute documents only the request cap.
+const IMAGE_RESIZE = { maxWidth: 2000, maxHeight: 2000, maxBytes: 4.5 * 1024 * 1024, jpegQuality: 80 };
+const MAX_REQUEST_BYTES = 64 * 1024 * 1024;
+
+/**
+ * One of SilkCompute's abliterated models. Limits come from GET /v1/models, USD per million tokens from
+ * silkcompute.com/models. No cache write price is listed and `prompt_tokens` counts written tokens, so writes
+ * cost the input price.
+ */
+function silkComputeModel(
+	id: string,
+	name: string,
+	input: ModelInputModality[],
+	maxTokens: number,
+	cost: { input: number; output: number; cacheRead: number },
+): Model<"openai-completions"> {
+	return {
+		id,
+		name,
+		provider: PROVIDER_ID,
+		baseUrl: BASE_URL,
+		api: "openai-completions",
+		reasoning: true,
+		// SilkCompute documents none, low, high and max, and answers minimal, medium and xhigh as their neighbours,
+		// so those levels would repeat one. `none` stops every model from reasoning.
+		thinkingLevelMap: { off: "none", minimal: null, low: "low", medium: null, high: "high", xhigh: null, max: "max" },
+		input,
+		inputLimits: {
+			maxRequestBytes: MAX_REQUEST_BYTES,
+			...(input.includes("image") ? { images: { resize: IMAGE_RESIZE } } : {}),
+		},
+		contextWindow: 1048576,
+		maxTokens,
+		cost: { ...cost, cacheWrite: cost.input },
+		compat: {
+			supportsStore: false,
+			supportsDeveloperRole: false,
+			supportsReasoningEffort: true,
+			maxTokensField: "max_tokens",
+			supportsStrictMode: false,
+			supportsLongCacheRetention: false,
+		},
+	};
+}
+
+export const SILKCOMPUTE_MODELS = {
+	"kimi-k3.1-pro-uncensored": silkComputeModel(
+		"kimi-k3.1-pro-uncensored",
+		"Kimi K3.1 Pro Uncensored",
+		["text", "image"],
+		131072,
+		{ input: 5, output: 15, cacheRead: 0.5 },
+	),
+	"deepseek-v4.1-flash-1017-uncensored": silkComputeModel(
+		"deepseek-v4.1-flash-1017-uncensored",
+		"DeepSeek V4.1 Flash 1017 Uncensored",
+		["text", "image"],
+		131072,
+		{ input: 0.26, output: 0.9, cacheRead: 0.06 },
+	),
+	// The API takes images but GLM-5.3 answers that it cannot see them, so only text is declared.
+	"glm-5.3-uncensored": silkComputeModel("glm-5.3-uncensored", "GLM-5.3 Uncensored", ["text"], 131072, {
+		input: 2,
+		output: 4,
+		cacheRead: 0.3,
+	}),
+	"glm-5.3-flash-uncensored": silkComputeModel(
+		"glm-5.3-flash-uncensored",
+		"GLM-5.3 Flash Uncensored",
+		["text", "image"],
+		131072,
+		{ input: 0.24, output: 1, cacheRead: 0.06 },
+	),
+	"hy4-uncensored": silkComputeModel("hy4-uncensored", "Hy4 Uncensored", ["text", "image"], 65536, {
+		input: 1.6,
+		output: 3.2,
+		cacheRead: 0.3,
+	}),
+} satisfies Record<string, Model<"openai-completions">>;
+
+export function silkComputeProvider(): Provider<"openai-completions"> {
+	return createProvider({
+		id: PROVIDER_ID,
+		name: "SilkCompute",
+		baseUrl: BASE_URL,
+		auth: { apiKey: envApiKeyAuth("SilkCompute API key", ["SILK_API_KEY"]) },
+		models: Object.values(SILKCOMPUTE_MODELS),
+		api: openAICompletionsApi(),
+	});
+}
