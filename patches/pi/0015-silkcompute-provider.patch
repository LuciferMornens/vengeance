diff --git a/packages/ai/test/silkcompute.test.ts b/packages/ai/test/silkcompute.test.ts
new file mode 100644
index 0000000..d5766e2
--- /dev/null
+++ b/packages/ai/test/silkcompute.test.ts
@@ -0,0 +1,105 @@
+import { describe, expect, it } from "vitest";
+import { findEnvKeys, getEnvApiKey } from "../src/env-api-keys.ts";
+import { clampThinkingLevel, getSupportedThinkingLevels } from "../src/models.ts";
+import { builtinModels, getBuiltinModel, getBuiltinModels, getBuiltinProviders } from "../src/providers/all.ts";
+
+const MODEL_IDS = [
+	"kimi-k3.1-pro-uncensored",
+	"deepseek-v4.1-flash-1017-uncensored",
+	"glm-5.3-uncensored",
+	"glm-5.3-flash-uncensored",
+	"hy4-uncensored",
+] as const;
+
+describe("SilkCompute provider", () => {
+	it("offers native API-key login and shares the static and runtime catalog", async () => {
+		const models = builtinModels({
+			authContext: { env: async () => undefined, fileExists: async () => false },
+		});
+		const provider = models.getProviders().find((entry) => entry.id === "silkcompute");
+		expect(provider?.name).toBe("SilkCompute");
+		expect(provider?.auth.oauth).toBeUndefined();
+		expect(await models.getAvailable("silkcompute")).toEqual([]);
+		const credential = await models.login("silkcompute", "api_key", {
+			prompt: async () => "test-silkcompute-key",
+			notify: () => {},
+		});
+		expect(credential).toEqual({ type: "api_key", key: "test-silkcompute-key" });
+		expect(getBuiltinProviders()).toContain("silkcompute");
+		expect(models.getModels("silkcompute")).toEqual(getBuiltinModels("silkcompute"));
+		expect((await models.getAvailable("silkcompute")).map((model) => model.id)).toEqual([...MODEL_IDS]);
+		await models.logout("silkcompute");
+		expect(await models.getAvailable("silkcompute")).toEqual([]);
+	});
+
+	it("resolves SILK_API_KEY without another provider's credentials", async () => {
+		const environment = { SILK_API_KEY: "test-silkcompute-key", ORCAROUTER_API_KEY: "other-key" };
+		expect(findEnvKeys("silkcompute", environment)).toEqual(["SILK_API_KEY"]);
+		expect(getEnvApiKey("silkcompute", environment)).toBe(environment.SILK_API_KEY);
+		const models = builtinModels({
+			authContext: {
+				env: async (name) => environment[name as keyof typeof environment],
+				fileExists: async () => false,
+			},
+		});
+		expect((await models.getAuth("silkcompute"))?.auth.apiKey).toBe(environment.SILK_API_KEY);
+	});
+
+	it("offers Off and the documented efforts and moves a saved in-between level up", () => {
+		for (const id of MODEL_IDS) {
+			const model = getBuiltinModel("silkcompute", id);
+			expect(getSupportedThinkingLevels(model)).toEqual(["off", "low", "high", "max"]);
+			expect(model.thinkingLevelMap?.off).toBe("none");
+			expect(clampThinkingLevel(model, "minimal")).toBe("low");
+			expect(clampThinkingLevel(model, "medium")).toBe("high");
+			expect(clampThinkingLevel(model, "xhigh")).toBe("max");
+		}
+	});
+
+	it("declares the live limits, inputs, prices and the request shape the API accepts", () => {
+		const expected: Record<(typeof MODEL_IDS)[number], object> = {
+			"kimi-k3.1-pro-uncensored": {
+				input: ["text", "image"],
+				maxTokens: 131072,
+				cost: { input: 5, output: 15, cacheRead: 0.5, cacheWrite: 5 },
+			},
+			"deepseek-v4.1-flash-1017-uncensored": {
+				input: ["text", "image"],
+				maxTokens: 131072,
+				cost: { input: 0.26, output: 0.9, cacheRead: 0.06, cacheWrite: 0.26 },
+			},
+			"glm-5.3-uncensored": {
+				input: ["text"],
+				maxTokens: 131072,
+				cost: { input: 2, output: 4, cacheRead: 0.3, cacheWrite: 2 },
+			},
+			"glm-5.3-flash-uncensored": {
+				input: ["text", "image"],
+				maxTokens: 131072,
+				cost: { input: 0.24, output: 1, cacheRead: 0.06, cacheWrite: 0.24 },
+			},
+			"hy4-uncensored": {
+				input: ["text", "image"],
+				maxTokens: 65536,
+				cost: { input: 1.6, output: 3.2, cacheRead: 0.3, cacheWrite: 1.6 },
+			},
+		};
+		const resize = { maxWidth: 2000, maxHeight: 2000, maxBytes: 4.5 * 1024 * 1024, jpegQuality: 80 };
+		for (const id of MODEL_IDS) {
+			const model = getBuiltinModel("silkcompute", id);
+			expect(model.inputLimits).toEqual(
+				model.input.includes("image")
+					? { maxRequestBytes: 64 * 1024 * 1024, images: { resize } }
+					: { maxRequestBytes: 64 * 1024 * 1024 },
+			);
+			expect(model).toMatchObject({
+				baseUrl: "https://api.silkcompute.com/v1",
+				api: "openai-completions",
+				reasoning: true,
+				contextWindow: 1048576,
+				...expected[id],
+				compat: { supportsDeveloperRole: false, supportsStore: false, maxTokensField: "max_tokens" },
+			});
+		}
+	});
+});
