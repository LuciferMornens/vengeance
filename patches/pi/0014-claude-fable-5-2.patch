diff --git a/packages/ai/test/anthropic-fable-5-2.test.ts b/packages/ai/test/anthropic-fable-5-2.test.ts
new file mode 100644
index 0000000..24435c1
--- /dev/null
+++ b/packages/ai/test/anthropic-fable-5-2.test.ts
@@ -0,0 +1,68 @@
+import { createServer, type IncomingHttpHeaders } from "node:http";
+import type { AddressInfo } from "node:net";
+import { describe, expect, it } from "vitest";
+import { stream } from "../src/api/anthropic-messages.ts";
+import { builtinModels, getBuiltinModel } from "../src/providers/all.ts";
+import { normalizeContext } from "../src/utils/transcript.ts";
+
+// The subscription answers "Claude Code 2.1.280 does not support this model; version 2.1.290 or newer is
+// required" (claude_code_version_too_old) to a Fable 5.2 request from an older Claude Code identity.
+const MINIMUM_FABLE_5_2_CLAUDE_CODE = [2, 1, 290];
+
+async function oauthRequestHeaders(): Promise<IncomingHttpHeaders> {
+	let headers: IncomingHttpHeaders | undefined;
+	const server = createServer((request, response) => {
+		headers = request.headers;
+		request.resume();
+		response.writeHead(400, { "content-type": "application/json" });
+		response.end(JSON.stringify({ type: "error", error: { type: "invalid_request_error", message: "captured" } }));
+	});
+	await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+	try {
+		const { port } = server.address() as AddressInfo;
+		const model = { ...getBuiltinModel("anthropic", "claude-fable-5-2"), baseUrl: `http://127.0.0.1:${port}` };
+		const context = normalizeContext({ messages: [{ role: "user", content: "Hello", timestamp: 1 }] });
+		await stream(model, context, { apiKey: "sk-ant-oat01-test", cacheRetention: "none" }).result();
+	} finally {
+		await new Promise<void>((resolve) => server.close(() => resolve()));
+	}
+	if (!headers) throw new Error("Expected the OAuth request to reach the server");
+	return headers;
+}
+
+describe("Claude Fable 5.2", () => {
+	it("is listed like Fable 5.1 at its own prices, with Claude Opus 5 as its only fallback", () => {
+		const model = getBuiltinModel("anthropic", "claude-fable-5-2");
+		const fable51 = getBuiltinModel("anthropic", "claude-fable-5-1");
+		expect(model).toMatchObject({
+			name: "Claude Fable 5.2",
+			reasoning: true,
+			input: ["text", "image"],
+			contextWindow: 1000000,
+			maxTokens: 128000,
+			cost: { input: 8, output: 40, cacheRead: 0.2, cacheWrite: 10 },
+			thinkingLevelMap: fable51.thinkingLevelMap,
+			promptCache: fable51.promptCache,
+			inputLimits: fable51.inputLimits,
+		});
+		expect(model.compat).toEqual({
+			...fable51.compat,
+			allowedFallbackModels: [
+				{ provider: "anthropic", model: "claude-opus-5", cost: getBuiltinModel("anthropic", "claude-opus-5").cost },
+			],
+		});
+	});
+
+	it("is offered by the runtime Anthropic provider", () => {
+		const models = builtinModels({ authContext: { env: async () => undefined, fileExists: async () => false } });
+		expect(models.getModels("anthropic").map((model) => model.id)).toContain("claude-fable-5-2");
+	});
+
+	it("identifies subscription requests as a Claude Code release that serves Fable 5.2", async () => {
+		const userAgent = (await oauthRequestHeaders())["user-agent"] ?? "";
+		const version = /^claude-cli\/(\d+)\.(\d+)\.(\d+)/.exec(userAgent)?.slice(1).map(Number);
+		expect(version, userAgent).toBeDefined();
+		const order = (version ?? []).map((part, index) => part - MINIMUM_FABLE_5_2_CLAUDE_CODE[index]).find(Boolean);
+		expect(order ?? 0, userAgent).toBeGreaterThanOrEqual(0);
+	});
+});
