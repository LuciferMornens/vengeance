diff --git a/crates/pa-core/src/kernel/bootstrap/venv/bundled_wheels.rs b/crates/pa-core/src/kernel/bootstrap/venv/bundled_wheels.rs
new file mode 100644
index 000000000..6ad07b0ad
--- /dev/null
+++ b/crates/pa-core/src/kernel/bootstrap/venv/bundled_wheels.rs
@@ -0,0 +1,191 @@
+use std::path::{Path, PathBuf};
+
+use anyhow::{bail, Context};
+use serde::Deserialize;
+use sha2::Digest;
+
+use super::runtime_source::{packaged_runtime_dir, require_runtime_source_dir};
+
+const WHEEL_MANIFEST_SCHEMA: u32 = 1;
+const WHEEL_PLATFORM: &str = "darwin-x64";
+const WHEEL_DISTRIBUTION: &str = "cryptography";
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct WheelManifest {
+    schema_version: u32,
+    platform: String,
+    wheels: Vec<BundledWheel>,
+}
+
+#[derive(Deserialize)]
+struct BundledWheel {
+    distribution: String,
+    version: String,
+    file: String,
+    sha256: String,
+}
+
+pub(in crate::kernel::bootstrap) fn runtime_wheel_requirement() -> anyhow::Result<Option<PathBuf>> {
+    if !cfg!(all(target_os = "macos", target_arch = "x86_64"))
+        || option_env!("VENGEANCE_ENGINE_BUILD").is_none()
+    {
+        return Ok(None);
+    }
+    let source_dir = require_runtime_source_dir()
+        .context("cannot find the bundled Python runtime; reinstall Vengeance")?;
+    // Native source-checkout bootstraps use upstream's developer dependency resolution.
+    // Runtime sources resolve to canonical paths, so the checkout candidate is canonicalized too.
+    if crate::packages::source_checkout_root()
+        .and_then(|root| root.join("prime-agent-runtime").canonicalize().ok())
+        .is_some_and(|checkout| source_dir == checkout)
+        || packaged_runtime_dir().as_deref() != Some(source_dir.as_path())
+    {
+        return Ok(None);
+    }
+    packaged_wheel_requirement(&source_dir).map(Some)
+}
+
+fn packaged_wheel_requirement(runtime_dir: &Path) -> anyhow::Result<PathBuf> {
+    let wheels_dir = runtime_dir.join("wheels");
+    let manifest_path = wheels_dir.join("manifest.json");
+    let manifest_bytes = std::fs::read(&manifest_path).with_context(|| {
+        format!(
+            "cannot read bundled Python wheel manifest at {}; reinstall Vengeance",
+            manifest_path.display()
+        )
+    })?;
+    let manifest: WheelManifest = serde_json::from_slice(&manifest_bytes).with_context(|| {
+        format!(
+            "invalid Python wheel manifest at {}",
+            manifest_path.display()
+        )
+    })?;
+    if manifest.schema_version != WHEEL_MANIFEST_SCHEMA || manifest.platform != WHEEL_PLATFORM {
+        bail!(
+            "unsupported bundled Python wheel manifest at {}",
+            manifest_path.display()
+        );
+    }
+    let [wheel] = manifest.wheels.as_slice() else {
+        bail!("bundled Python wheel manifest must contain one cryptography wheel");
+    };
+    let filename_prefix = format!("{WHEEL_DISTRIBUTION}-{}-", wheel.version);
+    if wheel.distribution != WHEEL_DISTRIBUTION
+        || wheel.version.is_empty()
+        || !wheel.file.starts_with(&filename_prefix)
+        || !Path::new(&wheel.file)
+            .extension()
+            .is_some_and(|extension| extension.eq_ignore_ascii_case("whl"))
+        || !wheel
+            .file
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.'))
+    {
+        bail!(
+            "invalid bundled cryptography wheel filename or version: {}",
+            wheel.file
+        );
+    }
+    let wheel_path = wheels_dir.join(&wheel.file);
+    let wheel_bytes = std::fs::read(&wheel_path).with_context(|| {
+        format!(
+            "cannot read bundled Python wheel at {}",
+            wheel_path.display()
+        )
+    })?;
+    let actual_sha256 = format!("{:x}", sha2::Sha256::digest(&wheel_bytes));
+    if actual_sha256 != wheel.sha256 {
+        bail!(
+            "bundled Python wheel checksum mismatch at {}; reinstall Vengeance",
+            wheel_path.display()
+        );
+    }
+    Ok(wheel_path)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const WHEEL_VERSION: &str = "50.0.2";
+    const WHEEL_FILE: &str = "cryptography-50.0.2-cp39-abi3-macosx_13_0_x86_64.whl";
+    const WHEEL_BYTES: &[u8] = b"bundled cryptography wheel fixture";
+
+    fn write_manifest(runtime_dir: &Path, filename: &str, platform: &str) -> anyhow::Result<()> {
+        let manifest = serde_json::json!({
+            "schemaVersion": WHEEL_MANIFEST_SCHEMA,
+            "platform": platform,
+            "wheels": [{
+                "distribution": WHEEL_DISTRIBUTION,
+                "version": WHEEL_VERSION,
+                "file": filename,
+                "sha256": format!("{:x}", sha2::Sha256::digest(WHEEL_BYTES)),
+            }],
+        });
+        std::fs::create_dir_all(runtime_dir.join("wheels"))?;
+        std::fs::write(
+            runtime_dir.join("wheels").join("manifest.json"),
+            serde_json::to_vec(&manifest)?,
+        )?;
+        Ok(())
+    }
+
+    #[test]
+    fn packaged_wheel_resolves_to_its_verified_local_file() -> anyhow::Result<()> {
+        let temp = tempfile::tempdir()?;
+        write_manifest(temp.path(), WHEEL_FILE, WHEEL_PLATFORM)?;
+        let wheel = temp.path().join("wheels").join(WHEEL_FILE);
+        std::fs::write(&wheel, WHEEL_BYTES)?;
+        assert_eq!(packaged_wheel_requirement(temp.path())?, wheel);
+        Ok(())
+    }
+
+    #[test]
+    fn missing_manifest_or_wheel_fails_closed() -> anyhow::Result<()> {
+        let temp = tempfile::tempdir()?;
+        let missing_manifest = packaged_wheel_requirement(temp.path()).unwrap_err();
+        assert!(missing_manifest.to_string().contains("wheel manifest"));
+
+        write_manifest(temp.path(), WHEEL_FILE, WHEEL_PLATFORM)?;
+        let missing_wheel = packaged_wheel_requirement(temp.path()).unwrap_err();
+        assert!(missing_wheel
+            .to_string()
+            .contains("cannot read bundled Python wheel at"));
+        Ok(())
+    }
+
+    #[test]
+    fn corrupt_wheel_fails_before_installation() -> anyhow::Result<()> {
+        let temp = tempfile::tempdir()?;
+        write_manifest(temp.path(), WHEEL_FILE, WHEEL_PLATFORM)?;
+        std::fs::write(
+            temp.path().join("wheels").join(WHEEL_FILE),
+            b"corrupt wheel",
+        )?;
+        let error = packaged_wheel_requirement(temp.path()).unwrap_err();
+        assert!(error.to_string().contains("checksum mismatch"));
+        Ok(())
+    }
+
+    #[test]
+    fn manifest_rejects_foreign_platform_and_unsafe_or_mismatched_filenames() -> anyhow::Result<()>
+    {
+        let temp = tempfile::tempdir()?;
+        write_manifest(temp.path(), WHEEL_FILE, "darwin-arm64")?;
+        let platform_error = packaged_wheel_requirement(temp.path()).unwrap_err();
+        assert!(platform_error.to_string().contains("unsupported"));
+
+        for filename in [
+            "../cryptography-50.0.2-cp39-abi3-macosx_13_0_x86_64.whl",
+            "cryptography-50.0.2-../../outside.whl",
+            "cryptography-50.0.2-..\\outside.whl",
+            "cryptography-49.0.0-cp39-abi3-macosx_13_0_x86_64.whl",
+        ] {
+            write_manifest(temp.path(), filename, WHEEL_PLATFORM)?;
+            let error = packaged_wheel_requirement(temp.path()).unwrap_err();
+            assert!(error.to_string().contains("filename or version"));
+        }
+        Ok(())
+    }
+}
