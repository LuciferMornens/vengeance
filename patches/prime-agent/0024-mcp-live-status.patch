diff --git a/crates/pa-daemon/src/mcp_status.rs b/crates/pa-daemon/src/mcp_status.rs
new file mode 100644
index 000000000..0797d52cb
--- /dev/null
+++ b/crates/pa-daemon/src/mcp_status.rs
@@ -0,0 +1,239 @@
+//! The worker arms behind the live MCP status lane: `get_mcp_status` (each
+//! of the session's MCP servers as the session kernel sees it right now —
+//! its tools or its error) and `reconnect_mcp_server` (close one server's
+//! kernel connection and list it again). Both read the session's running
+//! kernel only — no session build, no kernel start — so a session without
+//! one answers `kernelRunning: false` with no servers. The `/mcp` roster
+//! (`get_mcp_connections`) stays the config and credential view.
+//!
+//! Through the supervisor, wrong types (a non-array `servers`, a
+//! non-string name, a negative or fractional `timeoutMs`, no `server`)
+//! fail its typed parse as `malformed <command> command`; an empty
+//! `server` passes it and gets "requires a server" on either path.
+
+use pa_core::session_engine::mcp_status::{McpLiveStatus, McpStatusServers};
+use serde_json::{json, Value};
+
+use crate::protocol::{response_failure, response_success, DaemonResponse};
+use crate::worker::Worker;
+
+/// The per-server open bound when the request names none.
+const DEFAULT_PER_SERVER_TIMEOUT_MS: u64 = 10_000;
+/// The largest per-server open bound a request may ask for. The kernel
+/// settles a listing within this bound plus its 5s serve margin plus 3.5s
+/// per reloaded server (28.5s for a reconnect at the cap), which keeps the
+/// worker's answer inside the supervisor's 30s route timeout for these
+/// short control routes.
+const MAX_PER_SERVER_TIMEOUT_MS: u64 = 20_000;
+
+/// The request's per-server bound: `timeoutMs` clamped to `1..=20000`, or
+/// the default when absent.
+fn per_server_timeout_ms(payload: &Value) -> Result<u64, &'static str> {
+    match payload.get("timeoutMs") {
+        None | Some(Value::Null) => Ok(DEFAULT_PER_SERVER_TIMEOUT_MS),
+        Some(value) => value
+            .as_u64()
+            .map(|timeout_ms| timeout_ms.clamp(1, MAX_PER_SERVER_TIMEOUT_MS))
+            .ok_or("timeoutMs must be a non-negative integer"),
+    }
+}
+
+/// The lane's response: `{kernelRunning, servers}`, or the failure.
+fn status_response(command: &str, status: anyhow::Result<McpLiveStatus>) -> DaemonResponse {
+    match status {
+        Ok(status) => response_success(
+            None,
+            command,
+            Some(json!({
+                "kernelRunning": status.kernel_running,
+                "servers": status.servers,
+            })),
+        ),
+        Err(error) => response_failure(None, command, &format!("{error:#}"), None),
+    }
+}
+
+impl Worker {
+    /// `get_mcp_status { servers?, timeoutMs? }`: the named servers (absent:
+    /// every generic server the session enabled), each with its live tools
+    /// or its error; a name the session did not enable reports that error
+    /// without a kernel round-trip.
+    pub(crate) async fn handle_get_mcp_status(&self, payload: &Value) -> DaemonResponse {
+        if let Err(response) = self.require_created("get_mcp_status") {
+            return response;
+        }
+        let servers = match payload.get("servers") {
+            None | Some(Value::Null) => McpStatusServers::Enabled,
+            Some(value) => {
+                let names = value.as_array().and_then(|names| {
+                    names
+                        .iter()
+                        .map(|name| name.as_str().map(str::to_string))
+                        .collect::<Option<Vec<_>>>()
+                });
+                let Some(names) = names else {
+                    return response_failure(
+                        None,
+                        "get_mcp_status",
+                        "servers must be an array of server names",
+                        None,
+                    );
+                };
+                McpStatusServers::Named(names)
+            }
+        };
+        let timeout_ms = match per_server_timeout_ms(payload) {
+            Ok(timeout_ms) => timeout_ms,
+            Err(message) => return response_failure(None, "get_mcp_status", message, None),
+        };
+        let status = match &self.agent_engine {
+            Some(engine) => engine.mcp_status(servers, timeout_ms).await,
+            // The scripted engine hosts no kernel.
+            None => Ok(McpLiveStatus::kernel_not_running()),
+        };
+        status_response("get_mcp_status", status)
+    }
+
+    /// `reconnect_mcp_server { server, timeoutMs? }`: the kernel closes the
+    /// server's open connection and lists it again (exactly that server's
+    /// entry); with a running kernel, a server the session did not enable
+    /// fails the command (without one, every name answers
+    /// `kernelRunning: false`).
+    pub(crate) async fn handle_reconnect_mcp_server(&self, payload: &Value) -> DaemonResponse {
+        if let Err(response) = self.require_created("reconnect_mcp_server") {
+            return response;
+        }
+        let Some(server) = payload
+            .get("server")
+            .and_then(Value::as_str)
+            .filter(|server| !server.is_empty())
+        else {
+            return response_failure(
+                None,
+                "reconnect_mcp_server",
+                "reconnect_mcp_server requires a server",
+                None,
+            );
+        };
+        let timeout_ms = match per_server_timeout_ms(payload) {
+            Ok(timeout_ms) => timeout_ms,
+            Err(message) => return response_failure(None, "reconnect_mcp_server", message, None),
+        };
+        let status = match &self.agent_engine {
