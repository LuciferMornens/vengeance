diff --git a/crates/pa-core/tests/kernel_mcp_reconnect.rs b/crates/pa-core/tests/kernel_mcp_reconnect.rs
new file mode 100644
index 000000000..eeb5dec43
--- /dev/null
+++ b/crates/pa-core/tests/kernel_mcp_reconnect.rs
@@ -0,0 +1,240 @@
+// Pedantic-gate dispositions as src/lib.rs (large_futures/too_many_lines).
+#![allow(clippy::large_futures, clippy::too_many_lines)]
+
+//! Verifier for the live MCP status lane against a REAL kernel: the lane
+//! never starts a kernel, a plain listing reuses the kernel's open
+//! connection (the cached generation), a name the session never enabled
+//! reports its error without a kernel round-trip, a reconnect closes the
+//! connection and reopens it — the fixture server spawns again — and a
+//! request the runtime fails reports the runtime's reason.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use pa_agent::scripted::ScriptedProvider;
+use pa_core::session_engine::engine::{create_session, SessionEngineConfig};
+use pa_core::session_engine::mcp_status::{McpLiveStatus, McpStatusServers};
+use serde_json::json;
+
+/// The kernel Python with prime-agent-runtime installed (the interpreter
+/// the session-path provisioner resolves; the fixture server runs on it
+/// too, for its `mcp` package). Skipped (with a note) on machines without
+/// a live install; set `PA_CORE_KERNEL_PYTHON` to point at an explicit
+/// interpreter instead.
+fn kernel_python() -> Option<PathBuf> {
+    if let Some(explicit) = std::env::var_os("PA_CORE_KERNEL_PYTHON") {
+        let explicit = PathBuf::from(explicit);
+        assert!(
+            explicit.exists(),
+            "PA_CORE_KERNEL_PYTHON {} not found",
+            explicit.display()
+        );
+        return Some(explicit);
+    }
+    let candidate = PathBuf::from(std::env::var("HOME").map_or_else(
+        |_| "/home/ubuntu/.prime/agent/kernel-venv/bin/python".to_string(),
+        |home| format!("{home}/.prime/agent/kernel-venv/bin/python"),
+    ));
+    if candidate.exists() {
+        return Some(candidate);
+    }
+    eprintln!(
+        "kernel python {} not found; skipping live MCP reconnect test",
+        candidate.display()
+    );
+    None
+}
+
+/// The stdio MCP fixture: every process start appends one line to the
+/// spawn log (`argv[1]`), then serves one echo tool.
+const RECONNECT_FIXTURE_SERVER: &str = r#"import sys
+from pathlib import Path
+
+with Path(sys.argv[1]).open("a", encoding="utf-8") as spawns:
+    spawns.write("spawn\n")
+
+from mcp.server.mcpserver import MCPServer
+
+server = MCPServer("reconnect-fixture")
+
+
+@server.tool()
+def echo(text: str) -> str:
+    """Echo the text back."""
+    return text
+
+
+server.run()
+"#;
+
+/// How many times the fixture server process started.
+fn spawn_count(spawn_log: &Path) -> usize {
+    std::fs::read_to_string(spawn_log).map_or(0, |log| log.lines().count())
+}
+
+#[tokio::test]
+async fn a_reconnect_reopens_the_kernel_connection_a_listing_reuses() {
+    let Some(kernel_python) = kernel_python() else {
+        return;
+    };
+    let dir = tempfile::tempdir().expect("temp dir");
+    let agent_dir = dir.path().join("agent");
+    let cwd = dir.path().join("project");
+    std::fs::create_dir_all(&agent_dir).expect("agent dir");
+    std::fs::create_dir_all(&cwd).expect("cwd");
+    let spawn_log = dir.path().join("reconnect-fixture-spawns");
+    let server_script = dir.path().join("reconnect_fixture_server.py");
+    std::fs::write(&server_script, RECONNECT_FIXTURE_SERVER).expect("server script");
+    // The user-declared stdio server: the session's one enabled generic
+    // server, resolved by the kernel through the `mcp.config` host request.
+    std::fs::write(
+        agent_dir.join("settings.json"),
+        json!({
+            "mcpServers": {
+                "reconnect-fixture": {
+                    "type": "stdio",
+                    "command": kernel_python.display().to_string(),
+                    "args": [
+                        server_script.display().to_string(),
+                        spawn_log.display().to_string(),
+                    ],
+                },
+            },
+        })
+        .to_string(),
+    )
+    .expect("settings");
+    // Hermeticity: the kernel runs on the same interpreter (no bootstrap)
+    // and no ambient agent dir leaks in. This test binary holds this one
+    // test, so the process env is its own.
+    std::env::set_var("PRIME_AGENT_KERNEL_PYTHON", &kernel_python);
+    std::env::remove_var("PRIME_AGENT_CODING_AGENT_DIR");
+
+    let model: pa_agent::types::Model = serde_json::from_value(json!({
+        "id": "faux-1", "name": "Faux", "api": "test", "provider": "faux",
+        "baseUrl": "http://localhost", "reasoning": false,
+        "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
+        "contextWindow": 200_000, "maxTokens": 4_000
+    }))
+    .expect("faux loop model");
+    let provider = Arc::new(ScriptedProvider::new(model.clone()));
+    let engine = create_session(SessionEngineConfig {
+        cwd,
+        agent_dir,
+        model: Some(model),
+        stream_fn: Some(provider.stream_fn()),
+        tools: Vec::new(),
+        ..Default::default()
+    })
+    .await
+    .expect("create the session");
+    let provisioner = engine
+        .kernel_provisioner_weak()
+        .upgrade()
+        .expect("the session carries its kernel provisioner");
+
+    // No kernel yet: the lane answers without starting one.
+    assert_eq!(
+        engine
+            .mcp_status(McpStatusServers::Enabled, 30_000)
+            .await
+            .expect("status without a kernel"),
+        McpLiveStatus::kernel_not_running()
+    );
+    assert!(
+        !provisioner.has_running_kernel(),
+        "the status lane must never start the kernel"
+    );
+    provisioner
+        .ensure(None, None)
+        .await
+        .expect("boot the kernel");
+
+    let listed = json!({
+        "server": "reconnect-fixture",
+        "tools": [{ "name": "echo", "description": "Echo the text back." }],
+        "error": null,
+    });
+    // The first listing opens the server.
+    assert_eq!(
+        engine
+            .mcp_status(McpStatusServers::Enabled, 30_000)
+            .await
+            .expect("first listing"),
+        McpLiveStatus {
+            kernel_running: true,
+            servers: vec![listed.clone()],
+        }
+    );
+    assert_eq!(spawn_count(&spawn_log), 1, "the listing opens the server");
+
+    // A plain listing reuses the open connection, in request order; the
+    // name the session never enabled reports without reaching the kernel.
+    assert_eq!(
+        engine
+            .mcp_status(
+                McpStatusServers::Named(
+                    vec!["ghost".to_string(), "reconnect-fixture".to_string(),]
+                ),
+                30_000,
+            )
+            .await
+            .expect("cached listing"),
+        McpLiveStatus {
+            kernel_running: true,
+            servers: vec![
+                json!({
+                    "server": "ghost",
+                    "tools": null,
+                    "error": "MCP server ghost is not enabled in this session",
+                }),
+                listed.clone(),
+            ],
+        }
+    );
+    assert_eq!(
+        spawn_count(&spawn_log),
+        1,
+        "a plain listing reuses the open connection"
+    );
+
+    // The reconnect closes the kernel's connection and lists it again: the
+    // server process starts anew and reports the same tools.
+    assert_eq!(
+        engine
+            .reconnect_mcp_server("reconnect-fixture", 30_000)
+            .await
+            .expect("reconnect"),
+        McpLiveStatus {
+            kernel_running: true,
+            servers: vec![listed],
+        }
+    );
+    assert_eq!(
+        spawn_count(&spawn_log),
+        2,
+        "the reconnect reopens the server"
+    );
+    assert_eq!(
+        engine
+            .reconnect_mcp_server("ghost", 30_000)
+            .await
+            .expect_err("a server the session never enabled")
+            .to_string(),
+        "MCP server ghost is not enabled in this session"
+    );
+
+    // A request the runtime fails (its reload name check) carries the
+    // runtime's reason through the lane's done frame.
+    assert_eq!(
+        provisioner
+            .manager()
+            .expect("the running kernel")
+            .mcp_status_listing(&[], 30_000, &[String::new()])
+            .await
+            .expect_err("an empty reload name")
+            .to_string(),
+        "MCP status listing failed: TypeError: server must be a non-empty string"
+    );
+    engine.dispose_kernel().await;
+}
