new file mode 100644
index 000000000..a5efc8e86
--- /dev/null
+++ b/crates/pa-core/src/session_engine/mcp_status.rs
@@ -0,0 +1,210 @@
+//! The live MCP status lane: what each of the session's generic MCP
+//! servers offers right now, read from the session's running kernel (the
+//! runtime's `mcp_status` listing), plus the per-server reconnect. The
+//! `/mcp` connections roster derives its state from settings and stored
+//! credentials; only the kernel holds the open connections, so only this
+//! lane can tell a working server from a configured one. Neither call
+//! ever boots an idle kernel.
+
+use serde_json::{json, Value};
+
+use super::engine::SessionEngine;
+use crate::kernel::manager::ReplKernelManager;
+
+/// Which servers a live MCP status listing covers.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum McpStatusServers {
+    /// Every generic server the session enabled.
+    Enabled,
+    /// Exactly these names, in order; a name the session did not enable
+    /// reports the not-enabled error without a kernel round-trip.
+    Named(Vec<String>),
+}
+
+/// One live MCP listing of a session's kernel: `servers` carries one
+/// `{server, tools: [{name, description}] | null, error: string | null}`
+/// entry per listed server.
+#[derive(Debug, Clone, PartialEq)]
+pub struct McpLiveStatus {
+    /// `false` when the session has no running kernel: nothing was listed
+    /// and nothing was started.
+    pub kernel_running: bool,
+    pub servers: Vec<Value>,
+}
+
+impl McpLiveStatus {
+    /// The listing of a session without a running kernel.
+    #[must_use]
+    pub fn kernel_not_running() -> Self {
+        Self {
+            kernel_running: false,
+            servers: Vec::new(),
+        }
+    }
+}
+
+fn not_enabled_message(server: &str) -> String {
+    format!("MCP server {server} is not enabled in this session")
+}
+
+impl SessionEngine {
+    /// List MCP servers against this session's running kernel: each
+    /// server's live tools or its error. The runtime opens a server that is
+    /// not open yet, bounded by `per_server_timeout_ms`; an open connection
+    /// reports its cached tools ([`Self::reconnect_mcp_server`] re-checks it).
+    ///
+    /// # Errors
+    ///
+    /// Returns an error when the kernel listing fails or does not settle.
+    pub async fn mcp_status(
+        &self,
+        servers: McpStatusServers,
+        per_server_timeout_ms: u64,
+    ) -> anyhow::Result<McpLiveStatus> {
+        let Some(manager) = self
+            .provisioner
+            .manager()
+            .filter(ReplKernelManager::is_running)
+        else {
+            return Ok(McpLiveStatus::kernel_not_running());
+        };
+        let requested = match servers {
+            McpStatusServers::Enabled => self.generic_mcp_servers.clone(),
+            McpStatusServers::Named(names) => names,
+        };
+        let listed: Vec<String> = requested
+            .iter()
+            .filter(|server| self.generic_mcp_servers.contains(server))
+            .cloned()
+            .collect();
+        // The runtime answers one entry per listed server, in request order.
+        let mut listing = manager
+            .mcp_status_listing(&listed, per_server_timeout_ms, &[])
+            .await?
+            .into_iter();
+        let servers = requested
+            .iter()
+            .filter_map(|server| {
+                if self.generic_mcp_servers.contains(server) {
+                    listing.next()
+                } else {
+                    Some(json!({
+                        "server": server,
+                        "tools": null,
+                        "error": not_enabled_message(server),
+                    }))
+                }
+            })
+            .collect();
+        Ok(McpLiveStatus {
+            kernel_running: true,
+            servers,
+        })
+    }
+
+    /// Reconnect one of the session's generic MCP servers: the kernel
+    /// closes the server's open connection and lists it again, so a dead
+    /// connection reopens or reports why it cannot. The listing carries
+    /// exactly that server's entry. Without a running kernel there is no
+    /// connection to reconnect, whatever the name: the answer is
+    /// [`McpLiveStatus::kernel_not_running`].
+    ///
+    /// # Errors
+    ///
+    /// Returns an error when the kernel is running and `server` is not one
+    /// of the session's enabled generic servers, or the kernel reload or
+    /// listing fails or does not settle.
+    pub async fn reconnect_mcp_server(
+        &self,
+        server: &str,
+        per_server_timeout_ms: u64,
+    ) -> anyhow::Result<McpLiveStatus> {
+        let Some(manager) = self
+            .provisioner
+            .manager()
+            .filter(ReplKernelManager::is_running)
+        else {
+            return Ok(McpLiveStatus::kernel_not_running());
+        };
+        if !self
+            .generic_mcp_servers
+            .iter()
+            .any(|enabled| enabled == server)
+        {
+            return Err(anyhow::anyhow!(not_enabled_message(server)));
+        }
+        let server = [server.to_string()];
+        let servers = manager
+            .mcp_status_listing(&server, per_server_timeout_ms, &server)
+            .await?;
+        Ok(McpLiveStatus {
+            kernel_running: true,
+            servers,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use pa_agent::scripted::ScriptedProvider;
+
+    use super::*;
+    use crate::session_engine::engine::{create_session, SessionEngineConfig};
+
+    /// Without a running kernel neither call lists or starts anything, and
+    /// every reconnect answers "no kernel" — a server the session never
+    /// enabled included (only a running kernel's reconnect refuses it).
+    #[tokio::test]
+    async fn a_session_without_a_kernel_lists_nothing_and_starts_none() {
+        let model = pa_agent::types::Model {
+            id: "m".into(),
+            name: "m".into(),
+            api: "test".into(),
+            provider: "test".into(),
+            base_url: "http://localhost".into(),
+            reasoning: false,
+            cost: pa_agent::types::UsageCost::default(),
+            context_window: 1_000,
+            max_tokens: 100,
+            max_tokens_explicit: false,
+        };
+        let provider = Arc::new(ScriptedProvider::new(model.clone()));
+        let tmp = tempfile::tempdir().unwrap();
+        let cwd = tmp.path().join("project");
+        std::fs::create_dir_all(&cwd).unwrap();
+        let engine = create_session(SessionEngineConfig {
+            cwd,
+            agent_dir: tmp.path().join("agent"),
+            model: Some(model),
+            stream_fn: Some(provider.stream_fn()),
+            generic_mcp_servers: vec!["alpha".to_string()],
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+        assert_eq!(engine.generic_mcp_servers, vec!["alpha".to_string()]);
+
+        for servers in [
+            McpStatusServers::Enabled,
+            McpStatusServers::Named(vec!["alpha".to_string(), "ghost".to_string()]),
+        ] {
+            assert_eq!(
+                engine.mcp_status(servers, 1_000).await.unwrap(),
+                McpLiveStatus::kernel_not_running()
+            );
+        }
+        for server in ["alpha", "ghost"] {
+            assert_eq!(
+                engine.reconnect_mcp_server(server, 1_000).await.unwrap(),
+                McpLiveStatus::kernel_not_running(),
+                "{server}"
+            );
+        }
+        assert!(
+            !engine.provisioner.has_running_kernel(),
+            "the status lane must never start a kernel"
+        );
+    }
+}
