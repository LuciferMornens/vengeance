+#[cfg(test)]
+mod tests {
+    use serde_json::json;
+
+    use super::per_server_timeout_ms;
+    use crate::protocol::{response_failure, response_success};
+    use crate::worker::{Worker, WorkerConfig};
+
+    #[test]
+    fn the_per_server_bound_defaults_and_clamps() {
+        for (payload, expected) in [
+            (json!({}), Ok(10_000)),
+            (json!({ "timeoutMs": null }), Ok(10_000)),
+            (json!({ "timeoutMs": 0 }), Ok(1)),
+            (json!({ "timeoutMs": 2_500 }), Ok(2_500)),
+            (json!({ "timeoutMs": 20_000 }), Ok(20_000)),
+            (json!({ "timeoutMs": 60_000 }), Ok(20_000)),
+            (
+                json!({ "timeoutMs": -1 }),
+                Err("timeoutMs must be a non-negative integer"),
+            ),
+            (
+                json!({ "timeoutMs": "fast" }),
+                Err("timeoutMs must be a non-negative integer"),
+            ),
+        ] {
+            assert_eq!(per_server_timeout_ms(&payload), expected, "{payload}");
+        }
+    }
+
+    /// The wire shapes over a session without a kernel host (the scripted
+    /// engine): both commands answer `kernelRunning: false` with no
+    /// servers, and malformed requests fail with their reason (the direct
+    /// worker link's answers; the supervisor's typed parse rejects first).
+    #[tokio::test]
+    async fn the_lane_answers_without_a_kernel_and_rejects_malformed_requests() {
+        let dir = tempfile::TempDir::new().unwrap();
+        let worker = Worker::new(
+            WorkerConfig {
+                socket_path: dir.path().join("worker.sock"),
+                supervisor_socket_path: std::path::PathBuf::new(),
+                token: "token".to_string(),
+                worker_instance_id: String::new(),
+                active_session_id: "mcp-status-session".to_string(),
+                agent_dir: dir.path().join("agent"),
+                recovery_journal_path: dir.path().join("recovery.jsonl"),
+                telemetry_disabled: Some(true),
+                script: Some(json!({ "responses": ["ack"] })),
+            },
+            None,
+        );
+        let created = worker
+            .dispatch(
+                "create",
+                &json!({ "noSession": true, "cwd": dir.path(), "name": "mcp-status" }),
+            )
+            .await;
+        assert!(created.success, "create failed: {created:?}");
+
+        let not_running = json!({ "kernelRunning": false, "servers": [] });
+        for (command, payload) in [
+            ("get_mcp_status", json!({})),
+            (
+                "get_mcp_status",
+                json!({ "servers": ["alpha"], "timeoutMs": 2_000 }),
+            ),
+            ("reconnect_mcp_server", json!({ "server": "alpha" })),
+        ] {
+            assert_eq!(
+                worker.dispatch(command, &payload).await,
+                response_success(None, command, Some(not_running.clone())),
+                "{command} {payload}"
+            );
+        }
+        for (command, payload, error) in [
+            (
+                "get_mcp_status",
+                json!({ "servers": "alpha" }),
+                "servers must be an array of server names",
+            ),
+            (
+                "get_mcp_status",
+                json!({ "servers": ["alpha", 1] }),
+                "servers must be an array of server names",
+            ),
+            (
+                "get_mcp_status",
+                json!({ "timeoutMs": -1 }),
+                "timeoutMs must be a non-negative integer",
+            ),
+            (
+                "reconnect_mcp_server",
+                json!({}),
+                "reconnect_mcp_server requires a server",
+            ),
+            (
+                "reconnect_mcp_server",
+                json!({ "server": "" }),
+                "reconnect_mcp_server requires a server",
+            ),
+        ] {
+            assert_eq!(
+                worker.dispatch(command, &payload).await,
+                response_failure(None, command, error, None),
+                "{command} {payload}"
+            );
+        }
+    }
+}
