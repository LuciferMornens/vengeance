+async fn answer_catalog(socket: &mut tokio::net::TcpStream, tiers: Value) {
+    let body = json!({"models": [{"slug": "gpt-6.1-sol", "service_tiers": tiers}]}).to_string();
+    socket.write_all(format!(
+        "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+        body.len()
+    ).as_bytes()).await.unwrap();
+}
+
+#[tokio::test]
+async fn websocket_sends_ultrafast_without_changing_the_model() {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let model = model(listener.local_addr().unwrap());
+    let server = tokio::spawn(async move {
+        let (mut catalog, _) = listener.accept().await.unwrap();
+        assert!(read_head(&mut catalog)
+            .await
+            .starts_with("GET /codex/models?"));
+        answer_catalog(
+            &mut catalog,
+            json!([{"id": "priority"}, {"id": "ultrafast"}]),
+        )
+        .await;
+        drop(catalog);
+        let (socket, _) = listener.accept().await.unwrap();
+        let mut websocket = tokio_tungstenite::accept_async(socket).await.unwrap();
+        let frame = websocket
+            .next()
+            .await
+            .unwrap()
+            .unwrap()
+            .into_text()
+            .unwrap();
+        let request: Value = serde_json::from_str(&frame).unwrap();
+        let completed = json!({"type": "response.completed", "response": {
+            "id": "qa-response", "status": "completed", "output": [],
+            "service_tier": "default", "usage": {"input_tokens": 1, "output_tokens": 1}
+        }});
+        websocket
+            .send(tokio_tungstenite::tungstenite::Message::Text(
+                completed.to_string().into(),
+            ))
+            .await
+            .unwrap();
+        request
+    });
+    let result = tokio::time::timeout(
+        Duration::from_secs(10),
+        pa_ai::complete_simple(&model, &Context::default(), Some(options("qa-websocket"))),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(
+        result.stop_reason,
+        StopReason::Stop,
+        "{:?}",
+        result.error_message
+    );
+    let request = server.await.unwrap();
+    assert_eq!(request["model"], "gpt-6.1-sol");
+    assert_eq!(request["service_tier"], "ultrafast");
+}
+
+#[tokio::test]
+async fn cancellation_does_not_wait_for_a_hanging_catalog() {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let model = model(listener.local_addr().unwrap());
+    let signal = tokio_util::sync::CancellationToken::new();
+    let mut options = options("qa-abort");
+    options.base.signal = Some(signal.clone());
+    let stream = pa_ai::stream_simple(&model, &Context::default(), Some(options)).unwrap();
+    let (mut socket, _) = listener.accept().await.unwrap();
+    assert!(read_head(&mut socket)
+        .await
+        .starts_with("GET /codex/models?"));
+    signal.cancel();
+    let result = tokio::time::timeout(Duration::from_secs(1), stream.result())
+        .await
+        .unwrap();
+    assert_eq!(result.stop_reason, StopReason::Aborted);
+}
+
+#[tokio::test]
+async fn catalog_cache_is_scoped_to_the_signed_in_account() {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let model = model(listener.local_addr().unwrap());
+    let server = tokio::spawn(async move {
+        for tiers in [json!([{"id": "ultrafast"}]), json!([])] {
+            let (mut socket, _) = listener.accept().await.unwrap();
+            read_head(&mut socket).await;
+            answer_catalog(&mut socket, tiers).await;
+        }
+    });
+    let eligible = options("qa-eligible");
+    let tiers = pa_ai::available_service_tiers(&model, eligible.base.api_key.as_deref()).await;
+    assert_eq!(tiers.len(), 1);
+    assert_eq!(tiers[0].tier, ServiceTier::Ultrafast);
+    let ineligible = options("qa-ineligible");
+    let tiers = pa_ai::available_service_tiers(&model, ineligible.base.api_key.as_deref()).await;
+    assert!(tiers.is_empty());
+    let tiers = pa_ai::available_service_tiers(&model, eligible.base.api_key.as_deref()).await;
+    assert_eq!(tiers[0].tier, ServiceTier::Ultrafast);
+    server.await.unwrap();
+}
