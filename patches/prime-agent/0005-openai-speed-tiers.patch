diff --git a/crates/pa-ai/src/service_tiers.rs b/crates/pa-ai/src/service_tiers.rs
new file mode 100644
index 000000000..502eec3a5
--- /dev/null
+++ b/crates/pa-ai/src/service_tiers.rs
@@ -0,0 +1,233 @@
+//! Account-scoped `OpenAI` speed offers shared by native controls and request transports.
+
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+use serde::Serialize;
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+
+use crate::providers::openai_codex_responses::request::{extract_account_id, resolve_codex_url};
+use crate::types::{Model, ServiceTier};
+
+const CATALOG_TTL: Duration = Duration::from_hours(1);
+const CATALOG_RETRY: Duration = Duration::from_mins(5);
+const CATALOG_TIMEOUT: Duration = Duration::from_secs(10);
+const MAX_CACHED_ACCOUNTS: usize = 64;
+const CODEX_CLIENT_VERSION: &str = "0.162.0";
+
+#[derive(Clone, Debug, Serialize)]
+pub struct ServiceTierOption {
+    pub tier: ServiceTier,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub description: Option<String>,
+}
+
+#[derive(Clone)]
+struct CachedCatalog {
+    expires: Instant,
+    models: Option<HashMap<String, Vec<ServiceTierOption>>>,
+}
+
+static CATALOGS: OnceLock<Mutex<HashMap<String, CachedCatalog>>> = OnceLock::new();
+
+/// Return only faster modes the provider/model and signed-in account can use.
+/// Catalog failures offer Fast on known models, but never infer Ultrafast entitlement.
+pub async fn available_service_tiers(
+    model: &Model,
+    api_key: Option<&str>,
+) -> Vec<ServiceTierOption> {
+    let supported = |tier| pa_types::ai::supports_service_tier(model, tier);
+    let fallback = |subscription: bool| {
+        [ServiceTier::Priority, ServiceTier::Ultrafast]
+            .into_iter()
+            .filter(|tier| supported(*tier) && (!subscription || *tier != ServiceTier::Ultrafast))
+            .map(|tier| ServiceTierOption {
+                tier,
+                description: None,
+            })
+            .collect()
+    };
+    let responses = matches!(
+        (model.provider.as_str(), model.api.as_str()),
+        ("openai", "openai-responses") | ("openai-codex", "openai-codex-responses")
+    );
+    if !responses {
+        return fallback(false);
+    }
+    let account_id = api_key.and_then(|key| extract_account_id(key).ok());
+    let subscription = model.provider == "openai-codex" || account_id.is_some();
+    if !subscription {
+        return fallback(false);
+    }
+    let (Some(api_key), Some(account_id)) = (api_key, account_id) else {
+        return fallback(true);
+    };
+    let url = if model.api == "openai-codex-responses" {
+        let responses_url = resolve_codex_url(&model.base_url);
+        format!(
+            "{}models?client_version={CODEX_CLIENT_VERSION}",
+            responses_url
+                .strip_suffix("responses")
+                .unwrap_or(&responses_url)
+        )
+    } else {
+        format!(
+            "{}/models?client_version={CODEX_CLIENT_VERSION}",
+            model.base_url.trim_end_matches('/')
+        )
+    };
+    // Tokens are never retained in the cache; rotation and endpoint changes invalidate its scope.
+    let cache_key = format!("{url}:{:x}", Sha256::digest(api_key.as_bytes()));
+    let cache = CATALOGS.get_or_init(Mutex::default);
+    let cached = cache
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .get(&cache_key)
+        .filter(|entry| Instant::now() < entry.expires)
+        .cloned();
+    let catalog = if let Some(cached) = cached {
+        cached.models
+    } else {
+        let catalog = fetch_catalog(&url, api_key, &account_id).await;
+        let expires = Instant::now()
+            + if catalog.is_some() {
+                CATALOG_TTL
+            } else {
+                CATALOG_RETRY
+            };
+        let mut entries = cache
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        entries.retain(|_, entry| Instant::now() < entry.expires);
+        if entries.len() >= MAX_CACHED_ACCOUNTS {
+            entries.clear();
+        }
+        entries.insert(
+            cache_key,
+            CachedCatalog {
+                expires,
+                models: catalog.clone(),
+            },
+        );
+        catalog
+    };
+    match catalog {
+        Some(mut models) => models
+            .remove(&model.id)
+            .unwrap_or_default()
+            .into_iter()
+            .filter(|option| supported(option.tier))
+            .collect(),
+        None => fallback(true),
+    }
+}
+
+async fn fetch_catalog(
+    url: &str,
+    api_key: &str,
+    account_id: &str,
+) -> Option<HashMap<String, Vec<ServiceTierOption>>> {
+    let body = reqwest::Client::builder()
+        .timeout(CATALOG_TIMEOUT)
+        .redirect(reqwest::redirect::Policy::none())
+        .build()
+        .ok()?
+        .get(url)
+        .bearer_auth(api_key)
+        .header("chatgpt-account-id", account_id)
+        .header("originator", "codex_cli_rs")
+        .send()
+        .await
+        .ok()?
+        .error_for_status()
+        .ok()?
+        .json::<Value>()
+        .await
+        .ok()?;
+    parse_catalog(&body)
+}
+
+fn parse_catalog(body: &Value) -> Option<HashMap<String, Vec<ServiceTierOption>>> {
+    let models = body.get("models")?.as_array()?;
+    Some(
+        models
+            .iter()
+            .filter_map(|model| {
+                let slug = model.get("slug")?.as_str()?.to_string();
+                let tiers = model.get("service_tiers").and_then(Value::as_array);
+                let legacy_fast = model
+                    .get("additional_speed_tiers")
+                    .and_then(Value::as_array)
+                    .is_some_and(|tiers| tiers.iter().any(|tier| tier.as_str() == Some("fast")));
+                let options = [
+                    ("priority", ServiceTier::Priority),
+                    ("ultrafast", ServiceTier::Ultrafast),
+                ]
+                .into_iter()
+                .filter_map(|(name, tier)| {
+                    let offered = tiers.and_then(|tiers| {
+                        tiers
+                            .iter()
+                            .find(|entry| entry.get("id").and_then(Value::as_str) == Some(name))
+                    });
+                    if offered.is_none() && !(tier == ServiceTier::Priority && legacy_fast) {
+                        return None;
+                    }
+                    Some(ServiceTierOption {
+                        tier,
+                        description: offered
+                            .and_then(|entry| entry.get("description"))
+                            .and_then(Value::as_str)
+                            .map(str::to_string),
+                    })
+                })
+                .collect();
+                Some((slug, options))
+            })
+            .collect(),
+    )
+}
+
+pub(crate) async fn resolve_request_tier(
+    model: &Model,
+    api_key: &str,
+    requested: Option<ServiceTier>,
+    signal: Option<&tokio_util::sync::CancellationToken>,
+) -> Result<Option<ServiceTier>, crate::ProviderError> {
+    if !matches!(
+        requested,
+        Some(ServiceTier::Priority | ServiceTier::Ultrafast)
+    ) {
+        return Ok(requested);
+    }
+    let subscription = model.provider == "openai-codex"
+        || (model.provider == "openai" && extract_account_id(api_key).is_ok());
+    if !subscription {
+        return Ok(requested);
+    }
+    let lookup = available_service_tiers(model, Some(api_key));
+    let options = if let Some(signal) = signal {
+        tokio::select! {
+            biased;
+            () = signal.cancelled() => return Err(crate::ProviderError::Aborted),
+            options = lookup => options,
+        }
+    } else {
+        lookup.await
+    };
+    Ok(
+        if options.iter().any(|option| Some(option.tier) == requested) {
+            requested
+        } else if requested == Some(ServiceTier::Ultrafast)
+            && options
+                .iter()
+                .any(|option| option.tier == ServiceTier::Priority)
+        {
+            Some(ServiceTier::Priority)
+        } else {
+            Some(ServiceTier::Default)
+        },
+    )
+}
diff --git a/crates/pa-ai/tests/service_tiers.rs b/crates/pa-ai/tests/service_tiers.rs
new file mode 100644
index 000000000..420887759
--- /dev/null
+++ b/crates/pa-ai/tests/service_tiers.rs
@@ -0,0 +1,157 @@
+use std::time::Duration;
+
+use base64::Engine as _;
+use pa_ai::types::{Context, Model, ServiceTier, SimpleStreamOptions, StreamOptions, Transport};
+use serde_json::{json, Value};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+fn test_model(provider: &str, address: std::net::SocketAddr) -> Model {
+    serde_json::from_value(json!({
+        "id": "gpt-6.1-sol", "name": "QA", "provider": provider,
+        "api": if provider == "openai" { "openai-responses" } else { "openai-codex-responses" },
+        "baseUrl": format!("http://{address}"), "reasoning": false, "input": ["text"],
+        "contextWindow": 10000, "maxTokens": 100,
+        "cost": {"input": 1, "output": 1, "cacheRead": 0, "cacheWrite": 0}
+    }))
+    .unwrap()
+}
+
+async fn capture_request(
+    provider: &str,
+    simple: bool,
+    requested: ServiceTier,
+    offered: Vec<&'static str>,
+) -> Value {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move {
+        loop {
+            let (mut socket, _) = listener.accept().await.unwrap();
+            let mut bytes = Vec::new();
+            let mut buffer = [0; 4096];
+            let (head, body) = loop {
+                let count = socket.read(&mut buffer).await.unwrap();
+                assert_ne!(count, 0);
+                bytes.extend_from_slice(&buffer[..count]);
+                if let Some(end) = bytes.windows(4).position(|window| window == b"\r\n\r\n") {
+                    let head = String::from_utf8_lossy(&bytes[..end]);
+                    let length: usize = head
+                        .lines()
+                        .find_map(|line| {
+                            let (name, value) = line.split_once(':')?;
+                            name.eq_ignore_ascii_case("content-length")
+                                .then(|| value.trim().parse().unwrap())
+                        })
+                        .unwrap_or(0);
+                    if bytes.len() >= end + 4 + length {
+                        let body = serde_json::from_slice::<Value>(&bytes[end + 4..])
+                            .unwrap_or(Value::Null);
+                        break (head.to_string(), body);
+                    }
+                }
+            };
+            if head.starts_with("GET ") {
+                assert!(head.to_lowercase().contains("chatgpt-account-id: qa-speed"));
+                assert!(head.contains("client_version=0.162.0"));
+                let catalog = json!({"models": [{"slug": "gpt-6.1-sol", "service_tiers":
+                    offered.iter().map(|tier| json!({"id": tier})).collect::<Vec<_>>()
+                }]})
+                .to_string();
+                socket.write_all(format!(
+                "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{catalog}",
+                catalog.len()
+            ).as_bytes()).await.unwrap();
+                continue;
+            }
+            let event = json!({"type": "response.completed", "response": {
+                "id": "qa-response", "status": "completed", "output": [],
+                "service_tier": "default", "usage": {"input_tokens": 1, "output_tokens": 1}
+            }});
+            let payload = format!("data: {event}\n\n");
+            let response = format!(
+            "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{payload}",
+            payload.len()
+        );
+            socket.write_all(response.as_bytes()).await.unwrap();
+            return body;
+        }
+    });
+    let model = test_model(provider, address);
+    let claims = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(
+        json!({"https://api.openai.com/auth": {"chatgpt_account_id": "qa-speed"}}).to_string(),
+    );
+    let options = StreamOptions {
+        api_key: Some(if provider == "openai" {
+            "qa-key".into()
+        } else {
+            format!("e30.{claims}.qa")
+        }),
+        service_tier: Some(requested),
+        transport: Some(Transport::Sse),
+        ..Default::default()
+    };
+    let context = Context::default();
+    let result = if simple {
+        pa_ai::complete_simple(
+            &model,
+            &context,
+            Some(SimpleStreamOptions {
+                base: options,
+                ..Default::default()
+            }),
+        )
+        .await
+    } else {
+        pa_ai::complete(&model, &context, Some(options)).await
+    }
+    .unwrap();
+    assert!(result.error_message.is_none(), "{:?}", result.error_message);
+    let body = server.await.unwrap();
+    if provider == "openai-codex" {
+        let multiplier = match body["service_tier"].as_str() {
+            Some("ultrafast") => 6.0,
+            Some("priority") => 2.0,
+            _ => 1.0,
+        };
+        let expected_cost = 2.0 / 1_000_000.0 * multiplier;
+        assert!((result.usage.cost.total.as_f64() - expected_cost).abs() < 1e-12);
+    }
+    body
+}
+
+#[tokio::test]
+async fn public_streams_send_the_requested_service_tier() {
+    for provider in ["openai", "openai-codex"] {
+        for simple in [true, false] {
+            let body = tokio::time::timeout(
+                Duration::from_secs(10),
+                capture_request(provider, simple, ServiceTier::Priority, vec!["priority"]),
+            )
+            .await
+            .unwrap();
+            assert_eq!(
+                body["service_tier"], "priority",
+                "{provider}, simple={simple}"
+            );
+        }
+    }
+}
+
+#[tokio::test]
+async fn ultrafast_uses_account_entitlement_and_falls_back_to_an_offered_tier() {
+    for (offered, expected) in [
+        (vec!["priority", "ultrafast"], "ultrafast"),
+        (vec!["priority"], "priority"),
+        (vec![], "default"),
+    ] {
+        let body = tokio::time::timeout(
+            Duration::from_secs(10),
+            capture_request("openai-codex", true, ServiceTier::Ultrafast, offered),
+        )
+        .await
+        .unwrap();
+        assert_eq!(body["service_tier"], expected);
+    }
+    let body = capture_request("openai", true, ServiceTier::Ultrafast, vec![]).await;
+    assert_eq!(body["service_tier"], "ultrafast");
+}
