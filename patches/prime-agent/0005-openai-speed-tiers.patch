+++ b/crates/pa-ai/tests/service_tiers_transport.rs
@@ -0,0 +1,150 @@
+use std::time::Duration;
+
+use base64::Engine as _;
+use futures::{SinkExt, StreamExt};
+use pa_ai::types::{
+    Context, Model, ServiceTier, SimpleStreamOptions, StopReason, StreamOptions, Transport,
+};
+use serde_json::{json, Value};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+fn model(address: std::net::SocketAddr) -> Model {
+    serde_json::from_value(json!({
+        "id": "gpt-6.1-sol", "name": "QA", "provider": "openai-codex",
+        "api": "openai-codex-responses", "baseUrl": format!("http://{address}"),
+        "reasoning": false, "input": ["text"], "contextWindow": 10000, "maxTokens": 100,
+        "cost": {"input": 1, "output": 1, "cacheRead": 0, "cacheWrite": 0}
+    }))
+    .unwrap()
+}
+
+fn options(account: &str) -> SimpleStreamOptions {
+    let claims = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(
+        json!({"https://api.openai.com/auth": {"chatgpt_account_id": account}}).to_string(),
+    );
+    SimpleStreamOptions {
+        base: StreamOptions {
+            api_key: Some(format!("e30.{claims}.qa")),
+            service_tier: Some(ServiceTier::Ultrafast),
+            transport: Some(Transport::Websocket),
+            ..Default::default()
+        },
+        ..Default::default()
+    }
+}
+
+async fn read_head(socket: &mut tokio::net::TcpStream) -> String {
+    let mut head = String::new();
+    let mut buffer = [0; 4096];
+    while !head.contains("\r\n\r\n") {
+        let count = socket.read(&mut buffer).await.unwrap();
+        assert_ne!(count, 0);
+        head.push_str(&String::from_utf8_lossy(&buffer[..count]));
+    }
+    head
+}
