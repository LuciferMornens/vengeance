+/// Compiled providers no catalog layer carries, so resolution must add them to whichever one it
+/// used: the remote catalog and the bundled snapshot would otherwise drop them.
+const COMPILED_ONLY_PROVIDERS: &[&str] = &["orcarouter"];
+
+/// Add the compiled entries of [`COMPILED_ONLY_PROVIDERS`] that `models` lacks.
+pub fn join_compiled_only_entries(models: &mut Vec<Model>) {
+    for model in compiled_models()
+        .iter()
+        .filter(|model| COMPILED_ONLY_PROVIDERS.contains(&model.provider.as_str()))
+    {
+        if !models
+            .iter()
+            .any(|existing| existing.provider == model.provider && existing.id == model.id)
+        {
+            models.push(model.clone());
+        }
+    }
+}
