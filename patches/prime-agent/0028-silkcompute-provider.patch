+    #[test]
+    fn silkcompute_declares_off_the_documented_efforts_and_accepted_request_shape() {
+        use crate::types::ModelInput::{Image, Text};
+        use crate::types::ModelThinkingLevel::{High, Low, Max, Medium, Minimal, Off, Xhigh};
+
+        let expected = [
+            (
+                "kimi-k3.1-pro-uncensored",
+                vec![Text, Image],
+                131_072,
+                (5.0, 15.0, 0.5),
+            ),
+            (
+                "deepseek-v4.1-flash-1017-uncensored",
+                vec![Text, Image],
+                131_072,
+                (0.26, 0.9, 0.06),
+            ),
+            ("glm-5.3-uncensored", vec![Text], 131_072, (2.0, 4.0, 0.3)),
+            (
+                "glm-5.3-flash-uncensored",
+                vec![Text, Image],
+                131_072,
+                (0.24, 1.0, 0.06),
+            ),
+            ("hy4-uncensored", vec![Text, Image], 65_536, (1.6, 3.2, 0.3)),
+        ];
+        assert_eq!(get_models("silkcompute").len(), expected.len());
+        for (id, input, max_tokens, (input_price, output_price, cache_read_price)) in expected {
+            let model = get_model("silkcompute", id).expect("compiled");
+            assert_eq!(
+                crate::models::get_supported_thinking_levels(model),
+                vec![Off, Low, High, Max],
+                "{id}"
+            );
+            assert_eq!(
+                model
+                    .thinking_level_map
+                    .as_ref()
+                    .and_then(|map| map.get(&Off)),
+                Some(&Some("none".to_string())),
+                "the app lists the levels the map names, so Off needs its wire value"
+            );
+            assert_eq!(crate::models::clamp_thinking_level(model, Minimal), Low);
+            assert_eq!(crate::models::clamp_thinking_level(model, Medium), High);
+            assert_eq!(crate::models::clamp_thinking_level(model, Xhigh), Max);
+            assert_eq!(model.base_url, "https://api.silkcompute.com/v1");
+            assert_eq!(model.input, input, "{id}");
+            assert_eq!(model.context_window, 1_048_576);
+            assert_eq!(model.max_tokens, max_tokens, "{id}");
+            assert!(
+                (model.cost.input.as_f64() - input_price).abs() < 1e-9,
+                "{id}"
+            );
+            assert!(
+                (model.cost.output.as_f64() - output_price).abs() < 1e-9,
+                "{id}"
+            );
+            assert!(
+                (model.cost.cache_read.as_f64() - cache_read_price).abs() < 1e-9,
+                "{id}"
+            );
+            assert!(
+                (model.cost.cache_write.as_f64() - input_price).abs() < 1e-9,
+                "{id}"
+            );
+            let Some(crate::types::CompatKind::OpenAiCompletions(compat)) = model.compat_kind()
+            else {
+                panic!("silkcompute carries a compat object");
+            };
+            assert_eq!(compat.supports_store, Some(false));
+            assert_eq!(compat.supports_developer_role, Some(false));
+            assert_eq!(compat.supports_reasoning_effort, Some(true));
+            assert_eq!(compat.max_tokens_field, Some(MaxTokensField::MaxTokens));
+        }
+    }
