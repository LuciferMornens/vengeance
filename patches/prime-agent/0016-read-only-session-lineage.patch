+    /// Open a ledger for observation without migrating legacy registries or writing account files.
+    /// A missing ledger reads empty; native daemon admission owns legacy migration.
+    pub fn read_only(
+        agent_dir: &Path,
+        sessions_dir: &Path,
+        log: impl Fn(&str) + Send + Sync + 'static,
+    ) -> Self {
+        Self {
+            seed_attempted: AtomicBool::new(true),
+            ..Self::new(agent_dir, sessions_dir, log)
+        }
+    }
+
     fn log(&self, message: &str) {
         (self.log)(message);
     }
@@ -533,6 +546,41 @@ impl RlmSpawnLedger {
             .collect())
     }
 
+    /// One replay snapshot with endpoint paths resolved independently. Missing parents retain
+    /// their recorded identity; tombstones remain authoritative even when transcripts survive.
+    ///
+    /// # Errors
+    ///
+    /// Returns an error when the ledger exceeds its replay bounds.
+    pub fn edges_with_resolved_paths(&self, include_deleted: bool) -> Result<Vec<RlmLedgerEdge>> {
+        self.seed_once()?;
+        let state = self.replay_cached()?;
+        let mut resolver =
+            LivePathResolver::new(self.agent_dir.clone(), self.canonical_sessions_dir.clone());
+        Ok(state
+            .edges
+            .iter()
+            .filter(|edge| include_deleted || edge.deleted.is_none())
+            .map(|edge| RlmLedgerEdge {
+                parent: if edge.deleted.is_some() {
+                    edge.parent.clone()
+                } else {
+                    resolver
+                        .resolve(&edge.parent)
+                        .map_or_else(|| edge.parent.clone(), |path| path.to_string_lossy().into())
+                },
+                child: if edge.deleted.is_some() {
+                    edge.child.clone()
+                } else {
+                    resolver
+                        .resolve(&edge.child)
+                        .map_or_else(|| edge.child.clone(), |path| path.to_string_lossy().into())
+                },
+                ..edge.clone()
+            })
+            .collect())
+    }
+
     /// Live edges reconciled by liveness of their recorded endpoints: a dead endpoint drops the
     /// edge; a MOVED path resolves through its durable session id first.
     ///
