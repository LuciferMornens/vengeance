+fn shutdown_sandboxed_daemon(socket: &std::path::Path) -> anyhow::Result<()> {
+    use tokio::io::{AsyncBufReadExt, AsyncWriteExt};
+
+    let runtime = tokio::runtime::Builder::new_current_thread()
+        .enable_all()
+        .build()?;
+    runtime.block_on(async {
+        tokio::time::timeout(CLEANUP_TIMEOUT, async {
+            let stream = match pa_types::platform::transport::connect_transport(socket).await {
+                Ok(stream) => stream,
+                Err(error)
+                    if error.downcast_ref::<std::io::Error>().is_some_and(|error| {
+                        matches!(
+                            error.kind(),
+                            std::io::ErrorKind::NotFound
+                                | std::io::ErrorKind::ConnectionRefused
+                                | std::io::ErrorKind::NotConnected
+                        )
+                    }) =>
+                {
+                    return Ok(())
+                }
+                Err(error) => return Err(error),
+            };
+            let (reader, mut writer) = stream.split();
+            let mut lines = tokio::io::BufReader::new(reader).lines();
+            let line = lines
+                .next_line()
+                .await?
+                .ok_or_else(|| anyhow::anyhow!("the daemon closed before its hello"))?;
+            let hello: Value = serde_json::from_str(&line)?;
+            anyhow::ensure!(
+                hello["type"] == "daemon_hello",
+                "unexpected daemon hello: {hello}"
+            );
+            anyhow::ensure!(
+                hello["socketPath"] == socket.to_string_lossy().as_ref(),
+                "the daemon hello names another fixture socket: {hello}"
+            );
+            let supervisor_pid = u32::try_from(
+                hello["supervisorPid"]
+                    .as_u64()
+                    .ok_or_else(|| anyhow::anyhow!("the daemon hello has no supervisor pid"))?,
+            )?;
+            let supervisor_identity = pa_types::platform::process_start_id(supervisor_pid);
+            let frame = json!({
+                "type": "command", "id": "shutdown-test",
+                "protocol": { "name": "prime-agent.daemon",
+                    "version": pa_types::daemon::DAEMON_PROTOCOL_VERSION },
+                "command": { "type": "shutdown" }
+            });
+            writer.write_all(format!("{frame}\n").as_bytes()).await?;
+            writer.flush().await?;
+            let mut acknowledged = false;
+            while let Some(line) = lines.next_line().await? {
+                let response: Value = serde_json::from_str(&line)?;
+                if response["id"] == "shutdown-test" {
+                    anyhow::ensure!(response["success"] == true, "shutdown failed: {response}");
+                    acknowledged = true;
+                }
+            }
+            anyhow::ensure!(
+                acknowledged,
+                "the daemon closed without acknowledging shutdown"
+            );
+            while pa_types::platform::is_process_alive(supervisor_pid)? {
+                if supervisor_identity.is_some()
+                    && pa_types::platform::process_start_id(supervisor_pid) != supervisor_identity
+                {
+                    break;
+                }
+                tokio::time::sleep(CLEANUP_POLL_INTERVAL).await;
+            }
+            Ok(())
+        })
+        .await
+        .map_err(|_| anyhow::anyhow!("fixture daemon cleanup exceeded {CLEANUP_TIMEOUT:?}"))?
+    })
 }
 
