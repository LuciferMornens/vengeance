@@ -0,0 +1,93 @@
+#![cfg(windows)]
+
+use pa_types::platform::{bind_transport, connect_blocking, connect_transport, TransportListener};
+use std::future::Future;
+use std::io::{Read, Write};
+use std::path::Path;
+use std::task::Poll;
+use std::time::Duration;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+async fn round_trip_after_accept_waits(listener: &dyn TransportListener, endpoint: &Path) {
+    let accepted = listener.accept();
+    tokio::pin!(accepted);
+    std::future::poll_fn(|context| {
+        assert!(accepted.as_mut().poll(context).is_pending());
+        Poll::Ready(())
+    })
+    .await;
+    tokio::time::timeout(Duration::from_secs(5), async {
+        let client = connect_transport(endpoint).await.unwrap();
+        let server = accepted.await.unwrap();
+        let (_server_reader, mut server_writer) = server.split();
+        let (mut client_reader, _client_writer) = client.split();
+        server_writer.write_all(b"ping").await.unwrap();
+        let mut message = [0; 4];
+        client_reader.read_exact(&mut message).await.unwrap();
+        assert_eq!(&message, b"ping");
+    })
+    .await
+    .expect("a client must reach the instance the listener is accepting");
+}
+
+#[tokio::test]
+async fn a_client_reaches_the_waiting_accept() {
+    let root = tempfile::tempdir().unwrap();
+    let endpoint = root.path().join("waiting.sock");
+    let listener = bind_transport(&endpoint).await.unwrap();
+    round_trip_after_accept_waits(listener.as_ref(), &endpoint).await;
+}
+
+#[tokio::test]
+async fn cancelling_accept_keeps_the_listening_instance_available() {
+    let root = tempfile::tempdir().unwrap();
+    let endpoint = root.path().join("cancelled.sock");
+    let listener = bind_transport(&endpoint).await.unwrap();
+    {
+        let cancelled = listener.accept();
+        tokio::pin!(cancelled);
+        std::future::poll_fn(|context| {
+            assert!(cancelled.as_mut().poll(context).is_pending());
+            Poll::Ready(())
+        })
+        .await;
+    }
+    round_trip_after_accept_waits(listener.as_ref(), &endpoint).await;
+}
+
+#[tokio::test]
+async fn blocking_commands_work_inside_an_async_runtime() {
+    let fixture = tempfile::tempdir().unwrap();
+    let endpoint = fixture.path().join("blocking.sock");
+    let server_endpoint = endpoint.clone();
+    let (ready_sender, ready_receiver) = std::sync::mpsc::channel();
+    let server = std::thread::spawn(move || {
+        let runtime = tokio::runtime::Runtime::new().unwrap();
+        runtime.block_on(async move {
+            let listener = bind_transport(&server_endpoint).await.unwrap();
+            ready_sender.send(()).unwrap();
+            let peer = listener.accept().await.unwrap();
+            let (mut reader, mut writer) = peer.split();
+            let mut request = [0; 4];
+            reader.read_exact(&mut request).await.unwrap();
+            assert_eq!(&request, b"ping");
+            writer.write_all(b"pong").await.unwrap();
+        });
+    });
+    ready_receiver.recv_timeout(Duration::from_secs(5)).unwrap();
+
+    let mut client = connect_blocking(&endpoint).unwrap();
+    client.set_read_timeout(Duration::from_millis(50)).unwrap();
+    let mut response = [0; 4];
+    assert_eq!(
+        client.read(&mut response).unwrap_err().kind(),
+        std::io::ErrorKind::TimedOut
+    );
+    client.write_all(b"ping").unwrap();
+    client.flush().unwrap();
+    client.set_read_timeout(Duration::from_secs(5)).unwrap();
+    client.read_exact(&mut response).unwrap();
+    assert_eq!(&response, b"pong");
+    drop(client);
+    server.join().unwrap();
+}
