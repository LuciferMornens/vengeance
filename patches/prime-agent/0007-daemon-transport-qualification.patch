+#[test]
+fn a_fragmented_daemon_command_survives_an_interleaved_session_event() {
+    use tokio::io::{AsyncBufReadExt, AsyncWriteExt};
+
+    let mut client = AcpChild::spawn(
+        &["--mode", "acp", "--no-session"],
+        &json!({ "responses": ["unused"] }),
+    );
+    let _ = initialize_and_new_session(&mut client);
+    let active_session_id = live_sessions(&client.socket)[0]["activeSessionId"]
+        .as_str()
+        .unwrap()
+        .to_string();
+    let socket = client.socket.clone();
+    let runtime = tokio::runtime::Runtime::new().unwrap();
+    runtime.block_on(async {
+        tokio::time::timeout(Duration::from_secs(15), async {
+            let stream = pa_types::platform::transport::connect_transport(&socket).await.unwrap();
+            let (reader, mut writer) = stream.split();
+            let mut lines = tokio::io::BufReader::new(reader).lines();
+            let _hello = lines.next_line().await.unwrap().unwrap();
+            let protocol = json!({ "name": "prime-agent.daemon", "version": pa_types::daemon::DAEMON_PROTOCOL_VERSION });
+            let attach = json!({ "type": "command", "id": "fragment-attach", "protocol": protocol,
+                "command": { "type": "attach", "activeSessionId": active_session_id } });
+            writer.write_all(format!("{attach}\n").as_bytes()).await.unwrap();
+            loop {
+                let frame: Value = serde_json::from_str(&lines.next_line().await.unwrap().unwrap()).unwrap();
+                if frame["id"] == "fragment-attach" { assert_eq!(frame["success"], true, "{frame}"); break; }
+            }
+            let request = json!({ "type": "command", "id": "fragment-state", "protocol": protocol,
+                "command": { "type": "get_state", "activeSessionId": active_session_id } });
+            let bytes = format!("{request}\n").into_bytes();
+            let boundary = bytes.len() - 2;
+            writer.write_all(&bytes[..boundary]).await.unwrap();
+            writer.flush().await.unwrap();
+            let rename_socket = socket.clone();
+            let rename = tokio::task::spawn_blocking(move || daemon_request(&rename_socket, "fragment-rename",
+                &json!({ "type": "rename", "activeSessionId": active_session_id, "name": "fragmented-command" })));
+            loop {
+                let frame: Value = serde_json::from_str(&lines.next_line().await.unwrap().unwrap()).unwrap();
+                if frame["event"]["type"] == "session_info_changed" && frame["event"]["name"] == "fragmented-command" { break; }
+            }
+            assert_eq!(rename.await.unwrap()["success"], true);
+            writer.write_all(&bytes[boundary..]).await.unwrap();
+            writer.flush().await.unwrap();
+            loop {
+                let frame: Value = serde_json::from_str(&lines.next_line().await.unwrap().unwrap()).unwrap();
+                if frame["type"] == "response" {
+                    assert_eq!(frame["id"], "fragment-state", "{frame}");
+                    assert_eq!(frame["success"], true, "{frame}");
+                    break;
+                }
+            }
+        }).await.expect("an event must not discard an incomplete client command");
+    });
+}
