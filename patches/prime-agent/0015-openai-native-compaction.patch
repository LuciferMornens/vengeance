new file mode 100644
index 000000000..e2e506108
--- /dev/null
+++ b/crates/pa-ai/src/native_compaction.rs
@@ -0,0 +1,127 @@
+//! `OpenAI` Responses checkpoints. The trigger is a protocol item, never a user instruction.
+use serde_json::{json, Value};
+
+use crate::types::{
+    AssistantMessage, Context, Model, SimpleStreamOptions, StopReason, Usage, UserMessage,
+    UserMessageContent, UserOrToolContent,
+};
+
+const FORMAT: &str = "responses-compaction-trigger-v1";
+const ITEMS: &str = "vengeanceCompactionItems";
+const COMPLETED: &str = "vengeanceCompactionCompleted";
+
+#[cfg(test)]
+mod tests;
+
+#[must_use]
+pub fn supported(model: &Model) -> bool {
+    matches!(
+        (model.provider.as_str(), model.api.as_str()),
+        ("openai", "openai-responses") | ("openai-codex", "openai-codex-responses")
+    )
+}
+
+/// Observe raw events before the normal assistant-message parser discards non-message items.
+pub(crate) fn observe(event: &Value, output: &mut AssistantMessage) {
+    match event["type"].as_str() {
+        Some("response.output_item.done") if event["item"]["type"] == "compaction" => {
+            let items = output.rest.entry(ITEMS).or_insert_with(|| json!([]));
+            if let Some(items) = items.as_array_mut() {
+                items.push(event["item"].clone());
+            }
+        }
+        Some("response.completed") if output.rest.contains_key(ITEMS) => {
+            output.rest.insert(
+                COMPLETED.into(),
+                json!(event["response"]["status"] == "completed"),
+            );
+        }
+        _ => {}
+    }
+}
+
+fn valid_item(item: &Value) -> bool {
+    item["type"] == "compaction"
+        && item["encrypted_content"]
+            .as_str()
+            .is_some_and(|content| !content.is_empty())
+}
+
+fn checkpoint(model: &Model, output: &AssistantMessage) -> Option<Value> {
+    let items = output.rest.get(ITEMS)?.as_array()?;
+    if output.stop_reason != StopReason::Stop
+        || output.rest.get(COMPLETED) != Some(&Value::Bool(true))
+        || items.len() != 1
+        || !valid_item(&items[0])
+    {
+        return None;
+    }
+    let mut item =
+        json!({"type": "compaction", "encrypted_content": items[0]["encrypted_content"]});
+    if let Some(id) = items[0]["id"].as_str() {
+        item["id"] = json!(id);
+    }
+    Some(
+        json!({"format": FORMAT, "model": model.id, "provider": model.provider,
+        "api": model.api, "baseUrl": model.base_url, "item": item}),
+    )
+}
+
+/// Complete a checkpoint on the same authenticated Responses transport as ordinary turns.
+/// Dropping the caller must cancel the supplied transport token.
+pub async fn compact(
+    model: &Model,
+    context: &Context,
+    mut options: SimpleStreamOptions,
+) -> Option<(Value, Usage)> {
+    if !supported(model) {
+        return None;
+    }
+    options.base.on_payload = Some(std::sync::Arc::new(|mut payload, _| {
+        let body = payload.as_object_mut()?;
+        // Compaction uses provider defaults, not an ordinary answer's budget or reasoning effort.
+        for key in ["max_output_tokens", "temperature", "top_p", "reasoning"] {
+            body.remove(key);
+        }
+        body.get_mut("input")?
+            .as_array_mut()?
+            .push(json!({"type": "compaction_trigger"}));
+        Some(payload)
+    }));
+    let result = crate::complete_simple(model, context, Some(options))
+        .await
+        .ok()?;
+    checkpoint(model, &result).map(|checkpoint| (checkpoint, result.usage))
+}
+
+/// The summary's provider signature survives the pa-agent wire round-trip. Other providers
+/// ignore user text signatures and see the saved text summary. Never parse user text as a checkpoint.
+pub(crate) fn replay(user: &UserMessage, model: &Model) -> Option<Vec<Value>> {
+    if !supported(model) {
+        return None;
+    }
+    let UserMessageContent::Blocks(blocks) = &user.content else {
+        return None;
+    };
+    let [UserOrToolContent::Text(text)] = blocks.as_slice() else {
+        return None;
+    };
+    let checkpoint: Value = serde_json::from_str(text.text_signature.as_deref()?).ok()?;
+    if checkpoint["format"] != FORMAT
+        || checkpoint["model"] != model.id
+        || checkpoint["provider"] != model.provider.as_str()
+        || checkpoint["api"] != model.api.as_str()
+        || checkpoint["baseUrl"] != model.base_url
+        || !valid_item(&checkpoint["item"])
+    {
+        return None;
+    }
+    let mut input = vec![checkpoint["item"].clone()];
+    if let Some(digest) = checkpoint["digest"]
+        .as_str()
+        .filter(|digest| !digest.is_empty())
+    {
+        input.push(json!({"role": "user", "content": [{"type": "input_text", "text": digest}]}));
+    }
+    Some(input)
+}
diff --git a/crates/pa-ai/src/native_compaction/tests.rs b/crates/pa-ai/src/native_compaction/tests.rs
new file mode 100644
index 000000000..2175f6f3a
--- /dev/null
+++ b/crates/pa-ai/src/native_compaction/tests.rs
@@ -0,0 +1,93 @@
+use super::*;
+
+fn model(provider: &str, api: &str) -> Model {
+    serde_json::from_value(
+        json!({"id":"gpt-6.1-sol", "name":"test", "provider":provider,
+        "api":api, "baseUrl":"http://localhost/v1", "reasoning":true, "input":["text"],
+        "contextWindow":272_000, "maxTokens":4096,
+        "cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0}}),
+    )
+    .unwrap()
+}
+
+fn output() -> AssistantMessage {
+    serde_json::from_value(
+        json!({"role":"assistant", "content":[], "api":"openai-responses",
+        "provider":"openai", "model":"gpt-6.1-sol", "stopReason":"stop", "timestamp":0,
+        "usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,
+            "cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}}}),
+    )
+    .unwrap()
+}
+
+fn item() -> Value {
+    json!({"type":"compaction", "id":"cmp_test", "encrypted_content":"opaque"})
+}
+
+#[test]
+fn only_one_valid_item_in_a_completed_response_is_committed() {
+    let model = model("openai", "openai-responses");
+    let mut output = output();
+    observe(
+        &json!({"type":"response.output_item.done", "item":item()}),
+        &mut output,
+    );
+    assert!(checkpoint(&model, &output).is_none(), "truncated stream");
+    observe(
+        &json!({"type":"response.completed", "response":{"status":"incomplete"}}),
+        &mut output,
+    );
+    assert!(checkpoint(&model, &output).is_none());
+    observe(
+        &json!({"type":"response.completed", "response":{"status":"completed"}}),
+        &mut output,
+    );
+    assert!(checkpoint(&model, &output).is_some());
+    output.stop_reason = StopReason::Aborted;
+    assert!(checkpoint(&model, &output).is_none());
+    output.stop_reason = StopReason::Stop;
+    observe(
+        &json!({"type":"response.output_item.done", "item":{"type":"compaction"}}),
+        &mut output,
+    );
+    assert!(
+        checkpoint(&model, &output).is_none(),
+        "malformed extra item is still a duplicate"
+    );
+}
+
+#[test]
+fn replay_is_bound_to_version_model_provider_api_and_endpoint() {
+    for (provider, api) in [
+        ("openai", "openai-responses"),
+        ("openai-codex", "openai-codex-responses"),
+    ] {
+        let model = model(provider, api);
+        let mut output = output();
+        observe(
+            &json!({"type":"response.output_item.done", "item":item()}),
+            &mut output,
+        );
+        observe(
+            &json!({"type":"response.completed", "response":{"status":"completed"}}),
+            &mut output,
+        );
+        let mut saved = checkpoint(&model, &output).unwrap();
+        saved["digest"] = json!("current harness state");
+        let user = |checkpoint: &Value| -> UserMessage {
+            serde_json::from_value(json!({"content":[{"type":"text", "text":"portable summary",
+                "textSignature":checkpoint.to_string()}], "timestamp":0}))
+            .unwrap()
+        };
+        let replayed = replay(&user(&saved), &model).unwrap();
+        assert_eq!(replayed[0], item());
+        assert_eq!(replayed[1]["content"][0]["text"], "current harness state");
+        for field in ["format", "model", "provider", "api", "baseUrl"] {
+            let mut changed = saved.clone();
+            changed[field] = json!("other");
+            assert!(replay(&user(&changed), &model).is_none(), "{field}");
+        }
+        saved.as_object_mut().unwrap().remove("format");
+        assert!(replay(&user(&saved), &model).is_none(), "legacy checkpoint");
+    }
+}
