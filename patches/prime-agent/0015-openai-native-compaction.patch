@@ -0,0 +1,106 @@
+//! Optional native checkpoint alongside the durable, portable text summary.
+use pa_ai::types::{Context, SimpleStreamOptions, StreamOptions, Tool, Usage};
+use serde_json::Value;
+
+use super::{
+    compact_session::{CompactOptions, CompactionAttempt, PreparedCompaction},
+    AgentSession,
+};
+
+impl AgentSession {
+    pub(super) async fn native_checkpoint(
+        &self,
+        attempt: &CompactionAttempt,
+        options: &CompactOptions<'_>,
+    ) -> Option<(Value, Usage)> {
+        if std::env::var("VENGEANCE_NATIVE_COMPACTION").as_deref() == Ok("off")
+            || !pa_ai::native_compaction::supported(&options.model)
+        {
+            return None;
+        }
+        let state = self.agent.state().await;
+        let context = Context {
+            system_prompt: Some(state.system_prompt),
+            messages: super::messages::convert_to_llm(&attempt.native_messages)
+                .iter()
+                .filter_map(super::provider_adapter::json_round_trip)
+                .collect(),
+            tools: Some(
+                state
+                    .tools
+                    .iter()
+                    .map(|tool| Tool {
+                        name: tool.name().to_string(),
+                        description: tool.description().to_string(),
+                        parameters: tool.parameters().clone(),
+                    })
+                    .collect(),
+            ),
+        };
+        let (session_id, service_tier) = {
+            let session = self.session.lock().await;
+            (
+                session.get_session_id().to_string(),
+                session.active_context().service_tier,
+            )
+        };
+        // Use the selected session model even when text summaries use an auxiliary model.
+        let headers = match options.auxiliary {
+            Some(auxiliary) => {
+                let auxiliary = auxiliary.clone();
+                let model = options.model.clone();
+                let api_key = options.api_key.clone();
+                tokio::task::spawn_blocking(move || {
+                    super::auxiliary_model::session_fallback_with_headers(
+                        &auxiliary, &model, api_key,
+                    )
+                })
+                .await
+                .ok()?
+                .headers
+            }
+            None => options.model.headers.clone(),
+        };
+        let cancel = tokio_util::sync::CancellationToken::new();
+        let _cancel_on_drop = cancel.clone().drop_guard();
+        let request = pa_ai::native_compaction::compact(
+            &options.model,
+            &context,
+            SimpleStreamOptions {
+                base: StreamOptions {
+                    api_key: options.api_key.clone(),
+                    headers: headers.map(|headers| headers.into_iter().collect()),
+                    signal: Some(cancel),
+                    session_id: Some(session_id),
+                    service_tier,
+                    ..Default::default()
+                },
+                reasoning: Some(super::provider_adapter::model_thinking_level(
+                    state.thinking_level,
+                )),
+                ..Default::default()
+            },
+        );
+        match options.abort {
+            Some(signal) => pa_agent::abort::race_with_abort(request, signal)
+                .await
+                .ok()
+                .flatten(),
+            None => request.await,
+        }
+    }
+}
+
+pub(super) fn attach(prepared: &mut PreparedCompaction, checkpoint: Option<(Value, Usage)>) {
+    let Some((checkpoint, usage)) = checkpoint else {
+        return;
+    };
+    let details = prepared
+        .entry
+        .details
+        .get_or_insert_with(|| serde_json::json!({}));
+    details["nativeCompaction"] = checkpoint;
+    let total = prepared.result.usage.get_or_insert_with(Usage::default);
+    super::compaction_exec::add_assistant_usage(total, &usage);
+    prepared.entry.usage = Some(*total);
+}
