     }
 
     fn creation_model(&self) -> Option<(String, String)> {
-        let model = self.resolve_registry_model().ok()?;
+        let model = self.resolve_model().ok()?;
+        // The creation prefix selects this session's model. Other workers may
+        // change global defaults while this worker keeps its live provider target.
+        let mut selection = self.selection.write().expect("model selection lock");
+        if selection.model.is_none() {
+            selection.provider = Some(model.provider.clone());
+            selection.model = Some(model.id.clone());
+        }
         Some((model.provider.clone(), model.id))
     }
 
