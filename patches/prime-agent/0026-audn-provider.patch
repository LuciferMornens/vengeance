+        let model = get_model("audn", "necromicon").expect("compiled");
+        assert_eq!(
+            crate::models::get_supported_thinking_levels(model),
+            vec![Low, High, Max]
+        );
+        assert_eq!(
+            crate::models::clamp_thinking_level(model, Off),
+            Low,
+            "reasoning cannot be turned off, so a saved Off moves up"
+        );
