@@ -0,0 +1,204 @@
+use super::*;
+use pa_agent::scripted::ScriptedProvider;
+
+const GLOBAL_CONTEXT: &str = "GLOBAL_CONTEXT_SENTINEL";
+const PROJECT_CONTEXT: &str = "PROJECT_CONTEXT_SENTINEL";
+const PROJECT_FOUNDATION: &str = "PROJECT_FOUNDATION_SENTINEL";
+const GLOBAL_APPEND: &str = "GLOBAL_APPEND_SENTINEL";
+const PROJECT_APPEND: &str = "PROJECT_APPEND_SENTINEL";
+const RAW_MARKDOWN: &str = "  # Extra instructions\n\n- Keep this bullet.\n- Keep this bullet.\n  ";
+
+struct PromptCase {
+    custom_system: bool,
+    global: Option<&'static str>,
+    project: Option<&'static str>,
+    explicit: Vec<String>,
+    expected: &'static str,
+}
+
+async fn assert_prompt_case(case: PromptCase) {
+    let temporary = tempfile::tempdir().unwrap();
+    let cwd = temporary.path().join("project");
+    let agent_dir = temporary.path().join("agent");
+    let project_config = cwd.join(".prime").join("agent");
+    std::fs::create_dir_all(&project_config).unwrap();
+    std::fs::create_dir_all(&agent_dir).unwrap();
+    std::fs::write(cwd.join("AGENTS.md"), PROJECT_CONTEXT).unwrap();
+    std::fs::write(agent_dir.join("AGENTS.md"), GLOBAL_CONTEXT).unwrap();
+    if case.custom_system {
+        std::fs::write(project_config.join("SYSTEM.md"), PROJECT_FOUNDATION).unwrap();
+    }
+    if let Some(text) = case.global {
+        std::fs::write(agent_dir.join("APPEND_SYSTEM.md"), text).unwrap();
+    }
+    if let Some(text) = case.project {
+        std::fs::write(project_config.join("APPEND_SYSTEM.md"), text).unwrap();
+    }
+
+    let model: pa_types::ai::Model = serde_json::from_value(serde_json::json!({
+        "id": "initial", "name": "Initial", "provider": "test", "api": "test",
+        "baseUrl": "http://localhost", "reasoning": false, "input": ["text"],
+        "contextWindow": 100_000, "maxTokens": 100,
+        "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
+    }))
+    .unwrap();
+    let wire: pa_agent::types::Model =
+        super::super::provider_adapter::json_round_trip(&model).unwrap();
+    let provider = Arc::new(ScriptedProvider::new(wire.clone()));
+    provider.push_text_turn("ok");
+    let engine = create_session(SessionEngineConfig {
+        cwd,
+        agent_dir,
+        model: Some(wire),
+        model_info: Some(model.clone()),
+        stream_fn: Some(provider.stream_fn()),
+        prompt_guidelines: case.explicit,
+        prewarm_ipython_kernel: Some(false),
+        ..Default::default()
+    })
+    .await
+    .unwrap();
+    let initial_prompt = engine.system_prompt();
+    assert!(initial_prompt.contains(GLOBAL_CONTEXT));
+    assert!(initial_prompt.contains(PROJECT_CONTEXT));
+    assert!(initial_prompt.starts_with(if case.custom_system {
+        PROJECT_FOUNDATION
+    } else {
+        "# prime-agent harness"
+    }));
+    for content in [case.global, case.project].into_iter().flatten() {
+        if !content.is_empty() && content != case.expected {
+            assert!(
+                !initial_prompt.contains(content),
+                "an overridden file leaked into the prompt"
+            );
+        }
+    }
+    if case.expected.is_empty() {
+        assert!(!initial_prompt.contains(GLOBAL_APPEND));
+        assert!(!initial_prompt.contains(PROJECT_APPEND));
+    } else {
+        assert!(initial_prompt.ends_with(case.expected));
+        assert_eq!(initial_prompt.matches(case.expected).count(), 1);
+    }
+
+    let mut selected = model;
+    selected.id = "selected".to_string();
+    selected.input = vec![
+        pa_types::ai::ModelInput::Text,
+        pa_types::ai::ModelInput::Image,
+    ];
+    engine
+        .set_model_and_thinking_level(&selected, ThinkingLevel::Off)
+        .await
+        .unwrap();
+    engine.prompt("ok", PromptOptions::default()).await.unwrap();
+    engine.session.agent().wait_for_idle().await;
+    let calls = provider.calls();
+    assert_eq!(calls.len(), 1);
+    let sent = calls[0].system_prompt.as_deref().unwrap();
+    assert_eq!(sent, engine.system_prompt());
+    if !case.expected.is_empty() {
+        assert!(sent.ends_with(case.expected));
+        assert_eq!(sent.matches(case.expected).count(), 1);
+    }
+}
+
+#[tokio::test]
+async fn append_system_global_pairs_with_project_foundation_and_keeps_raw_markdown() {
+    assert_prompt_case(PromptCase {
+        custom_system: true,
+        global: Some(RAW_MARKDOWN),
+        project: None,
+        explicit: vec![],
+        expected: RAW_MARKDOWN,
+    })
+    .await;
+}
+
+#[tokio::test]
+async fn append_system_project_replaces_global() {
+    assert_prompt_case(PromptCase {
+        custom_system: true,
+        global: Some(GLOBAL_APPEND),
+        project: Some(PROJECT_APPEND),
+        explicit: vec![],
+        expected: PROJECT_APPEND,
+    })
+    .await;
+}
+
+#[tokio::test]
+async fn append_system_explicit_sources_replace_both_files() {
+    assert_prompt_case(PromptCase {
+        custom_system: true,
+        global: Some(GLOBAL_APPEND),
+        project: Some(PROJECT_APPEND),
+        explicit: vec!["FIRST_EXPLICIT".into(), "SECOND_EXPLICIT".into()],
+        expected: "FIRST_EXPLICIT\n\nSECOND_EXPLICIT",
+    })
+    .await;
+}
+
+#[tokio::test]
+async fn append_system_explicit_file_is_resolved_by_native_resources() {
+    let temporary = tempfile::tempdir().unwrap();
+    let path = temporary.path().join("explicit.md");
+    std::fs::write(&path, RAW_MARKDOWN).unwrap();
+    assert_prompt_case(PromptCase {
+        custom_system: true,
+        global: Some(GLOBAL_APPEND),
+        project: Some(PROJECT_APPEND),
+        explicit: vec![path.display().to_string()],
+        expected: RAW_MARKDOWN,
+    })
+    .await;
+}
+
+#[tokio::test]
+async fn append_system_empty_project_suppresses_global() {
+    assert_prompt_case(PromptCase {
+        custom_system: true,
+        global: Some(GLOBAL_APPEND),
+        project: Some(""),
+        explicit: vec![],
+        expected: "",
+    })
+    .await;
+}
+
+#[tokio::test]
+async fn append_system_empty_explicit_suppresses_both_files() {
+    assert_prompt_case(PromptCase {
+        custom_system: true,
+        global: Some(GLOBAL_APPEND),
+        project: Some(PROJECT_APPEND),
+        explicit: vec![String::new()],
+        expected: "",
+    })
+    .await;
+}
+
+#[tokio::test]
+async fn append_system_whitespace_is_kept_without_falling_back() {
+    assert_prompt_case(PromptCase {
+        custom_system: true,
+        global: Some(GLOBAL_APPEND),
+        project: Some(" \n  "),
+        explicit: vec![],
+        expected: " \n  ",
+    })
+    .await;
+}
+
+#[tokio::test]
+async fn append_system_default_foundation_layers_remain_native() {
+    assert_prompt_case(PromptCase {
+        custom_system: false,
+        global: Some(GLOBAL_APPEND),
+        project: None,
+        explicit: vec![],
+        expected: GLOBAL_APPEND,
+    })
+    .await;
+}
