diff --git a/crates/pa-core/tests/windows_edit_tool.rs b/crates/pa-core/tests/windows_edit_tool.rs
new file mode 100644
index 0000000..1f30026
--- /dev/null
+++ b/crates/pa-core/tests/windows_edit_tool.rs
@@ -0,0 +1,54 @@
+#![cfg(windows)]
+
+use pa_core::create_edit_tool_definition;
+use serde_json::json;
+
+#[tokio::test]
+async fn editing_a_directory_reports_the_file_type_without_changing_its_contents() {
+    let fixture = tempfile::tempdir().unwrap();
+    let directory = fixture.path().join("directory");
+    std::fs::create_dir(&directory).unwrap();
+    std::fs::write(directory.join("child.txt"), "untouched").unwrap();
+    let tool = create_edit_tool_definition(fixture.path().to_str().unwrap());
+    let error = (tool.execute)(
+        "edit-directory",
+        json!({"path": "directory", "edits": [{"oldText": "a", "newText": "b"}]}),
+        None,
+        None,
+    )
+    .await
+    .unwrap_err();
+
+    assert_eq!(
+        error.to_string(),
+        "EISDIR: illegal operation on a directory, read"
+    );
+    assert_eq!(
+        std::fs::read_to_string(directory.join("child.txt")).unwrap(),
+        "untouched"
+    );
+}
+
+#[tokio::test]
+async fn editing_a_file_under_a_missing_parent_reports_not_found() {
+    let fixture = tempfile::tempdir().unwrap();
+    let path = std::path::Path::new("missing").join("file.txt");
+    let tool = create_edit_tool_definition(fixture.path().to_str().unwrap());
+    let error = (tool.execute)(
+        "edit-missing-parent",
+        json!({"path": path, "edits": [{"oldText": "a", "newText": "b"}]}),
+        None,
+        None,
+    )
+    .await
+    .unwrap_err();
+
+    assert_eq!(
+        error.to_string(),
+        format!(
+            "Could not edit file: {}. Error code: ENOENT.",
+            path.display()
+        )
+    );
+    assert!(!fixture.path().join(path).exists());
+}
