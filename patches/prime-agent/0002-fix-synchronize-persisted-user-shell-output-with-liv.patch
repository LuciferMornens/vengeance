@@ -0,0 +1,512 @@
+use super::*;
+use pa_ai::faux::{
+    faux_assistant_text_message, register_faux_provider, FauxAssistantMessageOptions,
+    FauxResponseStep, RegisterFauxProviderOptions,
+};
+
+const INCLUDED_OUTPUT: &str = "included-bash-result";
+const EXCLUDED_OUTPUT: &str = "excluded-bash-result";
+const TRANSIENT_OUTPUT: &str = "transient-bash-result";
+const RETIRED_OUTPUT: &str = "retired-bash-result";
+
+#[derive(Clone, Copy)]
+enum BashMode {
+    Awaited,
+    Streamed,
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum BuildTiming {
+    Cached,
+    Cold,
+    ColdNoSession,
+    AfterTurn,
+    Replacement,
+    CopiedReplacement,
+    SameFileReplacement,
+    FailedReplacement,
+    DuringCompaction,
+}
+
+struct SessionCleanup<'a> {
+    runtime: &'a tokio::runtime::Runtime,
+    worker: &'a Worker,
+}
+
+impl Drop for SessionCleanup<'_> {
+    fn drop(&mut self) {
+        self.runtime.block_on(async {
+            self.worker.user_bash.abort_and_settle().await;
+            if let Some(engine) = &self.worker.agent_engine {
+                engine.dispose_kernel().await;
+            }
+        });
+    }
+}
+
+async fn bash(worker: &Worker, mode: BashMode, payload: Value) {
+    let command = match mode {
+        BashMode::Awaited => "execute_bash_and_wait",
+        BashMode::Streamed => "execute_bash",
+    };
+    let response = worker.dispatch(command, &payload).await;
+    assert!(response.success, "{command}: {response:?}");
+    tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        while worker.user_bash.is_running() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("bash completion");
+    if payload["transient"] != true {
+        let core = worker.core.lock().unwrap();
+        let store = core.store.as_ref().unwrap();
+        assert!(
+            store.entries().iter().any(|entry| {
+                entry.fields.get("message").is_some_and(|message| {
+                    message["role"] == "bashExecution" && message["command"] == payload["command"]
+                })
+            }),
+            "bash must persist successfully before checking live context: {payload}"
+        );
+    }
+}
+
+async fn replace_during_bash(worker: &Worker, directory: &std::path::Path, timing: BuildTiming) {
+    let payload = json!({"command":
+        "touch bash-started; while [ ! -f bash-finish ]; do sleep 0.01; done; printf 'retired-%s' bash-result"
+    });
+    let command = worker.dispatch("execute_bash_and_wait", &payload);
+    let replacement = async {
+        tokio::time::timeout(std::time::Duration::from_secs(10), async {
+            while !directory.join("bash-started").exists() {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("shell readiness");
+        let source = worker
+            .core
+            .lock()
+            .unwrap()
+            .store
+            .as_ref()
+            .unwrap()
+            .path
+            .clone();
+        let target = if timing == BuildTiming::CopiedReplacement {
+            let target = directory.join("sessions").join("copied.jsonl");
+            std::fs::copy(&source, &target).unwrap();
+            target
+        } else if timing == BuildTiming::FailedReplacement {
+            directory.join("missing.jsonl")
+        } else {
+            source
+        };
+        let response = worker
+            .dispatch("switch_session", &json!({"sessionPath": target}))
+            .await;
+        std::fs::write(directory.join("bash-finish"), "done").unwrap();
+        assert_eq!(
+            response.success,
+            timing != BuildTiming::FailedReplacement,
+            "replacement: {response:?}"
+        );
+    };
+    let (response, ()) = tokio::join!(command, replacement);
+    if timing == BuildTiming::FailedReplacement {
+        assert!(response.success, "bash after failed prepare: {response:?}");
+    } else {
+        assert_eq!(
+            response.error.as_deref(),
+            Some("Session changed before the bash command completed")
+        );
+    }
+}
+
+fn check_bash_context(mode: BashMode, timing: BuildTiming) {
+    let _faux = crate::agent_engine::FAUX_TEST_LOCK
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let directory = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(directory.path().join("agent")).unwrap();
+    std::fs::create_dir_all(directory.path().join("sessions")).unwrap();
+    std::fs::write(
+        directory.path().join("agent").join("settings.json"),
+        json!({
+            "defaultProvider": "faux", "defaultModel": "faux-1",
+            "compaction": {"enabled": false, "keepRecentTokens": 1},
+        })
+        .to_string(),
+    )
+    .unwrap();
+    std::fs::write(
+        directory.path().join("agent").join("models.json"),
+        json!({"providers": {"faux": {
+            "api": "faux", "baseUrl": "http://127.0.0.1:0", "apiKey": "test-only",
+            "models": [{"id": "faux-1", "name": "Faux Model", "contextWindow": 128_000,
+                "maxTokens": 16_384}],
+        }}})
+        .to_string(),
+    )
+    .unwrap();
+    let runtime = tokio::runtime::Runtime::new().unwrap();
+    let worker = runtime.block_on(async {
+        let worker = Worker::new(
+            crate::worker::WorkerConfig {
+                socket_path: directory.path().join("worker.sock"),
+                supervisor_socket_path: std::path::PathBuf::new(),
+                token: "token".to_string(),
+                worker_instance_id: String::new(),
+                active_session_id: "bash-context".to_string(),
+                agent_dir: directory.path().join("agent"),
+                recovery_journal_path: directory.path().join("recovery.jsonl"),
+                telemetry_disabled: Some(true),
+                script: Some(json!({"engine": "faux", "responses": ["ok"]})),
+            },
+            None,
+        );
+        let response = worker
+            .dispatch(
+                "create",
+                &json!({
+                    "cwd": directory.path(),
+                    "sessionDir": directory.path().join("sessions"),
+                    // Child depth disables kernel prewarm; these tests only run user bash.
+                    "rlmDepth": 1,
+                    "noSession": timing == BuildTiming::ColdNoSession,
+                    "provider": "faux",
+                    "model": "faux-1",
+                    "apiKey": "test-only",
+                }),
+            )
+            .await;
+        assert!(response.success, "create: {response:?}");
+        if !matches!(timing, BuildTiming::Cold | BuildTiming::ColdNoSession) {
+            let response = worker.dispatch("get_commands", &json!({})).await;
+            assert!(response.success, "get_commands: {response:?}");
+        }
+        worker
+    });
+    let _cleanup = SessionCleanup {
+        runtime: &runtime,
+        worker: &worker,
+    };
+    // Resolve before registering the observer: faux model resolution installs its script.
+    worker
+        .agent_engine
+        .as_ref()
+        .unwrap()
+        .resolve_model()
+        .unwrap();
+    let requests = Arc::new(std::sync::Mutex::new(Vec::new()));
+    let captured = Arc::clone(&requests);
+    let hold_summary = Arc::new(AtomicBool::new(false));
+    let provider_hold = Arc::clone(&hold_summary);
+    let summary_started = Arc::new(tokio::sync::Notify::new());
+    let provider_started = Arc::clone(&summary_started);
+    let (release_summary, summary_release) = std::sync::mpsc::channel();
+    let summary_release = std::sync::Mutex::new(summary_release);
+    let registration = register_faux_provider(RegisterFauxProviderOptions {
+        api: Some("faux".to_string()),
+        ..Default::default()
+    });
+    registration.set_responses(vec![FauxResponseStep::Factory(Arc::new(
+        move |context, _, _, _| {
+            captured
+                .lock()
+                .unwrap()
+                .push(serde_json::to_string(&context.messages).unwrap());
+            if provider_hold.swap(false, Ordering::SeqCst) {
+                provider_started.notify_one();
+                summary_release
+                    .lock()
+                    .unwrap()
+                    .recv_timeout(std::time::Duration::from_secs(10))
+                    .map_err(|error| error.to_string())?;
+            }
+            Ok(faux_assistant_text_message(
+                "ok",
+                FauxAssistantMessageOptions::default(),
+            ))
+        },
+    ))]);
+    registration.set_repeat_last_response(true);
+
+    if matches!(
+        timing,
+        BuildTiming::CopiedReplacement
+            | BuildTiming::SameFileReplacement
+            | BuildTiming::FailedReplacement
+    ) {
+        runtime.block_on(replace_during_bash(&worker, directory.path(), timing));
+    }
+
+    if matches!(
+        timing,
+        BuildTiming::AfterTurn | BuildTiming::DuringCompaction
+    ) {
+        runtime.block_on(async {
+            let response = worker
+                .dispatch("prompt_and_wait", &json!({"message": "prior-turn-marker"}))
+                .await;
+            assert!(response.success, "prior prompt: {response:?}");
+        });
+        assert_eq!(requests.lock().unwrap().len(), 1);
+        requests.lock().unwrap().clear();
+    }
+
+    if timing == BuildTiming::DuringCompaction {
+        hold_summary.store(true, Ordering::SeqCst);
+        runtime.block_on(async {
+            let payload = json!({});
+            let compaction = worker.dispatch("compact", &payload);
+            let overlapping_bash = async {
+                tokio::time::timeout(
+                    std::time::Duration::from_secs(10),
+                    summary_started.notified(),
+                )
+                .await
+                .expect("summarizer readiness");
+                let release_after_persist = async {
+                    tokio::time::timeout(std::time::Duration::from_secs(10), async {
+                        loop {
+                            let persisted = {
+                                let core = worker.core.lock().unwrap();
+                                core.store.as_ref().unwrap().entries().iter().any(|entry| {
+                                    entry
+                                        .fields
+                                        .get("message")
+                                        .is_some_and(|message| message["output"] == INCLUDED_OUTPUT)
+                                })
+                            };
+                            if persisted {
+                                break;
+                            }
+                            tokio::task::yield_now().await;
+                        }
+                    })
+                    .await
+                    .expect("bash persisted while summarizer is held");
+                    let state = worker.dispatch("get_connection_state", &json!({})).await;
+                    assert_eq!(state.data.unwrap()["isBashRunning"], true);
+                    release_summary.send(()).unwrap();
+                };
+                tokio::join!(
+                    bash(
+                        &worker,
+                        mode,
+                        json!({"command": "printf 'included-%s' bash-result"})
+                    ),
+                    release_after_persist,
+                );
+            };
+            let (response, ()) = tokio::join!(compaction, overlapping_bash);
+            assert!(response.success, "held compaction: {response:?}");
+        });
+        requests.lock().unwrap().clear();
+    }
+
+    runtime.block_on(async {
+        if timing != BuildTiming::DuringCompaction {
+            bash(
+                &worker,
+                mode,
+                json!({"command": "printf 'included-%s' bash-result"}),
+            )
+            .await;
+        }
+        bash(
+            &worker,
+            BashMode::Streamed,
+            json!({"command": "printf 'excluded-%s' bash-result", "excludeFromContext": true}),
+        )
+        .await;
+        bash(
+            &worker,
+            BashMode::Streamed,
+            json!({"command": "printf 'transient-%s' bash-result", "transient": true}),
+        )
+        .await;
+    });
+    runtime.block_on(async {
+        for turn in 0..2 {
+            if timing == BuildTiming::Replacement && turn == 1 {
+                let path = worker
+                    .core
+                    .lock()
+                    .unwrap()
+                    .store
+                    .as_ref()
+                    .unwrap()
+                    .path
+                    .clone();
+                let response = worker
+                    .dispatch("switch_session", &json!({"sessionPath": path}))
+                    .await;
+                assert!(response.success, "replacement: {response:?}");
+            }
+            let model = worker
+                .agent_engine
+                .as_ref()
+                .unwrap()
+                .resolve_model()
+                .unwrap();
+            assert_eq!(
+                (model.provider.as_str(), model.api.as_str()),
+                ("faux", "faux")
+            );
+            let response = worker
+                .dispatch(
+                    "prompt_and_wait",
+                    &json!({
+                        "message": "acknowledge", "streamingBehavior": "followUp",
+                    }),
+                )
+                .await;
+            assert!(response.success, "prompt: {response:?}");
+        }
+    });
+    {
+        let requests = requests.lock().unwrap();
+        assert_eq!(requests.len(), 2, "two actual provider requests");
+        for request in requests.iter() {
+            assert_eq!(request.matches(INCLUDED_OUTPUT).count(), 1, "{request}");
+            assert!(!request.contains(EXCLUDED_OUTPUT), "{request}");
+            assert!(!request.contains(TRANSIENT_OUTPUT), "{request}");
+            assert_eq!(
+                request.matches(RETIRED_OUTPUT).count(),
+                usize::from(timing == BuildTiming::FailedReplacement),
+                "{request}"
+            );
+        }
+    }
+    let durable = worker
+        .core
+        .lock()
+        .unwrap()
+        .store
+        .as_ref()
+        .unwrap()
+        .branch_file_entries();
+    let (built, context) = runtime.block_on(async {
+        let engine = worker.agent_engine.as_ref().unwrap();
+        let session = engine.session.lock().await;
+        let persistence = session.as_ref().unwrap().session.shared_persistence();
+        let manager = persistence.lock().await;
+        (
+            manager.retained_entries().to_vec(),
+            manager.active_context(),
+        )
+    });
+    let bash_entries = |entries: Vec<pa_types::session::FileEntry>| {
+        entries
+            .into_iter()
+            .filter(|entry| {
+                matches!(
+                    entry,
+                    pa_types::session::FileEntry::Message {
+                        message: pa_types::session::AgentMessage::BashExecution(_),
+                        ..
+                    }
+                )
+            })
+            .map(|entry| {
+                let mut value = serde_json::to_value(entry).unwrap();
+                value.as_object_mut().unwrap().remove("parentId");
+                value
+            })
+            .collect::<Vec<_>>()
+    };
+    let durable = bash_entries(durable);
+    assert_eq!(
+        durable.len(),
+        2 + usize::from(timing == BuildTiming::FailedReplacement),
+        "excluded rows remain durable; transient rows do not"
+    );
+    assert_eq!(
+        bash_entries(built),
+        durable,
+        "compaction sees the native entry IDs"
+    );
+    if timing == BuildTiming::AfterTurn {
+        let context = serde_json::to_string(&context.messages).unwrap();
+        assert!(context.contains("prior-turn-marker"), "{context}");
+        runtime.block_on(async {
+            let model = worker
+                .agent_engine
+                .as_ref()
+                .unwrap()
+                .resolve_model()
+                .unwrap();
+            assert_eq!(
+                (model.provider.as_str(), model.api.as_str()),
+                ("faux", "faux")
+            );
+            let response = worker.dispatch("compact", &json!({})).await;
+            assert!(response.success, "compaction: {response:?}");
+        });
+        let requests = requests.lock().unwrap();
+        assert!(requests.len() > 2, "compaction must call the provider");
+        assert!(
+            requests[2..]
+                .iter()
+                .any(|request| request.contains(INCLUDED_OUTPUT)),
+            "the summarizer must receive the bash result: {requests:?}"
+        );
+        for request in &requests[2..] {
+            assert!(!request.contains(EXCLUDED_OUTPUT), "{request}");
+            assert!(!request.contains(TRANSIENT_OUTPUT), "{request}");
+        }
+    }
+}
+
+#[test]
+fn cached_agent_receives_awaited_bash_before_next_provider_request() {
+    check_bash_context(BashMode::Awaited, BuildTiming::Cached);
+}
+
+#[test]
+fn cached_agent_receives_streamed_bash_before_next_provider_request() {
+    check_bash_context(BashMode::Streamed, BuildTiming::Cached);
+}
+
+#[test]
+fn first_agent_build_receives_bash_exactly_once() {
+    check_bash_context(BashMode::Awaited, BuildTiming::Cold);
+}
+
+#[test]
+fn bash_after_a_model_turn_preserves_compaction_history() {
+    check_bash_context(BashMode::Awaited, BuildTiming::AfterTurn);
+}
+
+#[test]
+fn bash_is_not_duplicated_when_the_session_is_replaced() {
+    check_bash_context(BashMode::Streamed, BuildTiming::Replacement);
+}
+
+#[test]
+fn first_in_memory_agent_build_receives_bash_exactly_once() {
+    check_bash_context(BashMode::Awaited, BuildTiming::ColdNoSession);
+}
+
+#[test]
+fn bash_completion_cannot_enter_a_copied_session_with_the_same_id() {
+    check_bash_context(BashMode::Awaited, BuildTiming::CopiedReplacement);
+}
+
+#[test]
+fn bash_completion_cannot_enter_a_replacement_of_the_same_file() {
+    check_bash_context(BashMode::Awaited, BuildTiming::SameFileReplacement);
+}
+
+#[test]
+fn failed_replacement_preparation_keeps_the_current_bash_valid() {
+    check_bash_context(BashMode::Awaited, BuildTiming::FailedReplacement);
+}
+
+#[test]
+fn bash_completed_during_compaction_reaches_the_next_provider_request() {
+    check_bash_context(BashMode::Awaited, BuildTiming::DuringCompaction);
+}
