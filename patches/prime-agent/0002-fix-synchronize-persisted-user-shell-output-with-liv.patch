+    let directory = tempfile::tempdir().unwrap();
+    let events = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+    let release = std::sync::Arc::new(tokio::sync::Notify::new());
+    let worker = recording_worker(
