new file mode 100644
index 000000000..db560bf11
--- /dev/null
+++ b/crates/pa-daemon/src/user_bash/persistence.rs
@@ -0,0 +1,77 @@
+use super::{BashResult, UserBash};
+use crate::agent_engine::AgentSessionEngine;
+use crate::worker::SessionCore;
+use anyhow::Context;
+use pa_types::session::FileEntry;
+use serde_json::{json, Value};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex};
+
+pub(crate) struct BashContext {
+    session_id: String,
+    generation: usize,
+    current_generation: Arc<AtomicUsize>,
+}
+
+impl UserBash {
+    pub(super) fn context(&self, session_id: String) -> BashContext {
+        BashContext {
+            session_id,
+            generation: self.context_generation.load(Ordering::SeqCst),
+            current_generation: Arc::clone(&self.context_generation),
+        }
+    }
+}
+
+pub(super) async fn record_bash_result(
+    core: &Arc<Mutex<SessionCore>>,
+    engine: Option<&AgentSessionEngine>,
+    context: &BashContext,
+    command: &str,
+    result: &BashResult,
+    exclude_from_context: bool,
+) -> anyhow::Result<()> {
+    let mut row = json!({
+        "role": "bashExecution",
+        "command": command,
+        "output": result.output,
+        "cancelled": result.cancelled,
+        "truncated": result.truncated,
+        "timestamp": crate::util::now_ms(),
+    });
+    if let Some(exit_code) = result.exit_code {
+        row["exitCode"] = json!(exit_code);
+    }
+    if let Some(path) = &result.full_output_path {
+        row["fullOutputPath"] = json!(path);
+    }
+    if exclude_from_context {
+        row["excludeFromContext"] = json!(true);
+    }
+    match engine {
+        Some(engine) => engine.record_bash_message(core, context, row).await,
+        None => persist_bash_message(&mut core.lock().unwrap(), context, row).map(|_| ()),
+    }
+}
+
+pub(crate) fn persist_bash_message(
+    core: &mut SessionCore,
+    context: &BashContext,
+    row: Value,
+) -> anyhow::Result<FileEntry> {
+    let store = core
+        .store
+        .as_mut()
+        .context("Session is no longer available")?;
+    anyhow::ensure!(
+        store.header.id == context.session_id
+            && context.current_generation.load(Ordering::SeqCst) == context.generation,
+        "Session changed before the bash command completed"
+    );
+    let fields = serde_json::Map::from_iter([("message".to_string(), row)]);
+    let entry_id = store.persist_entry("message", Value::Object(fields))?;
+    let entry = store
+        .entry(&entry_id)
+        .context("Persisted bash entry is missing")?;
+    Ok(serde_json::from_value(serde_json::to_value(entry)?)?)
+}
