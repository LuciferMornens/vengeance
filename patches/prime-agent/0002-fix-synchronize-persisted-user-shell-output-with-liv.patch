@@ -0,0 +1,34 @@
+use super::AgentSessionEngine;
+use crate::user_bash::BashContext;
+use crate::worker::SessionCore;
+use serde_json::Value;
+use std::sync::{Arc, Mutex};
+
+impl AgentSessionEngine {
+    pub(crate) async fn record_bash_message(
+        &self,
+        core: &Arc<Mutex<SessionCore>>,
+        context: &BashContext,
+        row: Value,
+    ) -> anyhow::Result<()> {
+        // The build's file snapshot and this append must not overlap: the row would
+        // otherwise reach both the restored context and the live append.
+        let _build = self.session_build.lock().await;
+        let built = self.session.lock().await;
+        let (entry, branch) = {
+            let mut core = core.lock().unwrap();
+            let entry = crate::user_bash::persist_bash_message(&mut core, context, row)?;
+            let branch = built
+                .is_none()
+                .then(|| core.store.as_ref().unwrap().branch_file_entries());
+            (entry, branch)
+        };
+        if let Some(built) = built.as_ref() {
+            built.session.ingest_persisted_bash(entry).await?;
+        } else if let Some(branch) = branch {
+            // In-memory sessions have no file for the first build to reopen.
+            *self.pending_branch.lock().unwrap() = Some(branch);
+        }
+        Ok(())
+    }
+}
