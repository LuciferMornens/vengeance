+use super::*;
+use pa_ai::faux::{
+    faux_assistant_text_message, register_faux_provider, FauxAssistantMessageOptions,
+    FauxResponseStep, RegisterFauxProviderOptions,
+};
+
+const INCLUDED_OUTPUT: &str = "included-bash-result";
+const EXCLUDED_OUTPUT: &str = "excluded-bash-result";
+const TRANSIENT_OUTPUT: &str = "transient-bash-result";
+const RETIRED_OUTPUT: &str = "retired-bash-result";
+
+#[derive(Clone, Copy)]
+enum BashMode {
+    Awaited,
+    Streamed,
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum BuildTiming {
+    Cached,
+    Cold,
+    ColdNoSession,
+    AfterTurn,
+    Replacement,
+    CopiedReplacement,
+    SameFileReplacement,
+    FailedReplacement,
+    DuringCompaction,
+}
+
+struct SessionCleanup<'a> {
+    runtime: &'a tokio::runtime::Runtime,
+    worker: &'a Worker,
+}
+
+impl Drop for SessionCleanup<'_> {
+    fn drop(&mut self) {
+        self.runtime.block_on(async {
+            self.worker.user_bash.abort().await;
+            if let Some(engine) = &self.worker.agent_engine {
+                engine.dispose_kernel().await;
+            }
+        });
+    }
+}
+
+async fn bash(worker: &Worker, mode: BashMode, payload: Value) {
+    let command = match mode {
+        BashMode::Awaited => "execute_bash_and_wait",
+        BashMode::Streamed => "execute_bash",
+    };
+    let response = worker.dispatch(command, &payload).await;
+    assert!(response.success, "{command}: {response:?}");
+    tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        while worker.user_bash.is_running() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("bash completion");
+    if payload["transient"] != true {
+        let core = worker.core.lock().unwrap();
+        let store = core.store.as_ref().unwrap();
+        assert!(
+            store.entries().iter().any(|entry| {
+                entry.fields.get("message").is_some_and(|message| {
+                    message["role"] == "bashExecution" && message["command"] == payload["command"]
+                })
+            }),
+            "bash must persist successfully before checking live context: {payload}"
+        );
+    }
+}
+
+async fn replace_during_bash(worker: &Worker, directory: &std::path::Path, timing: BuildTiming) {
+    let payload = json!({"command":
+        "touch bash-started; while [ ! -f bash-finish ]; do sleep 0.01; done; printf 'retired-%s' bash-result"
+    });
+    let command = worker.dispatch("execute_bash_and_wait", &payload);
+    let replacement = async {
+        tokio::time::timeout(std::time::Duration::from_secs(10), async {
+            while !directory.join("bash-started").exists() {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("shell readiness");
+        let source = worker
+            .core
+            .lock()
+            .unwrap()
+            .store
+            .as_ref()
+            .unwrap()
+            .path
+            .clone();
+        let target = if timing == BuildTiming::CopiedReplacement {
+            let target = directory.join("sessions").join("copied.jsonl");
+            std::fs::copy(&source, &target).unwrap();
+            target
+        } else if timing == BuildTiming::FailedReplacement {
+            directory.join("missing.jsonl")
+        } else {
+            source
+        };
+        let response = worker
+            .dispatch("switch_session", &json!({"sessionPath": target}))
+            .await;
+        std::fs::write(directory.join("bash-finish"), "done").unwrap();
+        assert_eq!(
+            response.success,
+            timing != BuildTiming::FailedReplacement,
+            "replacement: {response:?}"
+        );
+    };
+    let (response, ()) = tokio::join!(command, replacement);
+    if timing == BuildTiming::FailedReplacement {
+        assert!(response.success, "bash after failed prepare: {response:?}");
+    } else {
+        assert_eq!(
+            response.error.as_deref(),
+            Some("Session changed before the bash command completed")
+        );
+    }
+}
+
+fn check_bash_context(mode: BashMode, timing: BuildTiming) {
+    let _faux = crate::agent_engine::FAUX_TEST_LOCK
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let directory = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(directory.path().join("agent")).unwrap();
+    std::fs::create_dir_all(directory.path().join("sessions")).unwrap();
+    std::fs::write(
+        directory.path().join("agent").join("settings.json"),
+        json!({
+            "defaultProvider": "faux", "defaultModel": "faux-1",
+            "compaction": {"enabled": false, "keepRecentTokens": 1},
+        })
+        .to_string(),
+    )
+    .unwrap();
+    std::fs::write(
+        directory.path().join("agent").join("models.json"),
