+    // Resolve before registering the observer: faux model resolution installs its script.
+    worker
+        .agent_engine
+        .as_ref()
+        .unwrap()
+        .resolve_model()
+        .unwrap();
+    let requests = Arc::new(std::sync::Mutex::new(Vec::new()));
+    let captured = Arc::clone(&requests);
+    let hold_summary = Arc::new(AtomicBool::new(false));
+    let provider_hold = Arc::clone(&hold_summary);
+    let summary_started = Arc::new(tokio::sync::Notify::new());
+    let provider_started = Arc::clone(&summary_started);
+    let (release_summary, summary_release) = std::sync::mpsc::channel();
+    let summary_release = std::sync::Mutex::new(summary_release);
+    let registration = register_faux_provider(RegisterFauxProviderOptions {
+        api: Some("faux".to_string()),
+        ..Default::default()
+    });
+    registration.set_responses(vec![FauxResponseStep::Factory(Arc::new(
+        move |context, _, _, _| {
