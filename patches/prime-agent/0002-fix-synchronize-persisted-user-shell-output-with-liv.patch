+            "api": "faux", "baseUrl": "http://127.0.0.1:0", "apiKey": "test-only",
+            "models": [{"id": "faux-1", "name": "Faux Model", "contextWindow": 128_000,
+                "maxTokens": 16_384}],
+        }}})
+        .to_string(),
+    )
+    .unwrap();
+    let runtime = tokio::runtime::Runtime::new().unwrap();
+    let worker = runtime.block_on(async {
+        let worker = Worker::new(
+            crate::worker::WorkerConfig {
+                socket_path: directory.path().join("worker.sock"),
+                supervisor_socket_path: std::path::PathBuf::new(),
+                token: "token".to_string(),
+                worker_instance_id: String::new(),
+                active_session_id: "bash-context".to_string(),
+                agent_dir: directory.path().join("agent"),
+                recovery_journal_path: directory.path().join("recovery.jsonl"),
+                telemetry_disabled: Some(true),
+                script: Some(json!({"engine": "faux", "responses": ["ok"]})),
+            },
+            None,
+        );
+        let response = worker
+            .dispatch(
+                "create",
+                &json!({
+                    "cwd": directory.path(),
+                    "sessionDir": directory.path().join("sessions"),
+                    // Child depth disables kernel prewarm; these tests only run user bash.
+                    "rlmDepth": 1,
+                    "noSession": timing == BuildTiming::ColdNoSession,
+                    "provider": "faux",
+                    "model": "faux-1",
+                    "apiKey": "test-only",
+                }),
+            )
+            .await;
+        assert!(response.success, "create: {response:?}");
+        if !matches!(timing, BuildTiming::Cold | BuildTiming::ColdNoSession) {
+            let response = worker.dispatch("get_commands", &json!({})).await;
+            assert!(response.success, "get_commands: {response:?}");
+        }
+        worker
