+            "create",
+            &json!({"noSession": true, "cwd": directory.path()}),
+        )
+        .await;
+    assert!(created.success, "{created:?}");
+    let target = written_session_file(directory.path(), "replacement.jsonl");
+    let payload = json!({"sessionPath": target, "cwdOverride": directory.path()});
+    let replacement = worker.dispatch("switch_session", &payload);
+    let admission = async {
+        tokio::time::timeout(std::time::Duration::from_secs(10), async {
+            while !events
+                .lock()
+                .unwrap()
+                .iter()
+                .any(|event| event.starts_with("restore-enter"))
+            {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
