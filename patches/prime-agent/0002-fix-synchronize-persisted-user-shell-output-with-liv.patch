+                .dispatch("prompt_and_wait", &json!({"message": "prior-turn-marker"}))
+                .await;
+            assert!(response.success, "prior prompt: {response:?}");
+        });
+        assert_eq!(requests.lock().unwrap().len(), 1);
+        requests.lock().unwrap().clear();
+    }
+
+    if timing == BuildTiming::DuringCompaction {
+        hold_summary.store(true, Ordering::SeqCst);
