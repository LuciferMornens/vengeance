@@ -0,0 +1,112 @@
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{mpsc, Arc, Mutex};
+use std::time::Duration;
+
+use super::{AuthCredential, AuthStorage, AuthStorageBackend, AuthStorageData, OAuthIntegration};
+use crate::auth::storage::InMemoryAuthStorageBackend;
+
+struct PausedWriteBackend {
+    inner: InMemoryAuthStorageBackend,
+    pause_next_write: AtomicBool,
+    write_started: mpsc::SyncSender<()>,
+    release_write: Mutex<mpsc::Receiver<()>>,
+}
+
+impl AuthStorageBackend for PausedWriteBackend {
+    fn read(&self) -> anyhow::Result<Option<String>> {
+        self.inner.read()
+    }
+
+    fn with_lock(
+        &self,
+        update: &mut dyn FnMut(Option<String>) -> anyhow::Result<((), Option<String>)>,
+    ) -> anyhow::Result<()> {
+        if self.pause_next_write.swap(false, Ordering::SeqCst) {
+            self.write_started.send(())?;
+            self.release_write
+                .lock()
+                .unwrap()
+                .recv_timeout(Duration::from_secs(5))?;
+        }
+        self.inner.with_lock(update)
+    }
+}
+
+#[derive(Default)]
+struct CountingRefresh {
+    calls: AtomicUsize,
+}
+
+impl OAuthIntegration for CountingRefresh {
+    fn api_key_for(&self, _provider: &str, credential: &AuthCredential) -> Option<String> {
+        match credential {
+            AuthCredential::Oauth { access, .. } => Some(access.clone()),
+            _ => None,
+        }
+    }
+
+    fn refresh(&self, provider: &str, credentials: &AuthStorageData) -> Option<AuthCredential> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        let mut credential = credentials.credential(provider)?;
+        if let AuthCredential::Oauth {
+            access, expires, ..
+        } = &mut credential
+        {
+            *access = "fresh-access".into();
+            *expires = i64::MAX;
+        }
+        Some(credential)
+    }
+}
+
+#[test]
+fn a_refresh_flight_covers_credential_persistence() {
+    const PROVIDER: &str = "write-boundary-refresh";
+    const SECOND_RESOLUTION_BOUND: Duration = Duration::from_secs(1);
+    const FIRST_WRITE_BOUND: Duration = Duration::from_secs(3);
+    let inner = InMemoryAuthStorageBackend::default();
+    let expired = serde_json::json!({
+        (PROVIDER): {
+            "type": "oauth", "access": "expired-access", "refresh": "single-use-refresh",
+            "expires": 0
+        }
+    })
+    .to_string();
+    inner
+        .with_lock(&mut |_| Ok(((), Some(expired.clone()))))
+        .unwrap();
+    let (write_started, write_waiting) = mpsc::sync_channel(1);
+    let (release_write, release_waiting) = mpsc::channel();
+    let backend: Arc<dyn AuthStorageBackend> = Arc::new(PausedWriteBackend {
+        inner,
+        pause_next_write: AtomicBool::new(true),
+        write_started,
+        release_write: Mutex::new(release_waiting),
+    });
+    let oauth = Arc::new(CountingRefresh::default());
+    let first_backend = Arc::clone(&backend);
+    let first_oauth = Arc::clone(&oauth);
+    let first = std::thread::spawn(move || {
+        AuthStorage::from_storage(first_backend, first_oauth).get_api_key(PROVIDER)
+    });
+    write_waiting.recv_timeout(FIRST_WRITE_BOUND).unwrap();
+
+    let (second_done, second_waiting) = mpsc::channel();
+    let second_oauth = Arc::clone(&oauth);
+    let second = std::thread::spawn(move || {
+        let result = AuthStorage::from_storage(backend, second_oauth).get_api_key(PROVIDER);
+        second_done.send(result.clone()).unwrap();
+        result
+    });
+    let premature = second_waiting.recv_timeout(SECOND_RESOLUTION_BOUND);
+    release_write.send(()).unwrap();
+    let first_key = first.join().unwrap();
+    let second_key = second.join().unwrap();
+    assert!(
+        matches!(premature, Err(mpsc::RecvTimeoutError::Timeout)),
+        "a second refresh resolved before the first credential write completed: {premature:?}"
+    );
+    assert_eq!(first_key.as_deref(), Some("fresh-access"));
+    assert_eq!(second_key.as_deref(), Some("fresh-access"));
+    assert_eq!(oauth.calls.load(Ordering::SeqCst), 1);
+}
