+impl SystemPromptBreakdown {
+    /// Follow a live model switch: the model's prompt files and its image input.
+    pub(crate) fn update_model(&mut self, model_prompt_extras: Option<&str>, vision_capable: bool) {
+        self.segments
+            .retain(|segment| segment.name != "model-prompts");
+        if !self.segments.iter().any(|segment| segment.name == "custom") {
+            if let Some(extras) = model_prompt_extras {
+                let prefix_end = self
+                    .segments
+                    .iter()
+                    .take_while(|segment| segment.kind == SegmentKind::Static)
+                    .count();
+                self.segments.insert(
+                    prefix_end,
+                    PromptSegment::static_segment(
+                        "model-prompts",
+                        layers::layer_source("model-prompts").unwrap_or_default(),
+                        extras.to_string(),
+                    ),
+                );
+            }
+        }
+        self.segments
+            .retain(|segment| segment.name != "image-capability");
+        if let Some(environment) = self
+            .segments
+            .iter()
+            .position(|segment| segment.name == "environment")
+        {
+            self.segments
+                .insert(environment + 1, image_capability_segment(vision_capable));
+        }
+        self.reassemble();
+    }
+
+    fn reassemble(&mut self) {
+        let prefix_segments = self
+            .segments
+            .iter()
+            .take_while(|segment| segment.kind == SegmentKind::Static);
+        let prefix_count = prefix_segments.clone().count();
+        self.cached_prefix_len = prefix_segments
+            .map(|segment| segment.text.len())
+            .sum::<usize>()
+            + 2 * prefix_count.saturating_sub(1);
+        self.assembled = self
+            .segments
+            .iter()
+            .map(|segment| segment.text.as_str())
+            .collect::<Vec<_>>()
+            .join("\n\n");
+    }
+}
