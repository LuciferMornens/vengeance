diff --git a/crates/pa-daemon/tests/model_capabilities.rs b/crates/pa-daemon/tests/model_capabilities.rs
new file mode 100644
index 000000000..2b0b909ab
--- /dev/null
+++ b/crates/pa-daemon/tests/model_capabilities.rs
@@ -0,0 +1,99 @@
+use std::sync::Arc;
+
+use pa_daemon::agent_engine::{AgentEngineConfig, AgentSessionEngine};
+use pa_daemon::engine::{EngineModelSelection, RlmSessionIdentity, SessionEngine};
+use serde_json::json;
+
+#[tokio::test]
+async fn live_switch_refreshes_model_capabilities_in_the_prompt() {
+    let directory = tempfile::tempdir().unwrap();
+    let agent_dir = directory.path().join("agent");
+    std::fs::create_dir_all(&agent_dir).unwrap();
+    std::fs::write(
+        agent_dir.join("models.json"),
+        json!({
+            "providers": {
+                "test-provider": {
+                    "api": "openai-completions",
+                    "baseUrl": "http://127.0.0.1:9",
+                    "apiKey": "test-key",
+                    "headers": { "Authorization": "secret-model-header" },
+                    "compat": { "supportsStore": false },
+                    "models": [
+                        { "id": "vision-named-text", "input": ["text"] },
+                        { "id": "opaque-alias", "input": ["text", "image"] }
+                    ]
+                }
+            }
+        })
+        .to_string(),
+    )
+    .unwrap();
+    let engine = Arc::new(
+        AgentSessionEngine::new(AgentEngineConfig {
+            cwd: directory.path().to_path_buf(),
+            agent_dir,
+            provider: Some("test-provider".to_string()),
+            model: Some("vision-named-text".to_string()),
+            api_key: None,
+            thinking: None,
+            session_dir: None,
+            session_file: None,
+            faux_script: None,
+            supervisor_link: None,
+            telemetry_disabled: Some(true),
+            cron_store: None,
+            queued_steering_probe: None,
+        })
+        .unwrap(),
+    );
+    engine
+        .configure_rlm_identity(RlmSessionIdentity {
+            rlm_depth: 1,
+            ..Default::default()
+        })
+        .unwrap();
+    let initial_prompt = engine.system_prompt().await.unwrap();
+    assert!(initial_prompt.contains("this model cannot see images"));
+
+    let switching_engine = Arc::clone(&engine);
+    assert!(tokio::task::spawn_blocking(move || {
+        switching_engine.switch_model(EngineModelSelection {
+            provider: Some("test-provider".to_string()),
+            model: Some("opaque-alias".to_string()),
+            ..Default::default()
+        })
+    })
+    .await
+    .unwrap());
+    let metadata = engine.model_metadata().unwrap();
+    assert_eq!(metadata["input"], json!(["text", "image"]));
+    assert_eq!(metadata["contextWindow"], 128_000);
+    assert_eq!(metadata["maxTokens"], 16_384);
+    assert_eq!(
+        metadata["cost"],
+        json!({
+            "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0
+        })
+    );
+    assert!(metadata.get("headers").is_none());
+    assert!(metadata.get("baseUrl").is_none());
+    assert!(metadata.get("compat").is_none());
+    let vision_prompt = engine.system_prompt().await.unwrap();
+    assert!(vision_prompt.contains("this model can see images"));
+    assert!(!vision_prompt.contains("this model cannot see images"));
+
+    let switching_engine = Arc::clone(&engine);
+    assert!(tokio::task::spawn_blocking(move || {
+        switching_engine.switch_model(EngineModelSelection {
+            provider: Some("test-provider".to_string()),
+            model: Some("vision-named-text".to_string()),
+            ..Default::default()
+        })
+    })
+    .await
+    .unwrap());
+    assert_eq!(engine.system_prompt().await.unwrap(), initial_prompt);
+    assert_eq!(engine.model_metadata().unwrap()["input"], json!(["text"]));
+    engine.dispose_kernel().await;
+}
