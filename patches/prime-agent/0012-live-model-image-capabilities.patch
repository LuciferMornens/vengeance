new file mode 100644
index 000000000..bd7490bbd
--- /dev/null
+++ b/crates/pa-core/src/session_engine/model_selection.rs
@@ -0,0 +1,181 @@
+//! Live model selection and the prompt facts derived from the full model descriptor.
+
+use pa_agent::types::ThinkingLevel;
+use pa_types::ai::{Model, ModelInput};
+
+use super::engine::SessionEngine;
+use super::provider_adapter::json_round_trip;
+use super::turn_boundary::{ModelInfo, TurnBoundaryRequests};
+
+impl SessionEngine {
+    #[must_use]
+    pub fn system_prompt(&self) -> String {
+        self.prompt_breakdown
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .assembled
+            .clone()
+    }
+
+    /// # Errors
+    ///
+    /// Fails when the model cannot cross the loop boundary.
+    pub async fn set_model_and_thinking_level(
+        &self,
+        model: &Model,
+        thinking_level: ThinkingLevel,
+    ) -> anyhow::Result<()> {
+        let _selection = self.model_selection.lock().await;
+        let wire =
+            json_round_trip(model).ok_or_else(|| anyhow::anyhow!("model conversion failed"))?;
+        let mut breakdown = self
+            .prompt_breakdown
+            .read()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .clone();
+        let selector = format!("{}/{}", model.provider, model.id);
+        // Load errors were reported when the session started; a switch keeps the prompt usable.
+        let model_prompts =
+            crate::prompts::model_prompts::load_model_prompts(Some(&selector), &self.agent_dir);
+        breakdown.update_model(
+            model_prompts.extras.as_deref(),
+            model.input.contains(&ModelInput::Image),
+        );
+        self.session
+            .agent()
+            .set_model_and_thinking_level_with_prompt(
+                wire,
+                thinking_level,
+                breakdown.assembled.clone(),
+            )
+            .await;
+        TurnBoundaryRequests::rebind_model_facts(
+            &self.turn_boundary,
+            ModelInfo {
+                id: model.id.clone(),
+                provider: model.provider.clone(),
+                input: model.input.clone(),
+            },
+            (model.context_window > 0).then_some(model.context_window),
+        );
+        *self
+            .prompt_breakdown
+            .write()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = breakdown;
+        let _ = self
+            .session
+            .shared_persistence()
+            .lock()
+            .await
+            .append_model_change(&model.provider, &model.id);
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use pa_agent::scripted::ScriptedProvider;
+    use serde_json::json;
+
+    use crate::kernel::shared::{HostRequestHandlers, HostRequestPayload};
+    use crate::session_engine::engine::{create_session, SessionEngineConfig};
+    use crate::session_engine::PromptOptions;
+
+    use super::*;
+
+    #[tokio::test]
+    async fn live_model_selection_updates_the_prompt_and_image_skill_facts() {
+        const REPEATED_CAPABILITY_TEXT: &str =
+            "Image input: this model cannot see images; `attach_image` errors for it.";
+        let directory = tempfile::tempdir().unwrap();
+        let context_text = format!("User documentation: {REPEATED_CAPABILITY_TEXT}");
+        std::fs::write(directory.path().join("AGENTS.md"), &context_text).unwrap();
+        let text_model: Model = serde_json::from_value(json!({
+            "id": "vision-named-text", "name": "Vision", "provider": "test-provider",
+            "api": "test", "baseUrl": "http://localhost", "reasoning": false,
+            "input": ["text"], "contextWindow": 128_000, "maxTokens": 4_096,
+            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
+        }))
+        .unwrap();
+        let image_model: Model = serde_json::from_value(json!({
+            "id": "opaque-alias", "name": "Alias", "provider": "another-provider",
+            "api": "test", "baseUrl": "http://localhost", "reasoning": true,
+            "input": ["text", "image"], "contextWindow": 200_000, "maxTokens": 8_192,
+            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
+        }))
+        .unwrap();
+        let wire: pa_agent::types::Model = json_round_trip(&text_model).unwrap();
+        let provider = Arc::new(ScriptedProvider::new(wire.clone()));
+        provider.push_text_turn("ok");
+        let custom_prompt = format!("Custom instructions: {REPEATED_CAPABILITY_TEXT}");
+        let engine = create_session(SessionEngineConfig {
+            cwd: directory.path().to_path_buf(),
+            agent_dir: directory.path().join("agent"),
+            model: Some(wire),
+            model_info: Some(text_model.clone()),
+            stream_fn: Some(provider.stream_fn()),
+            custom_system_prompt: Some(custom_prompt.clone()),
+            prompt_guidelines: vec![format!("Appended instructions: {REPEATED_CAPABILITY_TEXT}")],
+            rlm_depth: Some(1),
+            prewarm_ipython_kernel: Some(false),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+        let mut handlers = HostRequestHandlers::new();
+        engine.turn_boundary.register_model_info_handler(
+            &mut handlers,
+            ModelInfo {
+                id: text_model.id.clone(),
+                provider: text_model.provider.clone(),
+                input: text_model.input.clone(),
+            },
+        );
+        let model_info = handlers.get("model.info").unwrap();
+        let request = || HostRequestPayload { data: json!({}) };
+        let initial_prompt = engine.system_prompt();
+        assert_eq!(
+            model_info(request()).await.unwrap(),
+            json!({ "id": text_model.id, "provider": text_model.provider, "input": ["text"] })
+        );
+        engine
+            .set_model_and_thinking_level(&image_model, ThinkingLevel::High)
+            .await
+            .unwrap();
+        assert_eq!(
+            model_info(request()).await.unwrap(),
+            json!({ "id": image_model.id, "provider": image_model.provider,
+                "input": ["text", "image"] })
+        );
+        let image_prompt = engine.system_prompt();
+        assert!(image_prompt.starts_with(&custom_prompt));
+        assert!(image_prompt.contains(&context_text));
+        assert_eq!(image_prompt.matches(REPEATED_CAPABILITY_TEXT).count(), 3);
+        assert!(image_prompt.contains("Image input: this model can see images"));
+        let state = engine.session.agent().state().await;
+        assert_eq!(state.system_prompt, image_prompt);
+        assert_eq!(state.model.id, image_model.id);
+        assert_eq!(state.thinking_level, ThinkingLevel::High);
+        engine.prompt("ok", PromptOptions::default()).await.unwrap();
+        assert_eq!(
+            provider.calls()[0].system_prompt.as_deref(),
+            Some(image_prompt.as_str())
+        );
+
+        engine
+            .set_model_and_thinking_level(&text_model, ThinkingLevel::Off)
+            .await
+            .unwrap();
+        assert_eq!(engine.system_prompt(), initial_prompt);
+        assert_eq!(
+            model_info(request()).await.unwrap(),
+            json!({ "id": text_model.id, "provider": text_model.provider, "input": ["text"] })
+        );
+        assert_eq!(
+            engine.session.agent().state().await.system_prompt,
+            initial_prompt
+        );
+    }
+}
