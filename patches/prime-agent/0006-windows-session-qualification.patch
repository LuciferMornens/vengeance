+//! Windows handle-based file identities and change stamps.
+
+use std::ffi::c_void;
+use std::fs::File;
+use std::io;
+use std::os::windows::io::AsRawHandle;
+
+const FILE_BASIC_INFO_CLASS: i32 = 0;
+const FILE_ID_INFO_CLASS: i32 = 18;
+
+#[repr(C)]
+#[derive(Default)]
+struct FileBasicInfo {
+    creation_time: i64,
+    last_access_time: i64,
+    last_write_time: i64,
+    change_time: i64,
+    file_attributes: u32,
+}
+
+/// Stable across appends and renames; distinct for a replacement file.
+#[repr(C)]
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct FileIdentity {
+    pub volume_serial_number: u64,
+    // FILE_ID_128's sixteen bytes, split into two words without truncation.
+    pub file_id: [u64; 2],
+}
+
+pub struct FileInformation {
+    pub len: u64,
+    pub identity: FileIdentity,
+    pub creation_time: i64,
+    pub last_write_time: i64,
+    pub change_time: i64,
+}
+
+#[link(name = "kernel32")]
+extern "system" {
+    fn GetFileInformationByHandleEx(
+        file: *mut c_void,
+        information_class: i32,
+        information: *mut c_void,
+        buffer_size: u32,
+    ) -> i32;
+}
+
+fn query<T: Default>(file: &File, information_class: i32) -> io::Result<T> {
+    let mut information = T::default();
+    let buffer_size = u32::try_from(std::mem::size_of::<T>()).map_err(io::Error::other)?;
+    // SAFETY: callers select the Win32 class matching their repr(C) struct,
+    // and the borrowed File owns a live handle throughout this call.
+    let result = unsafe {
+        GetFileInformationByHandleEx(
+            file.as_raw_handle(),
+            information_class,
+            std::ptr::from_mut(&mut information).cast(),
+            buffer_size,
+        )
+    };
+    if result == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(information)
+}
+
+/// # Errors
+///
+/// Returns the Win32 error if the handle or filesystem cannot supply a file ID.
+pub fn identity(file: &File) -> io::Result<FileIdentity> {
+    query(file, FILE_ID_INFO_CLASS)
+}
+
+/// # Errors
+///
+/// Returns the I/O error if the handle cannot supply metadata, identity or change stamps.
+pub fn information(file: &File) -> io::Result<FileInformation> {
+    let identity = identity(file)?;
+    let basic: FileBasicInfo = query(file, FILE_BASIC_INFO_CLASS)?;
+    Ok(FileInformation {
+        len: file.metadata()?.len(),
+        identity,
+        creation_time: basic.creation_time,
+        last_write_time: basic.last_write_time,
+        change_time: basic.change_time,
+    })
+}
