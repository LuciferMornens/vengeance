@@ -0,0 +1,31 @@
+//! Stable file identities before and after missing parent directories are created.
+use std::path::{Path, PathBuf};
+
+/// Resolve the existing ancestor and append missing components. Windows canonical paths
+/// carry a verbatim prefix even before a new session file or its directories exist.
+#[must_use]
+pub fn canonical_path(path: &Path) -> PathBuf {
+    let mut ancestor = if path.is_absolute() {
+        path.to_path_buf()
+    } else {
+        std::env::current_dir()
+            .unwrap_or_else(|_| PathBuf::from("."))
+            .join(path)
+    };
+    let mut missing = Vec::new();
+    loop {
+        if let Ok(mut canonical) = ancestor.canonicalize() {
+            for component in missing.iter().rev() {
+                canonical.push(component);
+            }
+            return canonical;
+        }
+        let Some(name) = ancestor.file_name() else {
+            return path.to_path_buf();
+        };
+        missing.push(name.to_os_string());
+        if !ancestor.pop() {
+            return path.to_path_buf();
+        }
+    }
+}
