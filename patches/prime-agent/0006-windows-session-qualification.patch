+use pa_daemon::lease::{acquire_runtime_session_lease, canonical_session_path};
+
+#[test]
+fn missing_directories_keep_the_same_lease_identity_after_creation() {
+    let root = tempfile::tempdir().unwrap();
+    let session = root
+        .path()
+        .join("new")
+        .join("sessions")
+        .join("session.jsonl");
+    let account = root.path().join("account");
+    let identity = canonical_session_path(&session);
+    let lease = acquire_runtime_session_lease(&session, &account).unwrap();
+    std::fs::create_dir_all(session.parent().unwrap()).unwrap();
+    std::fs::write(&session, "{}\n").unwrap();
+    assert_eq!(canonical_session_path(&session), identity);
+    assert!(acquire_runtime_session_lease(&session, &account).is_err());
+    drop(lease);
+    let successor = acquire_runtime_session_lease(&session, &account).unwrap();
+    drop(successor);
+}
