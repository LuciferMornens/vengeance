@@ -0,0 +1,112 @@
+#![cfg(windows)]
+
+use pa_core::session::window::WindowedSessionStore;
+use serde_json::json;
+use std::fs::{File, FileTimes};
+
+fn session_text() -> String {
+    let rows = [
+        json!({"type":"session","version":3,"id":"s","cwd":"test","timestamp":"2026-10-13T00:00:00Z"}),
+        json!({"type":"message","id":"old","parentId":null,"timestamp":"2026-10-13T00:00:01Z",
+            "message":{"role":"user","content":"earlier","timestamp":0}}),
+        json!({"type":"message","id":"kept","parentId":"old","timestamp":"2026-10-13T00:00:02Z",
+            "message":{"role":"user","content":"alpha","timestamp":0}}),
+        json!({"type":"compaction","id":"compact","parentId":"kept","summary":"summary",
+            "firstKeptEntryId":"kept","tokensBefore":100}),
+        json!({"type":"message","id":"leaf","parentId":"compact","timestamp":"2026-10-13T00:00:03Z",
+            "message":{"role":"user","content":"latest","timestamp":0}}),
+    ];
+    rows.into_iter().map(|row| row.to_string() + "\n").collect()
+}
+
+#[test]
+fn a_same_length_rewrite_with_restored_mtime_invalidates_the_window() {
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("session.jsonl");
+    std::fs::write(&path, session_text()).unwrap();
+    let original_mtime = std::fs::metadata(&path).unwrap().modified().unwrap();
+    let cold = WindowedSessionStore::open(&path).unwrap().unwrap();
+    assert!(!cold.read_stats().cache_hit);
+    let warm = WindowedSessionStore::open(&path).unwrap().unwrap();
+    assert!(warm.read_stats().cache_hit);
+    std::fs::write(&path, session_text().replace("alpha", "bravo")).unwrap();
+    File::options()
+        .write(true)
+        .open(&path)
+        .unwrap()
+        .set_times(FileTimes::new().set_modified(original_mtime))
+        .unwrap();
+    let changed = WindowedSessionStore::open(&path).unwrap().unwrap();
+    assert!(!changed.read_stats().cache_hit);
+    assert!(changed
+        .raw_entries()
+        .iter()
+        .any(|line| line.contains("bravo")));
+    assert!(!changed
+        .raw_entries()
+        .iter()
+        .any(|line| line.contains("alpha")));
+}
+
+#[test]
+fn an_open_writer_keeps_a_window_from_certifying_deferred_timestamps() {
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("session.jsonl");
+    std::fs::write(&path, session_text()).unwrap();
+    let writer = File::options().write(true).open(&path).unwrap();
+    assert!(WindowedSessionStore::open(&path).unwrap().is_none());
+    drop(writer);
+    assert!(WindowedSessionStore::open(&path).unwrap().is_some());
+}
+
+#[test]
+fn a_certifying_reader_cannot_lose_a_durable_append() {
+    use pa_core::session::window::{append_cached, AppendOwnership};
+    use std::os::windows::fs::OpenOptionsExt;
+    use std::time::Duration;
+
+    const FILE_SHARE_READ: u32 = 1;
+    const FILE_SHARE_DELETE: u32 = 4;
+
+    let root = tempfile::tempdir().unwrap();
+    let path = root.path().join("session.jsonl");
+    let initial = session_text();
+    std::fs::write(&path, &initial).unwrap();
+    let reader = File::options()
+        .read(true)
+        .share_mode(FILE_SHARE_READ | FILE_SHARE_DELETE)
+        .open(&path)
+        .unwrap();
+    let appended = b"{\"type\":\"message\",\"id\":\"next\",\"parentId\":\"leaf\",\"message\":{\"role\":\"user\",\"content\":\"durable\"}}\n";
+    let (started_tx, started_rx) = std::sync::mpsc::channel();
+    let (done_tx, done_rx) = std::sync::mpsc::channel();
+    let append_path = path.clone();
+    let writer = std::thread::spawn(move || {
+        started_tx.send(()).unwrap();
+        done_tx
+            .send(append_cached(
+                &append_path,
+                appended,
+                AppendOwnership::SessionLeaseHeld,
+            ))
+            .unwrap();
+    });
+    started_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+    assert!(
+        matches!(
+            done_rx.recv_timeout(Duration::from_millis(30)),
+            Err(std::sync::mpsc::RecvTimeoutError::Timeout)
+        ),
+        "the reader must not turn an append into an I/O failure"
+    );
+    drop(reader);
+    done_rx
+        .recv_timeout(Duration::from_secs(5))
+        .unwrap()
+        .unwrap();
+    writer.join().unwrap();
+    assert_eq!(
+        std::fs::read_to_string(&path).unwrap(),
+        initial + std::str::from_utf8(appended).unwrap()
+    );
+}
